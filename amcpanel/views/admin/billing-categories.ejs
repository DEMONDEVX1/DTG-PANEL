<%- include('../partials/header') %>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="fas fa-th"></i> Billing Categories
                </h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                    <i class="fas fa-plus"></i> New Category
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <% if (categories.length > 0) { %>
                        <div class="row">
                            <% categories.forEach((cat, index) => { %>
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card border-0 shadow-sm">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <i class="<%= cat.icon %>" style="color: <%= cat.color %>; font-size: 2em;"></i>
                                                    <h5 class="card-title mt-2"><%= cat.name %></h5>
                                                </div>
                                                <span class="badge bg-<%= cat.status === 'active' ? 'success' : 'danger' %>">
                                                    <%= cat.status %>
                                                </span>
                                            </div>
                                            
                                            <% if (cat.description) { %>
                                                <p class="card-text text-muted small"><%= cat.description %></p>
                                            <% } %>
                                            
                                            <div class="mt-3">
                                                <small class="text-muted d-block">Order: <%= cat.display_order %></small>
                                            </div>
                                            
                                            <div class="btn-group mt-3" role="group">
                                                <button type="button" class="btn btn-sm btn-warning" 
                                                    onclick="editCategory(<%= JSON.stringify(cat).replace(/'/g, '&#39;') %>)">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" 
                                                    onclick="deleteCategory('<%= cat.id %>', '<%= cat.name %>')">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle"></i> No billing categories yet. Create one to organize your server packages!
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">New Billing Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <input type="hidden" id="categoryId">
                    
                    <div class="mb-3">
                        <label class="form-label">Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" placeholder="e.g., Gaming Servers" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="description" rows="2" placeholder="Optional description"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Icon Class <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="icon" value="fas fa-box" placeholder="e.g., fas fa-gamepad">
                                <small class="text-muted">Font Awesome icon class</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Icon Color <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="color" class="form-control form-control-color" id="color" value="#007bff">
                                    <input type="text" class="form-control" id="colorText" value="#007bff" readonly style="flex: 0.5;">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Display Order</label>
                                <input type="number" class="form-control" id="display_order" value="0" min="0">
                                <small class="text-muted">Lower numbers appear first</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3" id="statusDiv" style="display: none;">
                                <label class="form-label">Status</label>
                                <select class="form-control" id="status">
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <strong>Preview:</strong>
                        <i class="fas fa-box" id="iconPreview" style="color: #007bff; font-size: 2em;"></i>
                        <span id="namePreview" style="margin-left: 10px; font-weight: bold;">Category Name</span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveCategory()">Save Category</button>
            </div>
        </div>
    </div>
</div>

<script>
// Update color display
document.getElementById('color').addEventListener('change', function() {
    document.getElementById('colorText').value = this.value;
    document.getElementById('iconPreview').style.color = this.value;
    updatePreview();
});

// Update icon preview
document.getElementById('icon').addEventListener('change', function() {
    updatePreview();
});

// Update name preview
document.getElementById('name').addEventListener('change', function() {
    document.getElementById('namePreview').textContent = this.value || 'Category Name';
});

function updatePreview() {
    const icon = document.getElementById('icon').value || 'fas fa-box';
    const iconEl = document.getElementById('iconPreview');
    iconEl.className = icon;
}

function editCategory(cat) {
    document.getElementById('modalTitle').textContent = 'Edit Billing Category';
    document.getElementById('categoryId').value = cat.id;
    document.getElementById('name').value = cat.name;
    document.getElementById('description').value = cat.description || '';
    document.getElementById('icon').value = cat.icon;
    document.getElementById('color').value = cat.color;
    document.getElementById('colorText').value = cat.color;
    document.getElementById('display_order').value = cat.display_order;
    document.getElementById('status').value = cat.status;
    
    document.getElementById('statusDiv').style.display = 'block';
    document.getElementById('iconPreview').style.color = cat.color;
    document.getElementById('iconPreview').className = cat.icon;
    document.getElementById('namePreview').textContent = cat.name;
    
    new bootstrap.Modal(document.getElementById('addCategoryModal')).show();
}

function saveCategory() {
    const categoryId = document.getElementById('categoryId').value;
    const name = document.getElementById('name').value;
    const description = document.getElementById('description').value;
    const icon = document.getElementById('icon').value;
    const color = document.getElementById('color').value;
    const display_order = document.getElementById('display_order').value;
    const status = document.getElementById('status').value || 'active';

    if (!name) {
        alert('Please enter a category name');
        return;
    }

    const url = categoryId ? `/admin/billing-categories/${categoryId}/edit` : '/admin/billing-categories/create';

    fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, description, icon, color, display_order, status })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert('Category saved successfully!');
            location.reload();
        } else {
            alert('Error: ' + data.message);
        }
    })
    .catch(err => alert('Error: ' + err.message));
}

function deleteCategory(id, name) {
    if (!confirm(`Delete category "${name}"? This will not delete the associated packages.\nContinue?`)) return;

    fetch(`/admin/billing-categories/${id}/delete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert('Category deleted successfully!');
            location.reload();
        } else {
            alert('Error: ' + data.message);
        }
    })
    .catch(err => alert('Error: ' + err.message));
}

// Reset modal when opening for new category
document.getElementById('addCategoryModal').addEventListener('show.bs.modal', function (e) {
    if (e.relatedTarget && e.relatedTarget.classList.contains('btn-primary')) {
        document.getElementById('categoryForm').reset();
        document.getElementById('categoryId').value = '';
        document.getElementById('modalTitle').textContent = 'New Billing Category';
        document.getElementById('statusDiv').style.display = 'none';
        document.getElementById('color').value = '#007bff';
        document.getElementById('colorText').value = '#007bff';
        document.getElementById('icon').value = 'fas fa-box';
        document.getElementById('iconPreview').className = 'fas fa-box';
        document.getElementById('iconPreview').style.color = '#007bff';
        document.getElementById('namePreview').textContent = 'Category Name';
    }
});
</script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-shield-halved text-accent"></i> Admin Panel</h1>
        <p class="page-subtitle">Server management &amp; system overview</p>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon accent"><i class="fas fa-server"></i></div>
        <div class="stat-content">
            <div class="stat-label">Servers</div>
            <div class="stat-value"><%= typeof servers !== 'undefined' ? servers.length : 0 %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fas fa-circle-check"></i></div>
        <div class="stat-content">
            <div class="stat-label">Running</div>
            <div class="stat-value"><%= typeof servers !== 'undefined' ? servers.filter(function(s){return s.status==='running'}).length : 0 %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon danger"><i class="fas fa-circle-xmark"></i></div>
        <div class="stat-content">
            <div class="stat-label">Stopped</div>
            <div class="stat-value"><%= typeof servers !== 'undefined' ? servers.filter(function(s){return s.status==='stopped'}).length : 0 %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon info"><i class="fas fa-users"></i></div>
        <div class="stat-content">
            <div class="stat-label">Users</div>
            <div class="stat-value"><%= typeof users !== 'undefined' ? users.length : 0 %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon accent"><i class="fas fa-network-wired"></i></div>
        <div class="stat-content">
            <div class="stat-label">Nodes</div>
            <div class="stat-value"><%= typeof nodes !== 'undefined' ? nodes.length : 0 %></div>
        </div>
    </div>
</div>

<div class="grid-2 mb-4">
    <div class="card">
        <div class="card-header"><h3 class="d-flex align-center gap-2 fw-600"><i class="fas fa-server text-accent"></i> Recent Servers</h3></div>
        <div class="card-body" style="padding:0">
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Name</th><th>Status</th><th>Owner</th><th>Port</th></tr></thead>
                    <tbody>
                        <% if (typeof servers !== 'undefined' && servers.length) { servers.slice(0,5).forEach(function(s){ %>
                        <tr>
                            <td><a href="/servers/<%= s.id %>/dashboard" style="color:var(--text-primary);text-decoration:none;font-weight:600"><%= s.name %></a></td>
                            <td><span class="badge <%= s.status==='running'?'badge-success':'badge' %>"><%= s.status==='running'?'Online':'Offline' %></span></td>
                            <td class="text-muted"><%= s.owner_name||'---' %></td>
                            <td class="text-muted"><%= s.port %></td>
                        </tr>
                        <% }); } else { %>
                        <tr><td colspan="4" class="text-center text-muted p-3">No servers</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-header"><h3 class="d-flex align-center gap-2 fw-600"><i class="fas fa-bolt text-warning"></i> Quick Actions</h3></div>
        <div class="card-body">
            <div class="grid-2 gap-1">
                <a href="/admin/nodes" class="btn btn-ghost"><i class="fas fa-server"></i> Nodes</a>
                <a href="/admin/nodes?action=create" class="btn btn-ghost" style="color:var(--accent);"><i class="fas fa-plus-circle"></i> Create Node</a>
                <a href="/admin/users" class="btn btn-ghost"><i class="fas fa-users"></i> Users</a>
                <a href="/admin/servers" class="btn btn-ghost"><i class="fas fa-database"></i> Servers</a>
                <a href="/admin/settings" class="btn btn-ghost"><i class="fas fa-cog"></i> Settings</a>
                <a href="/admin/themes" class="btn btn-ghost"><i class="fas fa-palette"></i> Themes</a>
                <a href="/admin/users/create" class="btn btn-ghost"><i class="fas fa-user-plus"></i> New User</a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-server text-accent"></i>
            Node Management
        </h1>
        <p class="page-subtitle">Manage your panel nodes &bull; <%= nodes.length %> node<%= nodes.length !== 1 ? 's' : '' %> registered</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" onclick="openLocalNode()"><i class="fas fa-plus"></i> Local Node</button>
        <button class="btn btn-ghost" onclick="openRemoteNode()"><i class="fas fa-plus"></i> Remote Node</button>
        <button class="btn btn-ghost" onclick="location.reload()"><i class="fas fa-sync-alt"></i> Refresh</button>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon accent"><i class="fas fa-server"></i></div>
        <div class="stat-content">
            <div class="stat-label">Total Nodes</div>
            <div class="stat-value"><%= stats.total %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fas fa-circle-check"></i></div>
        <div class="stat-content">
            <div class="stat-label">Online</div>
            <div class="stat-value"><%= stats.online %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon danger"><i class="fas fa-circle-xmark"></i></div>
        <div class="stat-content">
            <div class="stat-label">Offline</div>
            <div class="stat-value"><%= stats.offline %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon info"><i class="fas fa-memory"></i></div>
        <div class="stat-content">
            <div class="stat-label">Total RAM</div>
            <div class="stat-value"><%= Math.round(stats.totalRam / 1024) %> GB</div>
        </div>
    </div>
</div>

<% if (!nodes || nodes.length === 0) { %>
<div class="card text-center p-5">
    <div class="text-center">
        <i class="fas fa-server text-muted" style="font-size: 48px; opacity: 0.2; display: block; margin-bottom: 16px;"></i>
        <h3 class="fw-600 mb-1">No Nodes Configured</h3>
        <p class="text-muted text-sm mb-3">Nodes are the machines that run your Minecraft servers. Add your first node to get started.</p>
        <div class="d-flex gap-1 justify-center">
            <button class="btn btn-primary" onclick="openLocalNode()"><i class="fas fa-plus"></i> Add Local Node</button>
            <button class="btn btn-ghost" onclick="openRemoteNode()"><i class="fas fa-plus"></i> Add Remote Node</button>
        </div>
    </div>
</div>
<% } else { %>
<div class="grid-3">
    <% nodes.forEach(function(n){ %>
    <div class="card">
        <div class="card-header d-flex align-center gap-2">
            <div class="flex-shrink-0" style="width: 38px; height: 38px; border-radius: var(--r-md); background: var(--accent-dim); display: flex; align-items: center; justify-content: center;">
                <i class="fas fa-server text-accent"></i>
            </div>
            <div class="flex-1 fw-600 truncate"><%= n.name %></div>
            <span class="badge <%= n.status === 'online' ? 'badge-success' : 'badge-danger' %> text-xs">
                <span class="status-dot <%= n.status === 'online' ? 'online' : 'offline' %>"></span>
                <%= n.status === 'online' ? 'Online' : 'Offline' %>
            </span>
        </div>
        <div class="card-body">
            <div class="d-flex gap-2 flex-wrap text-xs text-muted mb-2">
                <span><i class="fas fa-network-wired"></i> <%= n.ip %>:<%= n.port %></span>
                <span><i class="fas fa-location-dot"></i> <%= n.location || 'Default' %></span>
                <span><i class="fas fa-microchip"></i> <%= n.cpu_count || n.cpu %> cores</span>
                <% if (n.uptime) { %><span><i class="fas fa-clock"></i> <%= Math.floor(n.uptime / 3600) %>h <%= Math.floor((n.uptime % 3600) / 60) %>m</span><% } %>
                <span class="sftp-status-badge" data-node-id="<%= n.id %>"><i class="fas fa-spinner fa-spin"></i> SFTP...</span>
            </div>
            <div class="mb-1">
                <div class="d-flex justify-between text-xs text-muted mb-1">
                    <span><i class="fas fa-memory"></i> RAM</span>
                    <span><%= Math.min(Math.round((n.ram_total || n.ram) / 1024), Math.round((n.ram_used||0) / 1024)) %> / <%= Math.round((n.ram_total || n.ram) / 1024) %> GB (<%= Math.min(100, n.ram_percent||0) %>%)</span>
                </div>
                <div class="progress-wrap">
                    <div class="progress-bar accent" style="width:<%= Math.min(100, n.ram_percent||0) %>%"></div>
                </div>
            </div>
            <div class="mb-1">
                <div class="d-flex justify-between text-xs text-muted mb-1">
                    <span><i class="fas fa-microchip"></i> CPU</span>
                    <span><%= Math.min(100, n.cpu_percent||0) %>%</span>
                </div>
                <div class="progress-wrap">
                    <div class="progress-bar success" style="width:<%= Math.min(100, n.cpu_percent||0) %>%"></div>
                </div>
            </div>
            <div>
                <div class="d-flex justify-between text-xs text-muted mb-1">
                    <span><i class="fas fa-hdd"></i> Disk</span>
                    <span><%= Math.min(Math.round((n.disk_total || n.disk) / 1024), Math.round((n.disk_used||0) / 1024)) %> / <%= Math.round((n.disk_total || n.disk) / 1024) %> GB (<%= Math.min(100, n.disk_percent||0) %>%)</span>
                </div>
                <div class="progress-wrap">
                    <div class="progress-bar warning" style="width:<%= Math.min(100, n.disk_percent||0) %>%"></div>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-1">
            <button class="btn btn-sm btn-ghost flex-1" onclick="editNode(<%= n.id %>, '<%= n.name.replace(/'/g,"\\'") %>', '<%= (n.description||'').replace(/'/g,"\\'") %>', '<%= n.ip %>', <%= n.port %>, '<%= (n.location||'').replace(/'/g,"\\'") %>', <%= n.ram %>, <%= n.cpu %>, <%= n.disk %>, '<%= n.status %>', <%= n.upload_limit || 0 %>)"><i class="fas fa-pen"></i> Edit</button>
            <button class="btn btn-sm btn-ghost" style="color:var(--danger);" onclick="deleteNode(<%= n.id %>, '<%= n.name.replace(/'/g,"\\'") %>')"><i class="fas fa-trash"></i> Delete</button>
        </div>
    </div>
    <% }); %>
</div>
<% } %>

<div class="drawer-bg" id="nodeDrawerBg" onclick="closeNodeDrawer()"></div>
<div class="drawer" id="nodeDrawer">
    <div class="drawer-header">
        <div class="drawer-hl">
            <div class="drawer-ico"><i class="fas fa-server"></i></div>
            <div><div class="drawer-ttl" id="nodeDrawerTitle">Add Node</div><div class="drawer-sub" id="nodeDrawerSub">Configure a new panel node</div></div>
        </div>
        <button class="drawer-x" onclick="closeNodeDrawer()"><i class="fas fa-times"></i></button>
    </div>
    <div class="drawer-body">
        <form id="nodeForm">
            <input type="hidden" id="nodeId" value="">
            <input type="hidden" id="nodeMode" value="local">
            <div class="form-group">
                <label class="form-label">Node Name *</label>
                <input type="text" id="nodeName" class="form-control" placeholder="e.g. US-East-1" required>
                <div class="form-hint">Unique identifier for this node</div>
            </div>
            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea id="nodeDescription" class="form-control" rows="2" placeholder="Optional description"></textarea>
            </div>
            <div id="remoteFields" style="display:none;">
                <div class="d-flex gap-1">
                    <div class="form-group flex-1">
                        <label class="form-label">IP Address *</label>
                        <input type="text" id="nodeIp" class="form-control" placeholder="Public IP of remote server">
                    </div>
                    <div class="form-group" style="width:120px;">
                        <label class="form-label">Port</label>
                        <input type="number" id="nodePort" class="form-control" value="8080">
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Location</label>
                <input type="text" id="nodeLocation" class="form-control" placeholder="e.g. New York, USA">
            </div>
            <div class="d-flex gap-1">
                <div class="form-group flex-1">
                    <label class="form-label">RAM (MB)</label>
                    <input type="number" id="nodeRam" class="form-control" value="16384">
                </div>
                <div class="form-group flex-1">
                    <label class="form-label">CPU Cores</label>
                    <input type="number" id="nodeCpu" class="form-control" value="4">
                </div>
                <div class="form-group flex-1">
                    <label class="form-label">Disk (MB)</label>
                    <input type="number" id="nodeDisk" class="form-control" value="102400">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label"><i class="fas fa-upload" style="color:var(--accent);margin-right:4px;"></i> Upload Limit (MB)</label>
                <input type="number" id="nodeUploadLimit" class="form-control" value="0" min="0">
                <div class="form-hint">Maximum file upload size in MB. Set to <strong>0</strong> for unlimited. (e.g. 10240 = 10GB)</div>
            </div>
            <div class="form-group" id="nodeStatusGroup" style="display:none;">
                <label class="form-label">Status</label>
                <select id="nodeStatus" class="form-control">
                    <option value="online">Online</option>
                    <option value="offline">Offline</option>
                </select>
            </div>
        </form>
        <div id="allocSection" style="display:none;margin-top:20px;padding-top:20px;border-top:1px solid var(--border);">
            <div class="d-flex align-center gap-2 fw-600 mb-2" style="font-size:14px;">
                <i class="fas fa-network-wired text-accent"></i> Assign New Allocations
                <span id="allocCount" class="badge badge-info" style="margin-left:auto;">0</span>
            </div>
            <div class="alert alert-info text-xs mb-2">
                <i class="fas fa-info-circle"></i>
                Assign IPs and ports. When creating a server, you'll pick an available allocation.
            </div>
            <div id="allocList" class="d-flex flex-column gap-1 mb-3" style="max-height:200px;overflow-y:auto;"></div>
            <div class="p-2 rounded border" style="background: var(--bg-tertiary);">
                <div class="text-xs fw-700 text-muted mb-2" style="text-transform:uppercase;letter-spacing:.5px;">New Allocation</div>
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-globe text-accent" style="margin-right:4px;"></i> IP Address *</label>
                    <input type="text" id="allocIp" class="form-control" placeholder="e.g. 161.22.45.100">
                    <div class="form-hint">Enter an IP address to assign ports to here.</div>
                </div>
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-tag" style="margin-right:4px;"></i> IP Alias</label>
                    <input type="text" id="allocAlias" class="form-control" placeholder="e.g. mc.example.com">
                    <div class="form-hint">Optional default alias for these allocations.</div>
                </div>
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-plug text-warning" style="margin-right:4px;"></i> Ports *</label>
                    <input type="text" id="allocPorts" class="form-control" placeholder="e.g. 25565,25566,25570-25580">
                    <div class="form-hint">Enter individual ports or port ranges separated by commas or spaces.</div>
                </div>
                <button class="btn btn-primary w-100" onclick="addAllocations(event)"><i class="fas fa-plus"></i> Submit</button>
            </div>
        </div>
        <div id="secretSection" style="display:none;margin-top:20px;padding-top:20px;border-top:1px solid var(--border);">
            <div class="d-flex align-center gap-2 fw-600 mb-2" style="font-size:14px;">
                <i class="fas fa-key text-warning"></i> Node Secret
            </div>
            <div class="alert alert-warning text-xs mb-2">
                <i class="fas fa-exclamation-triangle"></i>
                Use this secret when running the daemon on the remote server. It authenticates the node with the panel.
            </div>
            <div class="d-flex gap-1">
                <input type="text" id="nodeSecret" class="form-control" readonly style="flex:1;font-family:monospace;font-size:13px;background:rgba(0,0,0,.3);">
                <button class="btn btn-primary" onclick="copyNodeSecret()" title="Copy to clipboard"><i class="fas fa-copy"></i></button>
                <button class="btn btn-warning" onclick="regenerateSecret()" title="Regenerate secret"><i class="fas fa-sync-alt"></i></button>
            </div>
            <div class="text-xs text-muted mt-2">
                Daemon install command:
                <code id="daemonCmd" style="display:block;margin-top:4px;padding:8px;background:rgba(0,0,0,.4);border-radius:6px;font-size:11px;word-break:break-all;white-space:pre-wrap;color:var(--accent);"></code>
            </div>
        </div>
    </div>
    <div class="drawer-footer">
        <button class="btn btn-ghost" onclick="closeNodeDrawer()"><i class="fas fa-times"></i> Cancel</button>
        <button class="btn btn-primary" id="nodeSaveBtn" onclick="saveNode()"><i class="fas fa-check"></i> Save Node</button>
    </div>
</div>

<script>
function openLocalNode() {
    document.getElementById('nodeDrawerTitle').textContent = 'Add Local Node';
    document.getElementById('nodeDrawerSub').textContent = 'This machine (localhost)';
    document.getElementById('nodeId').value = '';
    document.getElementById('nodeMode').value = 'local';
    document.getElementById('nodeName').value = '';
    document.getElementById('nodeDescription').value = '';
    document.getElementById('nodeIp').value = '127.0.0.1';
    document.getElementById('nodePort').value = '8080';
    document.getElementById('nodeLocation').value = '';
    document.getElementById('nodeRam').value = '16384';
    document.getElementById('nodeCpu').value = '4';
    document.getElementById('nodeDisk').value = '102400';
    document.getElementById('nodeStatusGroup').style.display = 'none';
    document.getElementById('remoteFields').style.display = 'none';
    document.getElementById('allocSection').style.display = 'none';
    document.getElementById('nodeSaveBtn').innerHTML = '<i class="fas fa-check"></i> Create Local Node';
    document.getElementById('nodeDrawerBg').classList.add('open');
    document.getElementById('nodeDrawer').classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(function(){ document.getElementById('nodeName').focus(); }, 350);
}

function openRemoteNode() {
    document.getElementById('nodeDrawerTitle').textContent = 'Add Remote Node';
    document.getElementById('nodeDrawerSub').textContent = 'Configure connection to remote server';
    document.getElementById('nodeId').value = '';
    document.getElementById('nodeMode').value = 'remote';
    document.getElementById('nodeName').value = '';
    document.getElementById('nodeDescription').value = '';
    document.getElementById('nodeIp').value = '';
    document.getElementById('nodePort').value = '8080';
    document.getElementById('nodeLocation').value = '';
    document.getElementById('nodeRam').value = '16384';
    document.getElementById('nodeCpu').value = '4';
    document.getElementById('nodeDisk').value = '102400';
    document.getElementById('nodeStatusGroup').style.display = 'none';
    document.getElementById('remoteFields').style.display = 'block';
    document.getElementById('allocSection').style.display = 'none';
    document.getElementById('nodeSaveBtn').innerHTML = '<i class="fas fa-check"></i> Create Remote Node';
    document.getElementById('nodeDrawerBg').classList.add('open');
    document.getElementById('nodeDrawer').classList.add('open');
    document.body.style.overflow = 'hidden';
    setTimeout(function(){ document.getElementById('nodeName').focus(); }, 350);
}

function editNode(id, name, desc, ip, port, loc, ram, cpu, disk, status, uploadLimit) {
    document.getElementById('nodeDrawerTitle').textContent = 'Edit Node';
    document.getElementById('nodeDrawerSub').textContent = 'Update node configuration';
    document.getElementById('nodeId').value = id;
    document.getElementById('nodeMode').value = 'edit';
    document.getElementById('nodeName').value = name;
    document.getElementById('nodeDescription').value = desc;
    document.getElementById('nodeIp').value = ip;
    document.getElementById('nodePort').value = port;
    document.getElementById('nodeLocation').value = loc;
    document.getElementById('nodeRam').value = ram;
    document.getElementById('nodeCpu').value = cpu;
    document.getElementById('nodeDisk').value = disk;
    document.getElementById('nodeUploadLimit').value = uploadLimit || 0;
    document.getElementById('nodeStatus').value = status;
    document.getElementById('nodeStatusGroup').style.display = 'block';
    document.getElementById('remoteFields').style.display = 'block';
    document.getElementById('nodeSaveBtn').innerHTML = '<i class="fas fa-check"></i> Update Node';
    document.getElementById('allocSection').style.display = 'block';
    document.getElementById('secretSection').style.display = 'block';
    document.getElementById('allocIp').value = ip || '';
    document.getElementById('nodeDrawerBg').classList.add('open');
    document.getElementById('nodeDrawer').classList.add('open');
    document.body.style.overflow = 'hidden';
    loadAllocations(id);
    loadNodeSecret(id);
}

function closeNodeDrawer() {
    document.getElementById('nodeDrawerBg').classList.remove('open');
    document.getElementById('nodeDrawer').classList.remove('open');
    document.body.style.overflow = '';
}

function saveNode() {
    var id = document.getElementById('nodeId').value;
    var mode = document.getElementById('nodeMode').value;
    var name = document.getElementById('nodeName').value.trim();
    if (!name) { showToast('Node name is required', 'error'); return; }
    var isRemote = mode === 'remote' || mode === 'edit';
    var data = {
        name: name,
        description: document.getElementById('nodeDescription').value.trim(),
        ip: isRemote ? (document.getElementById('nodeIp').value.trim() || '127.0.0.1') : '127.0.0.1',
        port: parseInt(document.getElementById('nodePort').value) || 8080,
        location: document.getElementById('nodeLocation').value.trim(),
        ram: parseInt(document.getElementById('nodeRam').value) || 16384,
        cpu: parseInt(document.getElementById('nodeCpu').value) || 4,
        disk: parseInt(document.getElementById('nodeDisk').value) || 102400,
        upload_limit: parseInt(document.getElementById('nodeUploadLimit').value) || 0,
        status: mode === 'edit' ? (document.getElementById('nodeStatus').value || 'offline') : 'offline'
    };
    if (isRemote && !data.ip) { showToast('IP address is required for remote node', 'error'); return; }
    var url = id ? '/admin/nodes/' + id + '/update' : '/admin/nodes/create';
    var btn = document.getElementById('nodeSaveBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';
    showLoading(id ? 'Updating node...' : 'Creating node...', true);
    fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            hideLoading();
            if (d.success) {
                showToast(d.message || 'Node saved!', 'success');
                setTimeout(function() { location.reload(); }, 800);
            } else {
                showToast(d.error || 'Failed to save node', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> ' + (id ? 'Update' : 'Create') + ' Node';
            }
        })
        .catch(function() {
            hideLoading();
            showToast('Request failed', 'error');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-check"></i> ' + (id ? 'Update' : 'Create') + ' Node';
        });
}

function deleteNode(id, name) {
    showConfirm('Are you sure you want to delete node "' + name + '"? This action cannot be undone.').then(function(ok) {
        if (!ok) return;
        showLoading('Deleting node...', true);
        fetch('/admin/nodes/' + id + '/delete', { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                hideLoading();
                if (d.success) { showToast('Node deleted', 'success'); setTimeout(function() { location.reload(); }, 500); }
                else { showToast(d.error || 'Failed to delete node', 'error'); }
            })
            .catch(function() { hideLoading(); showToast('Request failed', 'error'); });
    });
}

function loadAllocations(nodeId) {
    fetch('/admin/nodes/' + nodeId + '/allocations')
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (!d.success) return;
            var list = document.getElementById('allocList');
            var count = document.getElementById('allocCount');
            count.textContent = d.allocations.length;
            if (d.allocations.length === 0) {
                list.innerHTML = '<div class="text-center p-3 text-muted text-sm" style="border:1px dashed var(--border);border-radius:var(--r-md);">No allocations yet. Add an IP and port(s) below.</div>';
                return;
            }
            list.innerHTML = d.allocations.map(function(a) {
                var serverLabel = a.server_name ? '<span class="badge badge-success text-xs">' + a.server_name + '</span>' : '<span class="badge text-xs">Free</span>';
                var aliasLabel = a.ip_alias ? '<span class="text-xs text-accent">' + a.ip_alias + '</span>' : '';
                return '<div class="d-flex align-center gap-1 p-1 rounded" style="background:var(--bg-tertiary);border:1px solid var(--border);">' +
                    '<i class="fas fa-network-wired text-accent text-xs"></i>' +
                    '<div class="flex-1" style="min-width:0;">' +
                        '<div class="text-sm fw-600">' + a.ip + ':' + a.port + '</div>' +
                        (aliasLabel ? aliasLabel : '') +
                    '</div>' +
                    serverLabel +
                    (a.server_id ? '' : '<button class="btn btn-sm" style="color:var(--danger);padding:2px 6px;font-size:10px;" onclick="deleteAllocation(' + nodeId + ',' + a.id + ')"><i class="fas fa-times"></i></button>') +
                    '</div>';
            }).join('');
        })
        .catch(function() {});
}

function addAllocations(evt) {
    var nodeId = document.getElementById('nodeId').value;
    if (!nodeId) { showToast('Save the node first before adding allocations', 'error'); return; }
    var ip = document.getElementById('allocIp').value.trim();
    var alias = document.getElementById('allocAlias').value.trim();
    var ports = document.getElementById('allocPorts').value.trim();
    if (!ip) { showToast('IP address is required', 'error'); return; }
    if (!ports) { showToast('Enter at least one port', 'error'); return; }
    var btn = evt.target;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...';
    fetch('/admin/nodes/' + nodeId + '/allocations/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ip: ip, ports: ports, ip_alias: alias })
    })
    .then(function(r) { return r.json(); })
    .then(function(d) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-plus"></i> Submit';
        if (d.success) {
            showToast(d.message, 'success');
            document.getElementById('allocPorts').value = '';
            loadAllocations(nodeId);
        } else {
            showToast(d.error || 'Failed', 'error');
        }
    })
    .catch(function() {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-plus"></i> Submit';
        showToast('Request failed', 'error');
    });
}

function deleteAllocation(nodeId, allocId) {
    fetch('/admin/nodes/' + nodeId + '/allocations/' + allocId + '/delete', { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) { loadAllocations(nodeId); }
            else { showToast(d.error || 'Failed', 'error'); }
        })
        .catch(function() { showToast('Request failed', 'error'); });
}

function loadNodeSecret(nodeId) {
    fetch('/admin/nodes/' + nodeId + '/secret')
        .then(function(r) { return r.json(); })
        .then(function(d) {
            if (d.success) {
                document.getElementById('nodeSecret').value = d.secret;
                var panelUrl = window.location.origin;
                document.getElementById('daemonCmd').textContent = 'node amcdaemon.js --install ' + panelUrl + ' ' + d.secret;
            }
        })
        .catch(function() {});
}

function copyNodeSecret() {
    var el = document.getElementById('nodeSecret');
    el.select();
    document.execCommand('copy');
    showToast('Secret copied to clipboard', 'success');
}

function regenerateSecret() {
    var id = document.getElementById('nodeId').value;
    if (!id) return;
    showConfirm('Regenerate the node secret? You will need to update the daemon config on the remote server.').then(function(ok) {
        if (!ok) return;
        showLoading('Regenerating secret...', true);
        fetch('/admin/nodes/' + id + '/secret/regenerate', { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                hideLoading();
                if (d.success) {
                    document.getElementById('nodeSecret').value = d.secret;
                    var panelUrl = window.location.origin;
                    document.getElementById('daemonCmd').textContent = 'node amcdaemon.js --install ' + panelUrl + ' ' + d.secret;
                    showToast('Secret regenerated', 'success');
                } else {
                    showToast(d.error || 'Failed to regenerate secret', 'error');
                }
            })
            .catch(function() { hideLoading(); showToast('Request failed', 'error'); });
    });
}

// Load SFTP network status for each node
async function loadSftpStatus() {
    try {
        const res = await fetch('/api/sftp/nodes/network');
        const data = await res.json();
        if (data.success && data.nodes) {
            data.nodes.forEach(function(node) {
                const badge = document.querySelector('.sftp-status-badge[data-node-id="' + node.nodeId + '"]');
                if (!badge) return;
                const method = node.recommendedMethod || 'unknown';
                const isReachable = node.connectable;
                let icon, color, label;
                if (node.isLocalNode) {
                    icon = 'fa-server'; color = 'var(--accent)'; label = 'SFTP: Local';
                } else if (method === 'direct_ipv4' || method === 'direct_ipv6') {
                    icon = 'fa-wifi'; color = 'var(--success)'; label = 'SFTP: Direct';
                } else if (method === 'proxy_ssh') {
                    icon = 'fa-shield'; color = 'var(--info)'; label = 'SFTP: Proxy';
                } else if (method === 'relay_ws') {
                    icon = 'fa-turn-up'; color = 'var(--warning)'; label = 'SFTP: Relay';
                } else {
                    icon = 'fa-circle-xmark'; color = 'var(--danger)'; label = 'SFTP: Unreachable';
                }
                badge.innerHTML = '<i class="fas ' + icon + '" style="color:' + color + ';"></i> ' + label;
                badge.title = 'Node: ' + node.nodeName + ' | Public: ' + (node.publicIp || 'None') + ' | CGNAT: ' + node.isCGNAT + ' | Private: ' + node.isPrivate;
            });
        }
    } catch (e) {
        document.querySelectorAll('.sftp-status-badge').forEach(function(el) {
            el.innerHTML = '<i class="fas fa-circle-question" style="color:var(--text-muted);"></i> SFTP: Unknown';
        });
    }
}
loadSftpStatus();

document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeNodeDrawer(); });

// Move drawer elements to <body> so they escape any CSS transform
// containing block (e.g. the pageEnter animation on .page-wrap).
// position:fixed must be relative to the viewport, not a transformed ancestor.
(function() {
    var bg = document.getElementById('nodeDrawerBg');
    var drawer = document.getElementById('nodeDrawer');
    if (bg) document.body.appendChild(bg);
    if (drawer) document.body.appendChild(drawer);
})();

(function() {
    var params = new URLSearchParams(window.location.search);
    if (params.get('action') === 'create') {
        setTimeout(function() { openLocalNode(); }, 300);
        window.history.replaceState({}, '', window.location.pathname);
    }
})();
</script>


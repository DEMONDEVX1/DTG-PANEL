<%- include('../partials/header') %>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="mb-0">
                    <i class="fas fa-tag"></i> Referral Codes Management
                </h2>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCodeModal">
                    <i class="fas fa-plus"></i> New Referral Code
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover" id="codesTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%;">Code</th>
                                    <th style="width: 20%;">Name</th>
                                    <th style="width: 10%;">Credits</th>
                                    <th style="width: 12%;">Claims</th>
                                    <th style="width: 15%;">Expires</th>
                                    <th style="width: 10%;">Status</th>
                                    <th style="width: 18%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% codes.forEach(code => { %>
                                    <tr>
                                        <td><code class="badge bg-info"><%= code.code %></code></td>
                                        <td>
                                            <strong><%= code.name %></strong>
                                            <% if (code.description) { %>
                                                <br><small class="text-muted"><%= code.description %></small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-success">💰 <%= code.credits %></span>
                                        </td>
                                        <td>
                                            <% if (code.max_claims > 0) { %>
                                                <%= code.claims_count %> / <%= code.max_claims %>
                                            <% } else { %>
                                                <%= code.claims_count %> (Unlimited)
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (code.expiry_date) { %>
                                                <%= new Date(code.expiry_date).toLocaleDateString() %>
                                            <% } else { %>
                                                <span class="text-muted">Never</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <span class="badge bg-<%= code.status === 'active' ? 'success' : 'danger' %>">
                                                <%= code.status %>
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-warning" onclick="editCode('<%= code.id %>', '<%= code.code %>', '<%= code.name %>', '<%= code.description || '' %>', '<%= code.credits %>', '<%= code.max_claims %>', '<%= code.expiry_date || '' %>', '<%= code.status %>')">
                                                <i class="fas fa-edit"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" onclick="deleteCode('<%= code.id %>', '<%= code.code %>')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                        <% if (codes.length === 0) { %>
                            <div class="alert alert-info text-center">
                                <i class="fas fa-info-circle"></i> No referral codes yet. Create one to get started!
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Code Modal -->
<div class="modal fade" id="addCodeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">New Referral Code</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="codeForm">
                    <input type="hidden" id="codeId">
                    
                    <div class="mb-3">
                        <label class="form-label">Code <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="code" placeholder="e.g., WELCOME2024" required>
                        <small class="text-muted">Unique code that users will enter</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" placeholder="e.g., Welcome Bonus" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" id="description" rows="2" placeholder="Optional description"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Credits <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">💰</span>
                                    <input type="number" class="form-control" id="credits" min="1" required>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label">Max Claims</label>
                                <input type="number" class="form-control" id="max_claims" min="0" placeholder="0 = Unlimited">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Expiry Date</label>
                        <input type="date" class="form-control" id="expiry_date">
                        <small class="text-muted">Leave empty for no expiry</small>
                    </div>

                    <div class="mb-3" id="statusDiv" style="display: none;">
                        <label class="form-label">Status</label>
                        <select class="form-control" id="status">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveCode()">Save Code</button>
            </div>
        </div>
    </div>
</div>

<script>
function editCode(id, code, name, description, credits, max_claims, expiry_date, status) {
    document.getElementById('modalTitle').textContent = 'Edit Referral Code';
    document.getElementById('codeId').value = id;
    document.getElementById('code').value = code;
    document.getElementById('name').value = name;
    document.getElementById('description').value = description;
    document.getElementById('credits').value = credits;
    document.getElementById('max_claims').value = max_claims;
    document.getElementById('expiry_date').value = expiry_date ? expiry_date.split('T')[0] : '';
    document.getElementById('status').value = status;
    document.getElementById('statusDiv').style.display = 'block';
    document.getElementById('code').readOnly = true;
    
    new bootstrap.Modal(document.getElementById('addCodeModal')).show();
}

function saveCode() {
    const codeId = document.getElementById('codeId').value;
    const code = document.getElementById('code').value.toUpperCase();
    const name = document.getElementById('name').value;
    const description = document.getElementById('description').value;
    const credits = document.getElementById('credits').value;
    const max_claims = document.getElementById('max_claims').value || 0;
    const expiry_date = document.getElementById('expiry_date').value;
    const status = document.getElementById('status').value || 'active';

    if (!code || !name || !credits) {
        alert('Please fill in all required fields');
        return;
    }

    const url = codeId ? `/admin/referral-codes/${codeId}/edit` : '/admin/referral-codes/create';
    const method = 'POST';

    fetch(url, {
        method: method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code, name, description, credits, max_claims, expiry_date, status })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert('Code saved successfully!');
            location.reload();
        } else {
            alert('Error: ' + data.message);
        }
    })
    .catch(err => alert('Error: ' + err.message));
}

function deleteCode(id, code) {
    if (!confirm(`Delete referral code "${code}"? This action cannot be undone.`)) return;

    fetch(`/admin/referral-codes/${id}/delete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert('Code deleted successfully!');
            location.reload();
        } else {
            alert('Error: ' + data.message);
        }
    })
    .catch(err => alert('Error: ' + err.message));
}

// Reset modal form when opening for new code
document.getElementById('addCodeModal').addEventListener('show.bs.modal', function (e) {
    if (e.relatedTarget && e.relatedTarget.classList.contains('btn-primary')) {
        document.getElementById('codeForm').reset();
        document.getElementById('codeId').value = '';
        document.getElementById('modalTitle').textContent = 'New Referral Code';
        document.getElementById('statusDiv').style.display = 'none';
        document.getElementById('code').readOnly = false;
    }
});
</script>

<%- include('../partials/footer') %>

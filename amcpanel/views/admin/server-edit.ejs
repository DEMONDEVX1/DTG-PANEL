<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-edit text-accent"></i>
            Edit Server
        </h1>
        <p class="page-subtitle">Update server configuration and settings</p>
    </div>
    <div class="page-actions">
        <a href="/admin/servers" class="btn btn-ghost">
            <i class="fas fa-arrow-left"></i>
            Back to Servers
        </a>
    </div>
</div>

<div class="grid-2">
    <div>
        <div class="card">
            <div class="card-header d-flex align-center justify-between">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <div class="flex-shrink-0" style="width: 36px; height: 36px; border-radius: var(--r-md); background: var(--accent-dim); display: flex; align-items: center; justify-content: center;">
                        <i class="fas fa-server text-accent"></i>
                    </div>
                    <%= editServer.name %>
                </h3>
                <span class="badge <%= editServer.status === 'running' ? 'badge-success' : 'badge-danger' %>">
                    <span class="status-dot <%= editServer.status === 'running' ? 'online' : 'offline' %>"></span>
                    <%= editServer.status %>
                </span>
            </div>
            <div class="card-body">
                <form id="editServerForm" method="post" action="/admin/servers/<%= editServer.id %>/update">
                    <input type="hidden" name="serverId" value="<%= editServer.id %>">
                    
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-tag text-accent"></i>
                            Server Name *
                        </label>
                        <input type="text" name="name" class="form-control" value="<%= editServer.name %>" required minlength="3" maxlength="64">
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            A friendly name for your server (3-64 characters)
                        </span>
                    </div>

                    <div class="grid-2">
                        <div class="form-group">
                            <label class="form-label"><i class="fas fa-calendar-times text-accent"></i> Expiry Date</label>
                            <input type="datetime-local" name="expiry_date" class="form-control" min="<%= new Date(Date.now() + 60000).toISOString().slice(0,16) %>" value="<%= editServer.expiry_date ? new Date(editServer.expiry_date).toISOString().slice(0,16) : '' %>">
                            <span class="form-hint">Leave empty for no expiry.</span>
                        </div>
                        <div class="form-group">
                            <label class="form-label"><i class="fas fa-palette text-accent"></i> Button Colour</label>
                            <input type="color" name="custom_color" class="form-control" value="<%= editServer.custom_color || '#40916c' %>" style="height:42px;padding:4px;cursor:pointer">
                            <span class="form-hint">Colour used by this server's controls.</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-cloud text-accent"></i> Minekube Connect Address</label>
                        <input type="text" name="minekube_address" class="form-control" value="<%= editServer.minekube_address || '' %>" maxlength="255" placeholder="play.example.minekube.cloud">
                        <span class="form-hint">Optional public hostname from Minekube Connect.</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user text-accent"></i>
                            Server Owner *
                        </label>
                        <select name="owner_id" class="form-control" required>
                            <% users.forEach(u => { %>
                                <option value="<%= u.id %>" <%= editServer.owner_id === u.id ? 'selected' : '' %>>
                                    <%= u.username %> (<%= u.email %>)
                                </option>
                            <% }) %>
                        </select>
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            The user who will own and manage this server
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-cube text-accent"></i>
                            Server Type *
                        </label>
                        <select name="server_type" class="form-control" required disabled>
                            <option value="<%= editServer.server_type %>"><%= editServer.server_type %></option>
                        </select>
                        <span class="form-hint" style="color: var(--warning);">
                            <i class="fas fa-exclamation-triangle"></i>
                            Server type cannot be changed after creation
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-code-branch text-accent"></i>
                            Minecraft Version *
                        </label>
                        <input type="text" name="version" class="form-control" value="<%= editServer.version %>" required>
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            Current version (change with caution - may require server reinstall)
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-network-wired text-accent"></i>
                            Server Port *
                        </label>
                        <input type="number" name="port" class="form-control" value="<%= editServer.port %>" required min="1024" max="65535">
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            Port number for the server (1024-65535)
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-memory text-accent"></i>
                            RAM Allocation (MB) *
                        </label>
                        <input type="number" name="ram" class="form-control" value="<%= editServer.ram %>" required min="512">
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            Memory allocated to the server (minimum: 512 MB)
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-microchip text-accent"></i>
                            CPU Cores *
                        </label>
                        <input type="number" name="cpu" class="form-control" value="<%= editServer.cpu || 2 %>" required min="1">
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            Number of CPU cores (minimum: 1)
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-hdd text-accent"></i>
                            Disk Space (MB) *
                        </label>
                        <input type="number" name="disk" class="form-control" value="<%= editServer.disk || 10240 %>" required min="1024">
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            Disk space allocated (minimum: 1024 MB / 1 GB)
                        </span>
                    </div>

                    <div class="form-actions">
                        <a href="/admin/servers" class="btn btn-ghost">
                            <i class="fas fa-times"></i>
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="fas fa-save"></i>
                            Update Server
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-info-circle text-info"></i>
                    Server Details
                </h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    <div>
                        <div class="text-xs text-muted mb-1">Server ID</div>
                        <div class="fw-600">#<%= editServer.id %></div>
                    </div>
                    <div>
                        <div class="text-xs text-muted mb-1">Server Type</div>
                        <span class="badge badge-info"><%= editServer.server_type %></span>
                    </div>
                    <div>
                        <div class="text-xs text-muted mb-1">Created</div>
                        <div class="fw-500 d-flex align-center gap-1">
                            <i class="fas fa-calendar text-muted"></i>
                            <%= new Date(editServer.created_at).toLocaleDateString() %>
                        </div>
                    </div>
                    <div>
                        <div class="text-xs text-muted mb-1">Current Status</div>
                        <span class="badge <%= editServer.status === 'running' ? 'badge-success' : 'badge-danger' %>">
                            <span class="status-dot <%= editServer.status === 'running' ? 'online' : 'offline' %>"></span>
                            <%= editServer.status %>
                        </span>
                    </div>
                    <div>
                        <div class="text-xs text-muted mb-1">Owner</div>
                        <div class="fw-500 d-flex align-center gap-1">
                            <i class="fas fa-user text-muted"></i>
                            <%= editServer.owner_name || 'Unknown' %>
                        </div>
                    </div>
                    <div>
                        <div class="text-xs text-muted mb-1">Resources</div>
                        <div class="d-flex flex-column gap-1 text-sm">
                            <div class="d-flex align-center gap-2">
                                <i class="fas fa-memory text-warning" style="width: 14px;"></i>
                                <span class="text-muted">RAM:</span>
                                <span class="fw-600"><%= editServer.ram %> MB</span>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <i class="fas fa-microchip text-info" style="width: 14px;"></i>
                                <span class="text-muted">CPU:</span>
                                <span class="fw-600"><%= editServer.cpu || 2 %> Cores</span>
                            </div>
                            <div class="d-flex align-center gap-2">
                                <i class="fas fa-hdd text-success" style="width: 14px;"></i>
                                <span class="text-muted">Disk:</span>
                                <span class="fw-600"><%= (editServer.disk || 10240) / 1024 %> GB</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-bolt text-warning"></i>
                    Quick Actions
                </h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <a href="/servers/<%= editServer.id %>/dashboard" class="btn btn-ghost w-100">
                        <i class="fas fa-tachometer-alt"></i>
                        View Dashboard
                    </a>
                    <a href="/servers/<%= editServer.id %>/console" class="btn btn-ghost w-100">
                        <i class="fas fa-terminal"></i>
                        Open Console
                    </a>
                    <a href="/servers/<%= editServer.id %>/filemanager" class="btn btn-ghost w-100">
                        <i class="fas fa-folder"></i>
                        File Manager
                    </a>
                    <% if (editServer.status === 'running') { %>
                        <button class="btn btn-danger w-100" onclick="toggleServer('stop')">
                            <i class="fas fa-stop"></i>
                            Stop Server
                        </button>
                    <% } else { %>
                        <button class="btn btn-success w-100" onclick="toggleServer('start')">
                            <i class="fas fa-play"></i>
                            Start Server
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="card" style="border-color: var(--danger);">
            <div class="card-header" style="background: var(--danger-dim); border-bottom-color: var(--danger);">
                <h3 class="d-flex align-center gap-2 fw-600" style="color: var(--danger);">
                    <i class="fas fa-exclamation-triangle"></i>
                    Danger Zone
                </h3>
            </div>
            <div class="card-body">
                <div class="fw-600 mb-1">Delete Server</div>
                <div class="text-sm text-muted mb-2">
                    Permanently delete this server and all associated data. This action cannot be undone.
                </div>
                <button class="btn btn-danger w-100" onclick="deleteServer()">
                    <i class="fas fa-trash"></i>
                    Delete Server
                </button>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-question-circle text-info"></i>
                    Help
                </h3>
            </div>
            <div class="card-body">
                <div class="text-sm text-muted" style="line-height: 1.6;">
                    <p class="mb-2">
                        <strong>Changing Port:</strong> Make sure the new port is not already in use by another server.
                    </p>
                    <p class="mb-2">
                        <strong>Resource Limits:</strong> RAM, CPU, and Disk changes take effect after server restart. The server cannot exceed these limits.
                    </p>
                    <p class="mb-0">
                        <strong>Version Change:</strong> Changing version may require server reinstall or cause compatibility issues.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('editServerForm').addEventListener('submit', function(e) {
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
    showLoading('Updating server...', true);
});

function toggleServer(action) {
    if (!confirm(`Are you sure you want to ${action} this server?`)) {
        return;
    }

    showLoading(`${action === 'start' ? 'Starting' : 'Stopping'} server...`, true);
    fetch(`/servers/<%= editServer.id %>/${action}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        hideLoading();
        if (data.success) {
            showToast(`Server ${action}ed successfully!`, 'success');
            setTimeout(() => location.reload(), 1500);
        } else {
            showToast('Error: ' + (data.error || `Failed to ${action} server`), 'error');
        }
    })
    .catch(err => {
        hideLoading();
        console.error('Error:', err);
        showToast('An error occurred', 'error');
    });
}

function deleteServer() {
    const serverName = <%- JSON.stringify(editServer.name) %>;
    
    if (!confirm(`Are you sure you want to delete server "${serverName}"?\n\nThis will:\n• Delete all server files\n• Remove all backups\n• This action cannot be undone`)) {
        return;
    }

    const secondConfirm = prompt(`Type "${serverName}" to confirm deletion:`);
    if (secondConfirm !== serverName) {
        showToast('Deletion cancelled - server name did not match', 'error');
        return;
    }

    showLoading('Deleting server...', true);
    fetch(`/servers/<%= editServer.id %>/delete`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(res => res.json())
    .then(data => {
        hideLoading();
        if (data.success) {
            showToast('Server deleted successfully', 'success');
            setTimeout(() => {
                window.location.href = '/admin/servers';
            }, 1500);
        } else {
            showToast('Error: ' + (data.error || 'Failed to delete server'), 'error');
        }
    })
    .catch(err => {
        hideLoading();
        console.error('Error:', err);
        showToast('An error occurred', 'error');
    });
}
</script>

<%- include('../partials/footer') %>

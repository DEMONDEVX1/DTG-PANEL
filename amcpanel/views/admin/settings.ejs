<%- include('../partials/header') %>

<% if (settings.dashboardThemeUrl) { %>
<style>
body { background-image: url('<%= settings.dashboardThemeUrl %>') !important; background-size: cover !important; background-position: center !important; background-attachment: fixed !important; }
body::before { display: none !important; }
</style>
<% if (settings.dashboardThemeUrl.match(/\.(mp4|webm|ogg)$/i)) { %>
<video autoplay muted loop playsinline style="position:fixed;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:-1;opacity:0.35;">
  <source src="<%= settings.dashboardThemeUrl %>" type="video/mp4">
</video>
<% } %>
<% } %>
<% if (settings.panelFont) { %>
<link href="https://fonts.googleapis.com/css2?family=<%= settings.panelFont.replace(/ /g,'+') %>:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>body,*{font-family:'<%= settings.panelFont %>',Inter,sans-serif !important;}</style>
<% } %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-sliders-h text-accent"></i>
            Panel Settings
        </h1>
        <p class="page-subtitle">Configure panel settings and appearance</p>
    </div>
</div>

<div class="tabs">
    <div class="tab-item active" id="stab-general" onclick="switchTab('general',this)"><i class="fas fa-cog"></i> General</div>
    <div class="tab-item" id="stab-icons" onclick="switchTab('icons',this)"><i class="fas fa-image"></i> Icons</div>
    <div class="tab-item" id="stab-system" onclick="switchTab('system',this)"><i class="fas fa-info-circle"></i> System</div>
</div>

<div class="alert alert-info d-flex align-center gap-2 mb-4">
    <i class="fas fa-palette text-accent" style="font-size: 18px;"></i>
    <div>
        <div class="fw-600 text-sm">Themes &amp; Fonts have their own page</div>
        <div class="text-xs text-muted">Upload backgrounds, GIFs, videos and change fonts from the dedicated page. <a href="/admin/themes" class="fw-600" style="color: var(--accent);">Open Themes &amp; Fonts →</a></div>
    </div>
</div>

<div class="stab-panel active" id="tab-general">
<div class="grid-2">
    <div>
        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-cog text-accent"></i>
                    General Settings
                </h3>
            </div>
            <div class="card-body">
                <form id="generalForm" onsubmit="updateGeneral(event)">
                    <div class="form-group">
                        <label class="form-label">Panel Name</label>
                        <input type="text" name="panelName" class="form-control" value="<%= settings.panelName %>" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Panel Description</label>
                        <textarea name="panelDescription" class="form-control" rows="3"><%= settings.panelDescription %></textarea>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Footer Text</label>
                        <input type="text" name="footerText" class="form-control" value="<%= settings.footerText %>">
                    </div>

                    <div class="form-group">
                        <label class="form-label">Registration</label>
                        <select name="registrationEnabled" class="form-control">
                            <option value="true" <%= settings.registrationEnabled ? 'selected' : '' %>>Enabled</option>
                            <option value="false" <%= !settings.registrationEnabled ? 'selected' : '' %>>Disabled</option>
                        </select>
                        <span class="form-hint">Allow new users to register</span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Max Servers Per User</label>
                        <input type="number" name="maxServersPerUser" class="form-control" value="<%= settings.maxServersPerUser %>" min="1" max="100">
                        <span class="form-hint">Maximum number of servers each user can create</span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i>
                        Save General Settings
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-info-circle text-info"></i>
                    System Information
                </h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-between p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Database Path</span>
                        <span class="text-xs" style="word-break: break-all;"><%= DB_PATH %></span>
                    </div>
                    <div class="d-flex justify-between p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Servers Directory</span>
                        <span class="text-xs" style="word-break: break-all;"><%= SERVERS_DIR %></span>
                    </div>
                    <div class="d-flex justify-between p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Node Version</span>
                        <span class="fw-500"><%= process.version %></span>
                    </div>
                    <div class="d-flex justify-between p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Platform</span>
                        <span class="fw-500"><%= process.platform %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-chart-bar text-success"></i>
                    Current Settings
                </h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-between align-center p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Registration Status</span>
                        <span class="badge <%= settings.registrationEnabled ? 'badge-success' : 'badge-danger' %>">
                            <%= settings.registrationEnabled ? 'Enabled' : 'Disabled' %>
                        </span>
                    </div>
                    <div class="d-flex justify-between align-center p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Max Servers/User</span>
                        <span class="fw-600"><%= settings.maxServersPerUser %></span>
                    </div>
                    <div class="d-flex justify-between align-center p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Panel Name</span>
                        <span class="fw-600"><%= settings.panelName %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card" style="border-color: var(--danger);">
            <div class="card-header" style="background: var(--danger-dim); border-color: var(--danger);">
                <h3 class="d-flex align-center gap-2 fw-600" style="color: var(--danger);">
                    <i class="fas fa-exclamation-triangle"></i>
                    Danger Zone
                </h3>
            </div>
            <div class="card-body">
                <p class="text-muted text-sm mb-2">
                    These actions are irreversible. Please be careful.
                </p>
                <button class="btn btn-danger" onclick="clearCache()">
                    <i class="fas fa-trash"></i>
                    Clear Cache
                </button>
            </div>
        </div>
    </div>
</div>
</div>

<div class="stab-panel" id="tab-icons">
<div class="grid-2">
    <div>
        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-image text-accent"></i>
                    Panel Icons
                </h3>
            </div>
            <div class="card-body">
                <form id="iconForm" onsubmit="updateIcons(event)" enctype="multipart/form-data">
                    <div class="form-group">
                        <label class="form-label">Site Icon (Favicon)</label>
                        <input type="file" name="siteIcon" class="form-control" accept="image/*">
                        <span class="form-hint">Current: <%= settings.siteIcon || '/site-icon.jpg' %></span>
                        <% if (settings.siteIcon) { %>
                            <div class="mt-2">
                                <img src="<%= settings.siteIcon %>" alt="Site Icon" style="width: 64px; height: 64px; object-fit: contain; border-radius: var(--r-md); background: var(--bg-tertiary); padding: 8px;">
                            </div>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Header Icon (Logo)</label>
                        <input type="file" name="headerIcon" class="form-control" accept="image/*">
                        <span class="form-hint">Current: <%= settings.headerIcon || '/header-icon.jpg' %></span>
                        <% if (settings.headerIcon) { %>
                            <div class="mt-2">
                                <img src="<%= settings.headerIcon %>" alt="Header Icon" style="width: 64px; height: 64px; object-fit: contain; border-radius: var(--r-md); background: var(--bg-tertiary); padding: 8px;">
                            </div>
                        <% } %>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload"></i>
                        Upload Icons
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
</div>

<div class="stab-panel" id="tab-system">
<div class="grid-2">
    <div>
        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600"><i class="fas fa-info-circle text-info"></i> System Information</h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-between p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Database Path</span>
                        <span class="text-xs" style="word-break: break-all;"><%= DB_PATH %></span>
                    </div>
                    <div class="d-flex justify-between p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Servers Directory</span>
                        <span class="text-xs" style="word-break: break-all;"><%= SERVERS_DIR %></span>
                    </div>
                    <div class="d-flex justify-between p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Node Version</span>
                        <span class="fw-500"><%= process.version %></span>
                    </div>
                    <div class="d-flex justify-between p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Platform</span>
                        <span class="fw-500"><%= process.platform %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div>
        <div class="card">
            <div class="card-header"><h3 class="d-flex align-center gap-2 fw-600"><i class="fas fa-chart-bar text-success"></i> Current Settings</h3></div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-between align-center p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Registration Status</span>
                        <span class="badge <%= settings.registrationEnabled ? 'badge-success' : 'badge-danger' %>">
                            <%= settings.registrationEnabled ? 'Enabled' : 'Disabled' %>
                        </span>
                    </div>
                    <div class="d-flex justify-between align-center p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Max Servers/User</span>
                        <span class="fw-600"><%= settings.maxServersPerUser %></span>
                    </div>
                    <div class="d-flex justify-between align-center p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Panel Font</span>
                        <span class="fw-600"><%= settings.panelFont || 'Inter (Default)' %></span>
                    </div>
                    <div class="d-flex justify-between align-center p-2 rounded" style="background: var(--bg-tertiary);">
                        <span class="text-muted text-sm">Dashboard Theme</span>
                        <span class="badge <%= settings.dashboardThemeUrl ? 'badge-success' : 'badge-info' %>">
                            <%= settings.dashboardThemeUrl ? 'Custom' : 'Default' %>
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="card" style="border-color: var(--danger);">
            <div class="card-header" style="background: var(--danger-dim); border-color: var(--danger);">
                <h3 class="d-flex align-center gap-2 fw-600" style="color: var(--danger);"><i class="fas fa-exclamation-triangle"></i> Danger Zone</h3>
            </div>
            <div class="card-body">
                <p class="text-muted text-sm mb-2">These actions are irreversible.</p>
                <button class="btn btn-danger" onclick="clearCache()"><i class="fas fa-trash"></i> Clear Cache</button>
            </div>
        </div>
    </div>
</div>
</div>

<style>
.stab-panel{display:none;animation:tabFadeIn 0.25s ease;}.stab-panel.active{display:block;}
@keyframes tabFadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
</style>

<script>
(function(){
  document.addEventListener('DOMContentLoaded',function(){
    switchTab('general',document.getElementById('stab-general'));
  });
})();
function switchTab(name,btn){
  document.querySelectorAll('.stab-panel').forEach(function(p){p.classList.remove('active');});
  document.querySelectorAll('.tab-item').forEach(function(b){b.classList.remove('active');});
  var panel=document.getElementById('tab-'+name);
  if(panel) panel.classList.add('active');
  if(btn) btn.classList.add('active');
}

async function updateGeneral(e) {
    e.preventDefault();
    const btn = e.target.querySelector('button[type=submit]');
    btn.disabled=true; btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Saving...';
    const data = Object.fromEntries(new FormData(e.target).entries());
    try {
        const r = await fetch('/admin/settings/general',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
        const res = await r.json();
        if(res.success){ showToast('Settings saved!','success'); setTimeout(()=>location.reload(),1000); }
        else showToast('Error: '+(res.error||'Failed'),'error');
    } catch(err){ showToast('An error occurred','error'); }
    btn.disabled=false; btn.innerHTML='<i class="fas fa-save"></i> Save General Settings';
}

async function updateIcons(e) {
    e.preventDefault();
    const fd=new FormData(e.target);
    if(!fd.get('siteIcon').size&&!fd.get('headerIcon').size){showToast('Select at least one icon','error');return;}
    const btn=e.target.querySelector('button[type=submit]');
    btn.disabled=true;btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Uploading...';
    try{
        const r=await fetch('/admin/settings/icons',{method:'POST',body:fd});
        const res=await r.json();
        if(res.success){showToast('Icons updated!','success');setTimeout(()=>location.reload(),800);}
        else showToast('Error: '+(res.error||'Failed'),'error');
    }catch(err){showToast('Error','error');}
    btn.disabled=false;btn.innerHTML='<i class="fas fa-upload"></i> Upload Icons';
}

function clearCache(){
  if(!confirm('Clear cache?')) return;
  showToast('Cache clearing not yet implemented','info');
}
</script>

<%- include('../partials/footer') %>

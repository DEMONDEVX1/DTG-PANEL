<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-palette text-accent"></i>
            Themes &amp; Fonts
        </h1>
        <p class="page-subtitle">Customize the look and feel of your <%= settings.panelName || 'DTG PANEL' %> — backgrounds, UI presets, fonts, colors</p>
    </div>
    <div class="page-actions">
        <a href="/admin/settings" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Back to Settings</a>
    </div>
</div>

<!-- ══════════════════════════════════════════
     UNIFIED PANEL UI STYLE CARD
══════════════════════════════════════════ -->
<div class="card mb-4">
    <div class="card-header">
        <h3 class="d-flex align-center gap-2 fw-600"><i class="fas fa-wand-magic-sparkles text-accent"></i> Panel UI Style</h3>
    </div>
    <div class="card-body">
        <p class="text-muted text-sm mb-4">Customize every visual aspect of the panel. Changes preview live — click <strong>Save Panel UI</strong> to apply to all users.</p>

        <!-- UI Style Preset (visual cards) -->
        <div class="adv-label"><i class="fas fa-paint-brush text-accent"></i> UI Style Preset</div>
        <div class="style-grid mb-4">
            <button class="style-card" data-group="uiStyle" data-v="solid"      onclick="setOpt('uiStyle','solid',this)">
                <div class="style-thumb" style="background:#151728;border:1px solid rgba(255,255,255,.08);">
                    <div style="width:32%;height:100%;background:#111323;border-right:1px solid rgba(255,255,255,.06);"></div>
                </div><span>Solid</span>
            </button>
            <button class="style-card" data-group="uiStyle" data-v="glass"      onclick="setOpt('uiStyle','glass',this)">
                <div class="style-thumb" style="background:linear-gradient(135deg,#1a1f3a,#2a1f5a);">
                    <div style="width:32%;height:100%;background:rgba(255,255,255,.05);border-right:1px solid rgba(255,255,255,.1);"></div>
                </div><span>Glass</span>
            </button>
            <button class="style-card" data-group="uiStyle" data-v="neon"       onclick="setOpt('uiStyle','neon',this)">
                <div class="style-thumb" style="background:#07080f;border:1px solid rgba(99,102,241,.35);box-shadow:0 0 10px rgba(99,102,241,.15);">
                    <div style="width:32%;height:100%;background:#0a0b15;border-right:1px solid rgba(99,102,241,.3);"></div>
                </div><span>Neon</span>
            </button>
            <button class="style-card" data-group="uiStyle" data-v="minimal"    onclick="setOpt('uiStyle','minimal',this)">
                <div class="style-thumb" style="background:#111318;border:1px solid rgba(255,255,255,.04);">
                    <div style="width:32%;height:100%;background:#16181f;border-right:1px solid rgba(255,255,255,.04);"></div>
                </div><span>Minimal</span>
            </button>
            <button class="style-card" data-group="uiStyle" data-v="cyberpunk"  onclick="setOpt('uiStyle','cyberpunk',this)">
                <div class="style-thumb" style="background:#05060e;border:1px solid rgba(0,255,245,.3);position:relative;">
                    <div style="width:32%;height:100%;background:#080a16;border-right:1px solid rgba(0,255,245,.2);"></div>
                    <div style="position:absolute;top:0;left:32%;right:0;height:2px;background:linear-gradient(90deg,#00fff5,#ff006e);"></div>
                </div><span>Cyberpunk</span>
            </button>
            <button class="style-card" data-group="uiStyle" data-v="neumorphic" onclick="setOpt('uiStyle','neumorphic',this)">
                <div class="style-thumb" style="background:#1a1d2e;box-shadow:inset 3px 3px 8px rgba(0,0,0,.5),inset -2px -2px 5px rgba(255,255,255,.03);">
                    <div style="width:32%;height:100%;background:#1a1d2e;box-shadow:4px 0 10px rgba(0,0,0,.4);"></div>
                </div><span>Neumorphic</span>
            </button>
            <button class="style-card" data-group="uiStyle" data-v="frosted"    onclick="setOpt('uiStyle','frosted',this)">
                <div class="style-thumb" style="background:rgba(255,255,255,.06);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.12);">
                    <div style="width:32%;height:100%;background:rgba(255,255,255,.04);border-right:1px solid rgba(255,255,255,.1);"></div>
                </div><span>Frosted</span>
            </button>
            <button class="style-card" data-group="uiStyle" data-v="terminal"   onclick="setOpt('uiStyle','terminal',this)">
                <div class="style-thumb" style="background:#000;border:1px solid rgba(0,255,65,.3);position:relative;">
                    <div style="width:32%;height:100%;background:#000;border-right:1px solid rgba(0,255,65,.2);"></div>
                    <div style="position:absolute;top:6px;right:6px;width:6px;height:6px;border-radius:50%;background:#00ff41;box-shadow:0 0 6px #00ff41;"></div>
                </div><span>Terminal</span>
            </button>
        </div>

        <div class="ui-divider"></div>

        <!-- Sidebar Style -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-sidebar"></i> Sidebar</div>
            <div class="ui-seg" data-group="sidebarStyle">
                <button class="ui-seg-btn" data-v="solid"    onclick="setOpt('sidebarStyle','solid',this)"><i class="fas fa-square"></i> Solid</button>
                <button class="ui-seg-btn" data-v="glass"    onclick="setOpt('sidebarStyle','glass',this)"><i class="fas fa-glass-martini"></i> Glass</button>
                <button class="ui-seg-btn" data-v="gradient" onclick="setOpt('sidebarStyle','gradient',this)"><i class="fas fa-fill-drip"></i> Gradient</button>
            </div>
        </div>

        <!-- Card Style -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-layer-group"></i> Card Style</div>
            <div class="ui-seg" data-group="cardStyle">
                <button class="ui-seg-btn" data-v="solid"    onclick="setOpt('cardStyle','solid',this)"><i class="fas fa-square-full"></i> Solid</button>
                <button class="ui-seg-btn" data-v="glass"    onclick="setOpt('cardStyle','glass',this)"><i class="fas fa-glass-water"></i> Glass</button>
                <button class="ui-seg-btn" data-v="bordered" onclick="setOpt('cardStyle','bordered',this)"><i class="fas fa-border-all"></i> Bordered</button>
                <button class="ui-seg-btn" data-v="flat"     onclick="setOpt('cardStyle','flat',this)"><i class="fas fa-minus"></i> Flat</button>
                <button class="ui-seg-btn" data-v="elevated" onclick="setOpt('cardStyle','elevated',this)"><i class="fas fa-layer-group"></i> Elevated</button>
                <button class="ui-seg-btn" data-v="neon"     onclick="setOpt('cardStyle','neon',this)"><i class="fas fa-star"></i> Neon</button>
            </div>
        </div>

        <!-- Top Bar -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-bars"></i> Top Bar</div>
            <div class="ui-seg" data-group="topbarStyle">
                <button class="ui-seg-btn" data-v="solid"       onclick="setOpt('topbarStyle','solid',this)"><i class="fas fa-square"></i> Solid</button>
                <button class="ui-seg-btn" data-v="glass"       onclick="setOpt('topbarStyle','glass',this)"><i class="fas fa-glass-martini"></i> Glass</button>
                <button class="ui-seg-btn" data-v="blur"        onclick="setOpt('topbarStyle','blur',this)"><i class="fas fa-circle-half-stroke"></i> Blur</button>
                <button class="ui-seg-btn" data-v="dark"        onclick="setOpt('topbarStyle','dark',this)"><i class="fas fa-moon"></i> Dark</button>
                <button class="ui-seg-btn" data-v="accent"      onclick="setOpt('topbarStyle','accent',this)"><i class="fas fa-palette"></i> Accent</button>
                <button class="ui-seg-btn" data-v="transparent" onclick="setOpt('topbarStyle','transparent',this)"><i class="fas fa-eye-slash"></i> Transparent</button>
            </div>
        </div>

        <!-- Corner Radius -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-circle-notch"></i> Corner Radius</div>
            <div class="ui-seg" data-group="cornerRadius">
                <button class="ui-seg-btn" data-v="sharp"   onclick="setOpt('cornerRadius','sharp',this)">Sharp</button>
                <button class="ui-seg-btn" data-v="rounded" onclick="setOpt('cornerRadius','rounded',this)">Rounded</button>
                <button class="ui-seg-btn" data-v="extra"   onclick="setOpt('cornerRadius','extra',this)">Extra</button>
            </div>
        </div>

        <!-- Sidebar Width -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-left-right"></i> Sidebar Width</div>
            <div class="ui-seg" data-group="sidebarWidth">
                <button class="ui-seg-btn" data-v="compact" onclick="setOpt('sidebarWidth','compact',this)"><i class="fas fa-compress-alt"></i> Compact</button>
                <button class="ui-seg-btn" data-v="normal"  onclick="setOpt('sidebarWidth','normal',this)"><i class="fas fa-arrows-left-right"></i> Normal</button>
                <button class="ui-seg-btn" data-v="wide"    onclick="setOpt('sidebarWidth','wide',this)"><i class="fas fa-expand-alt"></i> Wide</button>
            </div>
        </div>

        <!-- Border Glow -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-sun"></i> Border Glow</div>
            <div class="ui-seg" data-group="cardBorderGlow">
                <button class="ui-seg-btn" data-v="off"    onclick="setOpt('cardBorderGlow','off',this)"><i class="fas fa-ban"></i> Off</button>
                <button class="ui-seg-btn" data-v="subtle" onclick="setOpt('cardBorderGlow','subtle',this)"><i class="fas fa-circle"></i> Subtle</button>
                <button class="ui-seg-btn" data-v="medium" onclick="setOpt('cardBorderGlow','medium',this)"><i class="fas fa-sun"></i> Medium</button>
                <button class="ui-seg-btn" data-v="strong" onclick="setOpt('cardBorderGlow','strong',this)"><i class="fas fa-bolt"></i> Strong</button>
                <button class="ui-seg-btn" data-v="pulse"  onclick="setOpt('cardBorderGlow','pulse',this)"><i class="fas fa-heart-pulse"></i> Pulse</button>
            </div>
        </div>

        <!-- Glass Blur -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-droplet-slash"></i> Glass Blur</div>
            <div style="flex:1;max-width:280px;">
                <input type="range" min="4" max="40" step="2" value="<%= settings.glassBlur || 14 %>"
                    oninput="document.getElementById('glassBlurVal').textContent=this.value+'px';setGlassBlur(this.value)"
                    style="width:100%;accent-color:var(--accent);">
                <div class="d-flex justify-between text-xs text-muted mt-1">
                    <span>Subtle</span><span id="glassBlurVal"><%= settings.glassBlur || 14 %>px</span><span>Heavy</span>
                </div>
            </div>
        </div>

        <!-- Font Scale -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-text-height"></i> Font Scale</div>
            <div class="ui-seg" data-group="fontScale">
                <button class="ui-seg-btn" data-v="small"  onclick="setOpt('fontScale','small',this)">Small</button>
                <button class="ui-seg-btn" data-v="normal" onclick="setOpt('fontScale','normal',this)">Normal</button>
                <button class="ui-seg-btn" data-v="large"  onclick="setOpt('fontScale','large',this)">Large</button>
                <button class="ui-seg-btn" data-v="xl"     onclick="setOpt('fontScale','xl',this)">XL</button>
            </div>
        </div>

        <!-- Animation Speed -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-gauge-high"></i> Animation Speed</div>
            <div class="ui-seg" data-group="animSpeed">
                <button class="ui-seg-btn" data-v="slow"    onclick="setOpt('animSpeed','slow',this)">🐢 Slow</button>
                <button class="ui-seg-btn" data-v="normal"  onclick="setOpt('animSpeed','normal',this)">🏃 Normal</button>
                <button class="ui-seg-btn" data-v="fast"    onclick="setOpt('animSpeed','fast',this)">⚡ Fast</button>
                <button class="ui-seg-btn" data-v="instant" onclick="setOpt('animSpeed','instant',this)">⏩ Instant</button>
            </div>
        </div>

        <!-- Motion -->
        <div class="ui-opt-row">
            <div class="ui-opt-label"><i class="fas fa-film"></i> Motion &amp; Effects</div>
            <div class="ui-seg" data-group="uiMotion">
                <button class="ui-seg-btn" data-v="on"  onclick="setOpt('uiMotion','on',this)"><i class="fas fa-play"></i> On</button>
                <button class="ui-seg-btn" data-v="off" onclick="setOpt('uiMotion','off',this)"><i class="fas fa-pause"></i> Off</button>
            </div>
        </div>

        <div class="ui-divider"></div>

        <!-- Accent Color -->
        <div class="adv-label mt-3"><i class="fas fa-droplet text-accent"></i> Accent Color</div>
        <div class="accent-box">
            <div class="accent-swatches">
                <button class="swatch" style="background:linear-gradient(135deg,#6366f1,#8b5cf6);" title="Indigo (Default)" onclick="pickAccent('#6366f1','#8b5cf6',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#3b82f6,#06b6d4);" title="Blue Cyan"        onclick="pickAccent('#3b82f6','#06b6d4',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#10b981,#14b8a6);" title="Emerald"          onclick="pickAccent('#10b981','#14b8a6',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#f59e0b,#ef4444);" title="Amber Red"        onclick="pickAccent('#f59e0b','#ef4444',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#ec4899,#a855f7);" title="Pink Purple"      onclick="pickAccent('#ec4899','#a855f7',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#00fff5,#ff006e);" title="Cyberpunk"        onclick="pickAccent('#00fff5','#ff006e',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#00ff41,#00cc33);" title="Matrix Green"     onclick="pickAccent('#00ff41','#00cc33',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#ff6b35,#f7c59f);" title="Sunset"          onclick="pickAccent('#ff6b35','#f7c59f',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#667eea,#764ba2);" title="Purple"           onclick="pickAccent('#667eea','#764ba2',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#f093fb,#f5576c);" title="Rose"            onclick="pickAccent('#f093fb','#f5576c',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#4facfe,#00f2fe);" title="Sky"             onclick="pickAccent('#4facfe','#00f2fe',this)"></button>
                <button class="swatch" style="background:linear-gradient(135deg,#43e97b,#38f9d7);" title="Mint"            onclick="pickAccent('#43e97b','#38f9d7',this)"></button>
            </div>
            <div class="d-flex gap-2 mt-2 align-center flex-wrap">
                <div>
                    <div class="text-xs text-muted mb-1">Primary</div>
                    <input type="color" id="ac1" value="<%= settings.accentColor || '#6366f1' %>" oninput="previewAccent()" style="width:48px;height:34px;border-radius:8px;border:1px solid var(--border-strong);padding:2px;cursor:pointer;">
                </div>
                <div>
                    <div class="text-xs text-muted mb-1">Secondary</div>
                    <input type="color" id="ac2" value="<%= settings.accentColor2 || '#8b5cf6' %>" oninput="previewAccent()" style="width:48px;height:34px;border-radius:8px;border:1px solid var(--border-strong);padding:2px;cursor:pointer;">
                </div>
                <div style="flex:1;min-width:100px;">
                    <div class="text-xs text-muted mb-1">Preview</div>
                    <div id="accentBar" style="height:34px;border-radius:8px;background:var(--accent-grad);transition:background .25s;"></div>
                </div>
                <div style="align-self:flex-end;">
                    <button class="btn btn-ghost btn-sm" onclick="resetAccent()"><i class="fas fa-undo"></i> Reset</button>
                </div>
            </div>
        </div>

        <!-- Save / Reset -->
        <div class="d-flex gap-2 mt-4 pt-3 border-top">
            <button class="btn btn-primary" onclick="saveAll()"><i class="fas fa-save"></i> Save Panel UI</button>
            <button class="btn btn-ghost"   onclick="resetAll()"><i class="fas fa-rotate-left"></i> Reset to Default</button>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════
     BACKGROUND + FONT GRID
══════════════════════════════════════════ -->
<div class="grid-2">
    <div>
        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600"><i class="fas fa-image text-accent"></i> Background Theme</h3>
            </div>
            <div class="card-body">
                <p class="text-muted text-sm mb-3">Upload any image, GIF, or video as the panel background.</p>

                <div class="form-group mb-3">
                    <label class="form-label text-xs fw-700 text-muted" style="text-transform:uppercase;letter-spacing:0.8px;">
                        <i class="fas fa-link text-accent"></i> Paste a direct URL (GIF, MP4, WebM, JPG, PNG)
                    </label>
                    <div class="input-group">
                        <input type="text" id="themeUrlInput" placeholder="https://i.imgur.com/xyz.gif" class="form-control" style="flex:1;">
                        <button class="btn btn-primary" onclick="applyUrlTheme()"><i class="fas fa-check"></i> Apply URL</button>
                    </div>
                </div>

                <div class="border mb-3"></div>

                <div class="theme-upload-zone" id="themeDropZone">
                    <input type="file" id="themeFileInput" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm" onchange="handleThemeFile(this.files[0])">
                    <div style="font-size:40px;color:var(--accent);opacity:0.6;margin-bottom:12px;"><i class="fas fa-cloud-upload-alt"></i></div>
                    <div class="fw-600 mb-1">Click here to choose a file</div>
                    <div class="text-muted text-xs">JPG &bull; PNG &bull; GIF &bull; WebP &bull; MP4 &bull; WebM &bull; max 200MB</div>
                </div>

                <div class="theme-file-preview" id="themeFilePreview">
                    <img id="themePreviewImg" src="" alt="" style="display:none;width:100%;max-height:180px;object-fit:cover;">
                    <video id="themePreviewVid" autoplay muted loop style="display:none;width:100%;max-height:180px;object-fit:cover;"></video>
                    <div class="d-flex align-center justify-between p-1" style="background:var(--bg-tertiary);">
                        <span id="themePreviewName" class="text-sm"></span>
                        <button onclick="clearThemeFile()" class="btn-icon btn-danger" style="font-size:14px;"><i class="fas fa-times"></i></button>
                    </div>
                </div>

                <div class="upload-progress-wrap" id="uploadProgressWrap">
                    <div class="d-flex justify-between text-xs text-muted fw-600 mb-1">
                        <span><i class="fas fa-spinner fa-spin"></i> Uploading...</span><span id="uploadPct">0%</span>
                    </div>
                    <div class="progress-wrap"><div class="progress-bar accent" id="uploadBar" style="width:0%"></div></div>
                </div>

                <div class="d-flex gap-2 mt-2">
                    <button class="btn btn-primary" onclick="uploadTheme()"><i class="fas fa-check"></i> Apply Theme</button>
                    <% if(settings.dashboardThemeUrl){ %>
                    <button class="btn btn-danger" onclick="removeTheme()"><i class="fas fa-trash"></i> Remove</button>
                    <% } %>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <div class="fw-600 mb-2 d-flex align-center gap-1"><i class="fas fa-star text-warning"></i> Quick Presets</div>
                    <div class="grid-3 gap-1">
                        <button class="btn btn-sm" style="background:linear-gradient(135deg,#020817,#0f2460,#6366f1);border:none;color:#fff;" onclick="applyPreset('linear-gradient(135deg,#020817,#0f2460,#6366f1)')">Deep Blue</button>
                        <button class="btn btn-sm" style="background:linear-gradient(135deg,#0a0a0a,#1a1a2e,#16213e);border:none;color:#fff;" onclick="applyPreset('linear-gradient(135deg,#0a0a0a,#1a1a2e,#16213e)')">Midnight</button>
                        <button class="btn btn-sm" style="background:linear-gradient(135deg,#0c1445,#0a3d62,#1e90ff);border:none;color:#fff;" onclick="applyPreset('linear-gradient(135deg,#0c1445,#0a3d62,#1e90ff)')">Ocean</button>
                        <button class="btn btn-sm" style="background:linear-gradient(135deg,#0d0221,#190d3a,#3b0764);border:none;color:#fff;" onclick="applyPreset('linear-gradient(135deg,#0d0221,#190d3a,#3b0764)')">Nebula</button>
                        <button class="btn btn-sm" style="background:linear-gradient(135deg,#0a1628,#0d2137,#064e3b);border:none;color:#fff;" onclick="applyPreset('linear-gradient(135deg,#0a1628,#0d2137,#064e3b)')">Forest</button>
                        <button class="btn btn-sm" style="background:linear-gradient(135deg,#1a0a0a,#3b0a0a,#7f1d1d);border:none;color:#fff;" onclick="applyPreset('linear-gradient(135deg,#1a0a0a,#3b0a0a,#7f1d1d)')">Crimson</button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div>
        <div class="card">
            <div class="card-header"><h3 class="d-flex align-center gap-2 fw-600"><i class="fas fa-eye text-accent"></i> Current Theme</h3></div>
            <div class="card-body">
                <div class="rounded overflow-hidden border mb-2" style="min-height:140px;background:var(--bg-tertiary);display:flex;align-items:center;justify-content:center;">
                    <% if(settings.dashboardThemeUrl){ %>
                        <% if(settings.dashboardThemeType === 'video' || /\.(mp4|webm|ogg)$/i.test(settings.dashboardThemeUrl)){ %>
                            <video src="<%= settings.dashboardThemeUrl %>" autoplay muted loop playsinline style="width:100%;max-height:180px;object-fit:cover;"></video>
                        <% } else { %>
                            <img src="<%= settings.dashboardThemeUrl %>" alt="Current theme" style="width:100%;max-height:180px;object-fit:cover;">
                        <% } %>
                    <% } else if(settings.dashboardThemePreset){ %>
                        <div style="width:100%;height:140px;background:<%= settings.dashboardThemePreset %>;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:14px;">Preset Active</div>
                    <% } else { %>
                        <div class="text-center text-muted">
                            <i class="fas fa-image" style="font-size:36px;opacity:0.2;display:block;margin-bottom:8px;"></i>
                            Default gradient
                        </div>
                    <% } %>
                </div>
                <% if(settings.dashboardThemeUrl){ %>
                <div class="p-1 rounded text-xs text-muted mb-3" style="background:var(--bg-tertiary);word-break:break-all;"><i class="fas fa-link"></i> <%= settings.dashboardThemeUrl %></div>
                <% } %>
                <div class="mb-2">
                    <div class="fw-600 text-sm mb-1">Background Opacity</div>
                    <input type="range" min="5" max="100" value="<%= settings.dashboardThemeOpacity||85 %>" oninput="document.getElementById('opacityVal').textContent=this.value+'%'" id="opacitySlider" style="width:100%;accent-color:var(--accent);height:6px;">
                    <div class="d-flex justify-between text-xs text-muted mt-1">
                        <span>Subtle</span><span id="opacityVal"><%= settings.dashboardThemeOpacity||85 %>%</span><span>Full</span>
                    </div>
                    <button class="btn btn-ghost w-100 mt-2" onclick="saveOpacity()"><i class="fas fa-save"></i> Save Opacity</button>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3 class="d-flex align-center gap-2 fw-600"><i class="fas fa-font text-accent"></i> Panel Font</h3></div>
            <div class="card-body">
                <div class="p-2 rounded border mb-2" style="background:var(--bg-tertiary);">
                    <div class="fw-700" id="fontPreviewTitle" style="font-size:22px;"><%= settings.panelName || 'DTG PANEL' %></div>
                    <div class="text-muted text-sm" id="fontPreviewBody">The quick brown fox jumps over the lazy dog. 0123456789</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Choose Font</label>
                    <select id="fontSelect" class="form-control" onchange="previewFont(this.value)">
                        <option value="">Default (Inter)</option>
                        <% ['Roboto','Open Sans','Poppins','Montserrat','Nunito','Space Grotesk','DM Sans','Outfit','Oxanium','Orbitron','Exo 2','Rajdhani','Audiowide','Lexend','Sora'].forEach(function(f){ %>
                        <option value="<%= f %>" <%= settings.panelFont===f?'selected':'' %>><%= f %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="alert alert-info text-xs mb-2">
                    <i class="fas fa-star text-warning"></i> <strong>Gaming fonts:</strong> Oxanium, Orbitron, Exo 2, Rajdhani, Audiowide
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" onclick="saveFont()"><i class="fas fa-save"></i> Apply Font</button>
                    <% if(settings.panelFont){ %>
                    <button class="btn btn-ghost" onclick="resetFont()"><i class="fas fa-undo"></i> Reset</button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════ STYLES ══════ -->
<style>
.theme-upload-zone { border:2px dashed var(--accent);border-radius:var(--r-lg);padding:36px 20px;text-align:center;cursor:pointer;transition:all .25s;background:rgba(99,102,241,.04);position:relative; }
.theme-upload-zone:hover,.theme-upload-zone.drag-over { border-color:var(--accent);background:rgba(99,102,241,.08); }
.theme-upload-zone input[type=file] { position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%; }
.theme-file-preview { display:none;margin-top:12px;border-radius:var(--r-md);overflow:hidden;border:1px solid var(--border); }
.theme-file-preview.active { display:block; }
.upload-progress-wrap { display:none;margin-top:12px;padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);border:1px solid var(--border); }
.upload-progress-wrap.active { display:block; }

/* row controls */
.ui-opt-row { display:flex;align-items:center;gap:14px;margin-bottom:12px;flex-wrap:wrap; }
.ui-opt-label { font-size:12.5px;font-weight:700;color:var(--text-secondary);min-width:150px;display:flex;align-items:center;gap:6px; }
.ui-seg { display:inline-flex;gap:4px;padding:4px;background:var(--bg-tertiary);border:1px solid var(--border);border-radius:var(--r-md);flex-wrap:wrap; }
.ui-seg-btn { display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border:none;background:transparent;color:var(--text-secondary);font-size:12.5px;font-weight:600;border-radius:8px;cursor:pointer;transition:all .2s;white-space:nowrap; }
.ui-seg-btn i { font-size:11px; }
.ui-seg-btn:hover { color:var(--text-primary);background:rgba(255,255,255,.04); }
.ui-seg-btn.active { background:var(--accent-grad);color:#fff;box-shadow:0 4px 14px rgba(99,102,241,.3); }

/* section label */
.adv-label { font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:1px;color:var(--text-tertiary);margin-bottom:10px;display:flex;align-items:center;gap:7px; }
.ui-divider { border:none;border-top:1px solid var(--border);margin:18px 0; }

/* style preset grid */
.style-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px; }
.style-card { display:flex;flex-direction:column;align-items:center;gap:8px;background:var(--bg-tertiary);border:2px solid var(--border);border-radius:var(--r-md);padding:10px 8px;cursor:pointer;transition:all .2s;color:var(--text-secondary);font-size:12px;font-weight:600; }
.style-card:hover { border-color:var(--accent);color:var(--text-primary);transform:translateY(-2px); }
.style-card.active { border-color:var(--accent);background:rgba(99,102,241,.08);color:var(--text-primary);box-shadow:0 0 14px rgba(99,102,241,.2); }
.style-thumb { width:100%;height:52px;border-radius:8px;overflow:hidden;display:flex;position:relative; }

/* accent */
.accent-box { background:var(--bg-tertiary);border:1px solid var(--border);border-radius:var(--r-md);padding:14px; }
.accent-swatches { display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px; }
.swatch { width:34px;height:34px;border-radius:50%;border:3px solid transparent;cursor:pointer;transition:all .2s;box-shadow:0 2px 8px rgba(0,0,0,.3); }
.swatch:hover { transform:scale(1.15); }
.swatch.active { border-color:#fff;transform:scale(1.1); }
.flex-wrap { flex-wrap:wrap; }
.mt-3 { margin-top:14px; }
</style>

<!-- ══════ SCRIPTS ══════ -->
<script>
var _selectedFile = null;
var _loginBgFile  = null;

/* ── Single unified UI state ── */
var uiState = {
    uiStyle:        '<%= settings.uiStyle || "solid" %>',
    sidebarStyle:   '<%= settings.sidebarStyle || "solid" %>',
    cardStyle:      '<%= settings.cardStyle || "solid" %>',
    topbarStyle:    '<%= settings.topbarStyle || "solid" %>',
    cornerRadius:   '<%= settings.cornerRadius || "rounded" %>',
    sidebarWidth:   '<%= settings.sidebarWidth || "normal" %>',
    cardBorderGlow: '<%= settings.cardBorderGlow || "off" %>',
    glassBlur:      parseInt('<%= settings.glassBlur || 14 %>') || 14,
    fontScale:      '<%= settings.fontScale || "normal" %>',
    animSpeed:      '<%= settings.animSpeed || "normal" %>',
    uiMotion:       '<%= settings.uiMotion || "on" %>',
    accentColor:    '<%= settings.accentColor || "" %>',
    accentColor2:   '<%= settings.accentColor2 || "" %>'
};
var UI_DEF = {
    uiStyle:'solid', sidebarStyle:'solid', cardStyle:'solid', topbarStyle:'solid',
    cornerRadius:'rounded', sidebarWidth:'normal', cardBorderGlow:'off',
    glassBlur:14, fontScale:'normal', animSpeed:'normal', uiMotion:'on',
    accentColor:'', accentColor2:''
};

/* Map state key → body data attribute name */
var attrMap = {
    uiStyle:'data-ui', sidebarStyle:'data-sidebar', cardStyle:'data-card',
    topbarStyle:'data-topbar', cornerRadius:'data-radius', sidebarWidth:'data-sidebar-width',
    cardBorderGlow:'data-glow', fontScale:'data-font-scale', animSpeed:'data-anim-speed',
    uiMotion:'data-motion'
};

function applyState() {
    Object.keys(attrMap).forEach(function(k) {
        document.body.setAttribute(attrMap[k], uiState[k]);
    });
    document.documentElement.style.setProperty('--glass-blur', uiState.glassBlur + 'px');
    if (uiState.accentColor) {
        var c1=uiState.accentColor, c2=uiState.accentColor2||c1;
        document.documentElement.style.setProperty('--accent', c1);
        document.documentElement.style.setProperty('--accent-2', c2);
        document.documentElement.style.setProperty('--accent-grad','linear-gradient(135deg,'+c1+' 0%,'+c2+' 100%)');
    }
    /* sync all buttons */
    document.querySelectorAll('.ui-seg-btn[data-v]').forEach(function(btn) {
        var seg = btn.closest('.ui-seg[data-group]');
        if (seg) btn.classList.toggle('active', uiState[seg.dataset.group] === btn.dataset.v);
    });
    document.querySelectorAll('.style-card[data-group]').forEach(function(btn) {
        btn.classList.toggle('active', uiState[btn.dataset.group] === btn.dataset.v);
    });
}

function setOpt(group, val, btn) {
    uiState[group] = val;
    /* deactivate siblings in same container */
    var seg  = btn.closest('.ui-seg');
    var grid = btn.closest('.style-grid');
    if (seg)  seg.querySelectorAll('.ui-seg-btn').forEach(function(b){ b.classList.remove('active'); });
    if (grid) grid.querySelectorAll('.style-card').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    /* apply immediately */
    if (attrMap[group]) document.body.setAttribute(attrMap[group], val);
    if (group === 'glassBlur') document.documentElement.style.setProperty('--glass-blur', val+'px');
}

function setGlassBlur(v) {
    uiState.glassBlur = parseInt(v)||14;
    document.documentElement.style.setProperty('--glass-blur', uiState.glassBlur+'px');
}

async function saveAll() {
    var r = await fetch('/admin/settings/general',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(uiState)});
    var res = await r.json();
    if (res.success) { showToast('Panel UI saved! ✨','success'); setTimeout(function(){location.reload();},900); }
    else showToast('Save failed','error');
}
async function resetAll() {
    uiState = Object.assign({}, UI_DEF); applyState();
    var r = await fetch('/admin/settings/general',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(uiState)});
    var res = await r.json();
    if (res.success) { showToast('UI reset to defaults!','success'); setTimeout(function(){location.reload();},900); }
}

/* accent color */
function pickAccent(c1, c2, el) {
    uiState.accentColor=c1; uiState.accentColor2=c2;
    document.getElementById('ac1').value=c1;
    document.getElementById('ac2').value=c2;
    document.querySelectorAll('.swatch').forEach(function(s){ s.classList.remove('active'); });
    el.classList.add('active');
    updateAccentBar(c1,c2); applyState();
}
function previewAccent() {
    var c1=document.getElementById('ac1').value, c2=document.getElementById('ac2').value;
    uiState.accentColor=c1; uiState.accentColor2=c2;
    updateAccentBar(c1,c2); applyState();
}
function updateAccentBar(c1,c2) {
    var bar=document.getElementById('accentBar');
    if(bar) bar.style.background='linear-gradient(135deg,'+c1+','+c2+')';
}
function resetAccent() {
    uiState.accentColor=''; uiState.accentColor2='';
    document.getElementById('ac1').value='#6366f1';
    document.getElementById('ac2').value='#8b5cf6';
    document.documentElement.style.removeProperty('--accent');
    document.documentElement.style.removeProperty('--accent-2');
    document.documentElement.style.removeProperty('--accent-grad');
    var bar=document.getElementById('accentBar');
    if(bar) bar.style.background='var(--accent-grad)';
    document.querySelectorAll('.swatch').forEach(function(s){ s.classList.remove('active'); });
    showToast('Accent reset to default','info');
}

applyState();

/* ── Theme upload / URL ── */
function applyUrlTheme() {
    var url=document.getElementById('themeUrlInput').value.trim();
    if(!url){ showToast('Please enter a URL','error'); return; }
    fetch('/admin/settings/theme-url',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:url})})
    .then(function(r){ return r.json(); }).then(function(res){
        if(res.success){ showToast('Theme applied!','success'); setTimeout(function(){ location.reload(); },1000); }
        else showToast('Error: '+(res.error||'Failed'),'error');
    });
}
function handleThemeFile(file) {
    if(!file) return; _selectedFile=file;
    var p=document.getElementById('themeFilePreview'),i=document.getElementById('themePreviewImg'),v=document.getElementById('themePreviewVid');
    p.classList.add('active'); document.getElementById('themePreviewName').textContent=file.name+' ('+(file.size/1024/1024).toFixed(1)+' MB)';
    var url=URL.createObjectURL(file);
    if(file.type.startsWith('video/')){ i.style.display='none'; v.style.display='block'; v.src=url; }
    else { v.style.display='none'; i.style.display='block'; i.src=url; }
}
function clearThemeFile() {
    _selectedFile=null;
    document.getElementById('themeFilePreview').classList.remove('active');
    document.getElementById('themePreviewImg').src='';
    document.getElementById('themePreviewVid').src='';
    document.getElementById('themeFileInput').value='';
}
var dz=document.getElementById('themeDropZone');
if(dz){
    dz.addEventListener('dragover',function(e){ e.preventDefault(); dz.classList.add('drag-over'); });
    dz.addEventListener('dragleave',function(){ dz.classList.remove('drag-over'); });
    dz.addEventListener('drop',function(e){ e.preventDefault(); dz.classList.remove('drag-over'); if(e.dataTransfer.files[0]) handleThemeFile(e.dataTransfer.files[0]); });
}
function uploadTheme() {
    if(!_selectedFile){ showToast('Please select a file first','error'); return; }
    var pw=document.getElementById('uploadProgressWrap'),bar=document.getElementById('uploadBar'),pct=document.getElementById('uploadPct');
    pw.classList.add('active');
    var fd=new FormData(); fd.append('themeFile',_selectedFile);
    var xhr=new XMLHttpRequest();
    xhr.upload.onprogress=function(e){ if(e.lengthComputable){ var p=Math.round(e.loaded/e.total*100); bar.style.width=p+'%'; pct.textContent=p+'%'; } };
    xhr.onload=function(){ pw.classList.remove('active'); try{ var r=JSON.parse(xhr.responseText); if(r.success){ showToast('Theme applied!','success'); setTimeout(function(){ location.reload(); },1000); } else showToast('Error: '+(r.error||'Failed'),'error'); }catch(e){ showToast('Upload failed','error'); } };
    xhr.onerror=function(){ pw.classList.remove('active'); showToast('Upload failed','error'); };
    xhr.open('POST','/admin/settings/theme-upload'); xhr.send(fd);
}
async function removeTheme() {
    if(!confirm('Remove the current theme?')) return;
    var r=await fetch('/admin/settings/theme-remove',{method:'POST'}); var res=await r.json();
    if(res.success){ showToast('Theme removed','success'); setTimeout(function(){ location.reload(); },800); }
}
async function applyPreset(css) {
    var r=await fetch('/admin/settings/theme-preset',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({css:css})}); var res=await r.json();
    if(res.success){ showToast('Preset applied!','success'); setTimeout(function(){ location.reload(); },800); }
}
async function saveOpacity() {
    var v=document.getElementById('opacitySlider').value;
    var r=await fetch('/admin/settings/general',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({dashboardThemeOpacity:v})}); var res=await r.json();
    if(res.success) showToast('Opacity saved!','success');
}

/* ── Font ── */
function previewFont(font) {
    if(!font){ document.getElementById('fontPreviewTitle').style.fontFamily=''; document.getElementById('fontPreviewBody').style.fontFamily=''; return; }
    var lnk=document.createElement('link'); lnk.rel='stylesheet'; lnk.href='https://fonts.googleapis.com/css2?family='+font.replace(/ /g,'+')+':wght@400;700&display=swap'; document.head.appendChild(lnk);
    setTimeout(function(){ document.getElementById('fontPreviewTitle').style.fontFamily="'"+font+"',sans-serif"; document.getElementById('fontPreviewBody').style.fontFamily="'"+font+"',sans-serif"; },400);
}
async function saveFont() {
    var font=document.getElementById('fontSelect').value;
    var r=await fetch('/admin/settings/general',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({panelFont:font})}); var res=await r.json();
    if(res.success){ showToast('Font saved!','success'); setTimeout(function(){ location.reload(); },800); }
}
async function resetFont() {
    var r=await fetch('/admin/settings/general',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({panelFont:''})}); var res=await r.json();
    if(res.success){ showToast('Font reset!','success'); setTimeout(function(){ location.reload(); },800); }
}

/* ── Login BG ── */
function applyLoginBgUrl() {
    var url=document.getElementById('loginBgUrl').value.trim();
    if(!url){ showToast('Please enter a URL','error'); return; }
    fetch('/admin/settings/general',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({loginBackground:url})})
    .then(function(r){ return r.json(); }).then(function(res){
        if(res.success){ showToast('Login background applied!','success'); setTimeout(function(){ location.reload(); },1000); }
        else showToast('Error','error');
    });
}
function handleLoginBgFile(file) {
    if(!file) return; _loginBgFile=file;
    var p=document.getElementById('loginBgPreview'),i=document.getElementById('loginBgPreviewImg'),v=document.getElementById('loginBgPreviewVid');
    p.classList.add('active'); document.getElementById('loginBgPreviewName').textContent=file.name+' ('+(file.size/1024/1024).toFixed(1)+' MB)';
    var url=URL.createObjectURL(file);
    if(file.type.startsWith('video/')){ i.style.display='none'; v.style.display='block'; v.src=url; }
    else { v.style.display='none'; i.style.display='block'; i.src=url; }
}
function clearLoginBgFile() {
    _loginBgFile=null;
    document.getElementById('loginBgPreview').classList.remove('active');
    document.getElementById('loginBgPreviewImg').src='';
    document.getElementById('loginBgPreviewVid').src='';
    document.getElementById('loginBgFileInput').value='';
}
var ldz=document.getElementById('loginBgDropZone');
if(ldz){
    ldz.addEventListener('dragover',function(e){ e.preventDefault(); ldz.classList.add('drag-over'); });
    ldz.addEventListener('dragleave',function(){ ldz.classList.remove('drag-over'); });
    ldz.addEventListener('drop',function(e){ e.preventDefault(); ldz.classList.remove('drag-over'); if(e.dataTransfer.files[0]) handleLoginBgFile(e.dataTransfer.files[0]); });
}
function uploadLoginBg() {
    if(!_loginBgFile){ showToast('Please select a file first','error'); return; }
    var pw=document.getElementById('loginBgProgressWrap'),bar=document.getElementById('loginBgBar'),pct=document.getElementById('loginBgPct');
    pw.classList.add('active');
    var fd=new FormData(); fd.append('loginBgFile',_loginBgFile);
    var xhr=new XMLHttpRequest();
    xhr.upload.onprogress=function(e){ if(e.lengthComputable){ var p=Math.round(e.loaded/e.total*100); bar.style.width=p+'%'; pct.textContent=p+'%'; } };
    xhr.onload=function(){ pw.classList.remove('active'); try{ var r=JSON.parse(xhr.responseText); if(r.success){ showToast('Login background applied!','success'); setTimeout(function(){ location.reload(); },1000); } else showToast('Error: '+(r.error||'Failed'),'error'); }catch(e){ showToast('Upload failed','error'); } };
    xhr.onerror=function(){ pw.classList.remove('active'); showToast('Upload failed','error'); };
    xhr.open('POST','/admin/settings/login-bg-upload'); xhr.send(fd);
}
async function removeLoginBg() {
    var r=await fetch('/admin/settings/general',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({loginBackground:''})}); var res=await r.json();
    if(res.success){ showToast('Login background removed','success'); setTimeout(function(){ location.reload(); },800); }
}

<% if(settings.panelFont){ %>previewFont('<%= settings.panelFont %>');<% } %>
</script>

<%- include('../partials/footer') %>

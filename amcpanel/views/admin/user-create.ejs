<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-user-plus text-accent"></i>
            Create New User
        </h1>
        <p class="page-subtitle">Add a new user to the panel</p>
    </div>
    <div class="page-actions">
        <a href="/admin/users" class="btn btn-ghost">
            <i class="fas fa-arrow-left"></i>
            Back to Users
        </a>
    </div>
</div>

<div class="grid-2">
    <div>
        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-user-circle text-accent"></i>
                    User Information
                </h3>
            </div>
            <div class="card-body">
                <form id="createUserForm" method="post" action="/admin/users/create">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user text-accent"></i>
                            Username *
                        </label>
                        <input type="text" name="username" class="form-control" placeholder="Enter username" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9_-]+" title="Only letters, numbers, underscores, and hyphens allowed">
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            3-32 characters, letters, numbers, underscores, and hyphens only
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-envelope text-accent"></i>
                            Email Address *
                        </label>
                        <input type="email" name="email" class="form-control" placeholder="user@example.com" required>
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            Must be a valid email address
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-lock text-accent"></i>
                            Password *
                        </label>
                        <input type="password" name="password" id="password" class="form-control" placeholder="Enter password" required minlength="6">
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            Minimum 6 characters
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-lock text-accent"></i>
                            Confirm Password *
                        </label>
                        <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm password" required minlength="6">
                        <span class="form-hint" id="passwordMatch"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user-tag text-accent"></i>
                            Role *
                        </label>
                        <select name="role" class="form-control" required>
                            <option value="user">User - Regular panel user</option>
                            <option value="admin">Admin - Full panel access</option>
                        </select>
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            Admins have full access to all panel features
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-toggle-on text-accent"></i>
                            Status
                        </label>
                        <select name="status" class="form-control">
                            <option value="active">Active - User can login</option>
                            <option value="suspended">Suspended - User cannot login</option>
                        </select>
                    </div>

                    <div class="form-actions mt-4">
                        <a href="/admin/users" class="btn btn-ghost">
                            <i class="fas fa-times"></i>
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="fas fa-user-plus"></i>
                            Create User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-question-circle text-info"></i>
                    Help
                </h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    <div>
                        <div class="fw-600 mb-1 d-flex align-center gap-1">
                            <i class="fas fa-user text-accent"></i>
                            Username
                        </div>
                        <div class="text-sm text-muted" style="line-height: 1.6;">
                            Choose a unique username for the user. Only letters, numbers, underscores, and hyphens are allowed.
                        </div>
                    </div>

                    <div>
                        <div class="fw-600 mb-1 d-flex align-center gap-1">
                            <i class="fas fa-shield-alt text-warning"></i>
                            Password
                        </div>
                        <div class="text-sm text-muted" style="line-height: 1.6;">
                            Set a strong password with at least 6 characters. The user can change it later.
                        </div>
                    </div>

                    <div>
                        <div class="fw-600 mb-1 d-flex align-center gap-1">
                            <i class="fas fa-crown text-warning"></i>
                            Admin Role
                        </div>
                        <div class="text-sm text-muted" style="line-height: 1.6;">
                            Admins have full access to all panel features including user management and settings.
                        </div>
                    </div>

                    <div class="p-2 rounded border" style="background: var(--bg-tertiary); border-left: 3px solid var(--info);">
                        <div class="text-sm text-muted">
                            <i class="fas fa-lightbulb text-info"></i>
                            <strong>Tip:</strong> You can edit user details anytime from the users list.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-chart-bar text-success"></i>
                    Current Stats
                </h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex justify-between align-center">
                        <span class="text-muted text-sm">Total Users</span>
                        <span class="fw-600">Loading...</span>
                    </div>
                    <div class="d-flex justify-between align-center">
                        <span class="text-muted text-sm">Admin Users</span>
                        <span class="fw-600 text-warning">Loading...</span>
                    </div>
                    <div class="d-flex justify-between align-center">
                        <span class="text-muted text-sm">Regular Users</span>
                        <span class="fw-600 text-info">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
var confirmInput = document.getElementById('confirmPassword');
if (confirmInput) confirmInput.addEventListener('input', function() {
    const password = document.getElementById('password').value;
    const confirm = this.value;
    const matchEl = document.getElementById('passwordMatch');
    
    if (confirm.length > 0) {
        if (password === confirm) {
            matchEl.innerHTML = '<i class="fas fa-check-circle" style="color: var(--success);"></i> Passwords match';
            matchEl.style.color = 'var(--success)';
        } else {
            matchEl.innerHTML = '<i class="fas fa-times-circle" style="color: var(--danger);"></i> Passwords do not match';
            matchEl.style.color = 'var(--danger)';
        }
    } else {
        matchEl.innerHTML = '';
    }
});

var createUserForm = document.getElementById('createUserForm');
if (createUserForm) createUserForm.addEventListener('submit', function(e) {
    e.preventDefault();
    const password = document.getElementById('password').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    
    if (password !== confirmPassword) {
        alert('Passwords do not match!');
        return false;
    }
    
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Creating...';
    showLoading('Creating user account...', true);

    var fd = new FormData(e.target);
    var data = {};
    fd.forEach(function(v,k){ data[k] = v; });
    fetch('/admin/users/create', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) })
    .then(function(r) { if(r.redirected||r.status===200) return null; return r.json(); })
    .then(function(d) {
        if(d === null) { showLoading('User created! Redirecting...'); setTimeout(function(){ window.location.href='/admin/users'; }, 600); return; }
        hideLoading(); showToast(d.error||'Failed to create user', 'error');
        submitBtn.disabled = false; submitBtn.innerHTML = '<i class="fas fa-user-plus"></i> Create User';
    })
    .catch(function() { hideLoading(); showToast('Request failed', 'error');
        submitBtn.disabled = false; submitBtn.innerHTML = '<i class="fas fa-user-plus"></i> Create User';
    });
});
</script>

<%- include('../partials/footer') %>

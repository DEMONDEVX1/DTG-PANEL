<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-user-edit text-accent"></i>
            Edit User
        </h1>
        <p class="page-subtitle">Update user information and settings</p>
    </div>
    <div class="page-actions">
        <a href="/admin/users" class="btn btn-ghost">
            <i class="fas fa-arrow-left"></i>
            Back to Users
        </a>
    </div>
</div>

<div class="grid-2">
    <div>
        <div class="card">
            <div class="card-header d-flex align-center justify-between">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <div class="flex-shrink-0" style="width: 36px; height: 36px; border-radius: 50%; background: var(--accent-dim); display: flex; align-items: center; justify-content: center; color: var(--accent); font-weight: 600; font-size: 16px;">
                        <%= editUser.username.charAt(0).toUpperCase() %>
                    </div>
                    <%= editUser.username %>
                </h3>
                <span class="badge <%= editUser.role === 'admin' ? 'badge-warning' : 'badge-info' %>">
                    <i class="fas <%= editUser.role === 'admin' ? 'fa-crown' : 'fa-user' %>"></i>
                    <%= editUser.role %>
                </span>
            </div>
            <div class="card-body">
                <form id="editUserForm" method="post" action="/admin/users/<%= editUser.id %>/update">
                    <input type="hidden" name="userId" value="<%= editUser.id %>">
                    
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user text-accent"></i>
                            Username *
                        </label>
                        <input type="text" name="username" class="form-control" value="<%= editUser.username %>" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9_-]+" title="Only letters, numbers, underscores, and hyphens allowed">
                        <span class="form-hint">
                            <i class="fas fa-info-circle"></i>
                            3-32 characters, letters, numbers, underscores, and hyphens only
                        </span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-envelope text-accent"></i>
                            Email Address *
                        </label>
                        <input type="email" name="email" class="form-control" value="<%= editUser.email %>" required>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-user-tag text-accent"></i>
                            Role *
                        </label>
                        <select name="role" class="form-control" required <%= editUser.id === user.id ? 'disabled' : '' %>>
                            <option value="user" <%= editUser.role === 'user' ? 'selected' : '' %>>User - Regular panel user</option>
                            <option value="admin" <%= editUser.role === 'admin' ? 'selected' : '' %>>Admin - Full panel access</option>
                        </select>
                        <% if (editUser.id === user.id) { %>
                            <span class="form-hint" style="color: var(--warning);">
                                <i class="fas fa-exclamation-triangle"></i>
                                You cannot change your own role
                            </span>
                        <% } else { %>
                            <span class="form-hint">
                                <i class="fas fa-info-circle"></i>
                                Admins have full access to all panel features
                            </span>
                        <% } %>
                    </div>

                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-toggle-on text-accent"></i>
                            Status
                        </label>
                        <select name="status" class="form-control" <%= editUser.id === user.id ? 'disabled' : '' %>>
                            <option value="active" <%= (editUser.status === 'active' || !editUser.status) ? 'selected' : '' %>>Active - User can login</option>
                            <option value="suspended" <%= editUser.status === 'suspended' ? 'selected' : '' %>>Suspended - User cannot login</option>
                        </select>
                        <% if (editUser.id === user.id) { %>
                            <span class="form-hint" style="color: var(--warning);">
                                <i class="fas fa-exclamation-triangle"></i>
                                You cannot suspend yourself
                            </span>
                        <% } %>
                    </div>

                    <div class="p-2 rounded border" style="background: var(--bg-tertiary); border-left: 3px solid var(--info); margin-bottom: 24px;">
                        <div class="fw-600 mb-1 d-flex align-center gap-1">
                            <i class="fas fa-key text-info"></i>
                            Change Password
                        </div>
                        <div class="text-sm text-muted mb-2">
                            Leave blank to keep current password
                        </div>
                        
                        <div class="form-group mb-2">
                            <label class="form-label">New Password</label>
                            <input type="password" name="newPassword" id="newPassword" class="form-control" placeholder="Enter new password" minlength="6">
                        </div>

                        <div class="form-group mb-0">
                            <label class="form-label">Confirm New Password</label>
                            <input type="password" name="confirmPassword" id="confirmPassword" class="form-control" placeholder="Confirm new password" minlength="6">
                            <span class="form-hint" id="passwordMatch"></span>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a href="/admin/users" class="btn btn-ghost">
                            <i class="fas fa-times"></i>
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn">
                            <i class="fas fa-save"></i>
                            Update User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div>
        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-info-circle text-info"></i>
                    User Details
                </h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    <div>
                        <div class="text-xs text-muted mb-1">User ID</div>
                        <div class="fw-600">#<%= editUser.id %></div>
                    </div>
                    <div>
                        <div class="text-xs text-muted mb-1">Created</div>
                        <div class="fw-500 d-flex align-center gap-1">
                            <i class="fas fa-calendar text-muted"></i>
                            <%= new Date(editUser.created_at).toLocaleDateString() %>
                        </div>
                    </div>
                    <div>
                        <div class="text-xs text-muted mb-1">Current Status</div>
                        <span class="badge <%= (editUser.status === 'active' || !editUser.status) ? 'badge-success' : 'badge-danger' %>">
                            <span class="status-dot <%= (editUser.status === 'active' || !editUser.status) ? 'online' : 'error' %>"></span>
                            <%= editUser.status || 'active' %>
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <% if (editUser.id !== user.id) { %>
            <div class="card" style="border-color: var(--danger);">
                <div class="card-header" style="background: var(--danger-dim); border-bottom-color: var(--danger);">
                    <h3 class="d-flex align-center gap-2 fw-600" style="color: var(--danger);">
                        <i class="fas fa-exclamation-triangle"></i>
                        Danger Zone
                    </h3>
                </div>
                <div class="card-body">
                    <div class="fw-600 mb-1">Delete User</div>
                    <div class="text-sm text-muted mb-2">
                        Permanently delete this user and all associated data. This action cannot be undone.
                    </div>
                    <button class="btn btn-danger w-100" onclick="deleteUser()">
                        <i class="fas fa-trash"></i>
                        Delete User
                    </button>
                </div>
            </div>
        <% } %>

        <div class="card">
            <div class="card-header">
                <h3 class="d-flex align-center gap-2 fw-600">
                    <i class="fas fa-question-circle text-info"></i>
                    Help
                </h3>
            </div>
            <div class="card-body">
                <div class="text-sm text-muted" style="line-height: 1.6;">
                    <p class="mb-2">
                        <strong>Changing Password:</strong> Leave the password fields blank to keep the current password.
                    </p>
                    <p class="mb-2">
                        <strong>Suspending Users:</strong> Suspended users cannot login but their data is preserved.
                    </p>
                    <p class="mb-0">
                        <strong>Admin Role:</strong> Admins have full access to all panel features including user management.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
var confirmInput = document.getElementById('confirmPassword');
if (confirmInput) confirmInput.addEventListener('input', function() {
    const password = document.getElementById('newPassword').value;
    const confirm = this.value;
    const matchEl = document.getElementById('passwordMatch');
    
    if (confirm.length > 0 || password.length > 0) {
        if (password === confirm) {
            matchEl.innerHTML = '<i class="fas fa-check-circle" style="color: var(--success);"></i> Passwords match';
            matchEl.style.color = 'var(--success)';
        } else {
            matchEl.innerHTML = '<i class="fas fa-times-circle" style="color: var(--danger);"></i> Passwords do not match';
            matchEl.style.color = 'var(--danger)';
        }
    } else {
        matchEl.innerHTML = '';
    }
});

var editUserForm = document.getElementById('editUserForm');
if (editUserForm) editUserForm.addEventListener('submit', function(e) {
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    
    if (newPassword && newPassword !== confirmPassword) {
        e.preventDefault();
        alert('Passwords do not match!');
        return false;
    }
    
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating...';
    
    if (!newPassword) {
        document.getElementById('newPassword').removeAttribute('name');
        document.getElementById('confirmPassword').removeAttribute('name');
    } else {
        document.getElementById('newPassword').setAttribute('name', 'password');
    }
});

function deleteUser() {
    const username = <%- JSON.stringify(editUser.username) %>;
    
    console.log('Delete user requested:', username);
    
    if (!confirm(`Are you sure you want to delete user "${username}"?\n\nThis will:\n• Delete the user account\n• Remove all associated servers\n• This action cannot be undone`)) {
        console.log('Delete cancelled by user');
        return;
    }

    const secondConfirm = prompt(`Type "${username}" to confirm deletion:`);
    if (secondConfirm !== username) {
        console.log('Delete cancelled - username mismatch');
        showToast('Deletion cancelled - username did not match', 'error');
        return;
    }
    
    console.log('Sending delete request');
    showLoading('Deleting user...', true);

    fetch(`/admin/users/<%= editUser.id %>/delete`, {
        method: 'POST',
        headers: { 
            'Content-Type': 'application/json',
            'Accept': 'application/json'
        },
        redirect: 'manual'
    })
    .then(async res => {
        console.log('Delete response received:', {
            status: res.status,
            type: res.type,
            ok: res.ok
        });
        
        if (res.type === 'opaqueredirect' || res.status === 302 || res.status === 0) {
            console.log('Redirect detected - session expired');
            showToast('Session expired. Please login again.', 'error');
            setTimeout(() => {
                window.location.href = '/auth/login';
            }, 1500);
            return null;
        }
        
        const contentType = res.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            return res.json();
        } else {
            throw new Error('Invalid response format');
        }
    })
    .then(data => {
        hideLoading();
        if (!data) return;
        
        console.log('Delete response data:', data);
        
        if (data.success) {
            showToast('User deleted successfully', 'success');
            setTimeout(() => {
                window.location.href = '/admin/users';
            }, 500);
        } else {
            showToast('Error: ' + (data.error || 'Failed to delete user'), 'error');
        }
    })
    .catch(err => {
        hideLoading();
        console.error('Delete error:', err);
        showToast('An error occurred: ' + err.message, 'error');
    });
}
</script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-users-cog text-accent"></i>
            User Management
        </h1>
        <p class="page-subtitle">Manage all panel users</p>
    </div>
    <div class="page-actions">
        <a href="javascript:void(0)" class="btn btn-primary" onclick="openCreateUser(event); return false;">
            <i class="fas fa-plus"></i>
            Create User
        </a>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon accent"><i class="fas fa-users"></i></div>
        <div class="stat-content">
            <div class="stat-label">Total Users</div>
            <div class="stat-value"><%= users.length %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon warning"><i class="fas fa-crown"></i></div>
        <div class="stat-content">
            <div class="stat-label">Admins</div>
            <div class="stat-value"><%= users.filter(u => u.role === 'admin').length %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon info"><i class="fas fa-user"></i></div>
        <div class="stat-content">
            <div class="stat-label">Regular Users</div>
            <div class="stat-value"><%= users.filter(u => u.role !== 'admin').length %></div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fas fa-circle-check"></i></div>
        <div class="stat-content">
            <div class="stat-label">Active Users</div>
            <div class="stat-value"><%= users.filter(u => u.status === 'active' || !u.status).length %></div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="GET" action="/admin/users" class="d-flex gap-2 flex-wrap">
            <div class="input-group" style="flex: 1; min-width: 250px;">
                <input type="text" name="search" class="form-control" placeholder="Search by username or email..." value="<%= (typeof search !== 'undefined' ? search : '') || '' %>">
            </div>
            <select name="role" class="form-control" style="width: 150px;" onchange="this.form.submit()">
                <option value="">All Roles</option>
                <option value="admin" <%= (typeof role !== 'undefined' && role === 'admin') ? 'selected' : '' %>>Admin</option>
                <option value="user" <%= (typeof role !== 'undefined' && role === 'user') ? 'selected' : '' %>>User</option>
            </select>
            <select name="status" class="form-control" style="width: 150px;" onchange="this.form.submit()">
                <option value="">All Status</option>
                <option value="active" <%= (typeof status !== 'undefined' && status === 'active') ? 'selected' : '' %>>Active</option>
                <option value="suspended" <%= (typeof status !== 'undefined' && status === 'suspended') ? 'selected' : '' %>>Suspended</option>
            </select>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-search"></i>
                Search
            </button>
            <% if (search || (typeof role !== 'undefined' && role) || (typeof status !== 'undefined' && status)) { %>
                <a href="/admin/users" class="btn btn-ghost">
                    <i class="fas fa-times"></i>
                    Clear
                </a>
            <% } %>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-center justify-between">
        <h3 class="d-flex align-center gap-2 fw-600">
            <i class="fas fa-users text-accent"></i>
            All Users
            <span class="badge badge-info"><%= users.length %></span>
        </h3>
        <button class="btn btn-sm btn-ghost" onclick="location.reload()">
            <i class="fas fa-sync-alt"></i>
            Refresh
        </button>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th class="text-sm">ID</th>
                    <th>User</th>
                    <th>Email</th>
                    <th class="text-sm">Role</th>
                    <th class="text-sm">Status</th>
                    <th class="text-sm">Created</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length === 0) { %>
                    <tr>
                        <td colspan="7" class="text-center p-5 text-muted">
                            <i class="fas fa-users text-muted" style="font-size: 48px; opacity: 0.2; display: block; margin-bottom: 12px;"></i>
                            <div class="fw-500 mb-1">No users found</div>
                            <div class="text-sm">Try adjusting your search filters</div>
                        </td>
                    </tr>
                <% } else { %>
                    <% users.forEach(u => { %>
                        <tr>
                            <td class="text-xs text-muted">#<%= u.id %></td>
                            <td>
                                <div class="d-flex align-center gap-2">
                                    <div class="flex-shrink-0" style="width: 36px; height: 36px; border-radius: 50%; background: var(--accent-dim); display: flex; align-items: center; justify-content: center; color: var(--accent); font-weight: 600; font-size: 14px;">
                                        <%= u.username.charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <div class="fw-600"><%= u.username %></div>
                                        <% if (u.id === user.id) { %>
                                            <span class="badge badge-info text-xs" style="padding: 1px 6px;">You</span>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td class="text-secondary"><%= u.email %></td>
                            <td>
                                <span class="badge <%= u.role === 'admin' ? 'badge-warning' : 'badge-info' %>">
                                    <i class="fas <%= u.role === 'admin' ? 'fa-crown' : 'fa-user' %>"></i>
                                    <%= u.role %>
                                </span>
                            </td>
                            <td>
                                <span class="badge <%= (u.status === 'active' || !u.status) ? 'badge-success' : 'badge-danger' %>">
                                    <span class="status-dot <%= (u.status === 'active' || !u.status) ? 'online' : 'error' %>"></span>
                                    <%= u.status || 'active' %>
                                </span>
                            </td>
                            <td class="text-secondary text-sm"><%= new Date(u.created_at).toLocaleDateString() %></td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-center">
                                    <a href="/admin/users/<%= u.id %>/edit" class="btn-icon" title="Edit User">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <% if (u.id !== user.id) { %>
                                        <button class="btn-icon btn-danger" onclick="deleteUser(<%= u.id %>, '<%= u.username %>')" title="Delete User">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    <% } else { %>
                                        <button class="btn-icon" style="opacity: 0.3; cursor: not-allowed;" disabled title="Cannot delete yourself">
                                            <i class="fas fa-ban"></i>
                                        </button>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<div class="drawer-bg" id="drawerBackdrop" onclick="closeAllDrawers()"></div>

<div class="drawer" id="createUserDrawer">
    <div class="drawer-header">
        <div class="drawer-hl">
            <div class="drawer-ico"><i class="fas fa-user-plus"></i></div>
            <div><div class="drawer-ttl">Create New User</div><div class="drawer-sub">Add a new account to <%= settings.panelName || 'DTG PANEL' %></div></div>
        </div>
        <button class="drawer-x" onclick="closeAllDrawers()"><i class="fas fa-times"></i></button>
    </div>
    <div class="drawer-body">
        <div class="progress-wrap mb-3" id="userCreateProgress" style="display:none;">
            <div class="d-flex justify-between text-xs text-muted fw-600 mb-1">
                <span><i class="fas fa-spinner fa-spin"></i> Creating user account...</span>
                <span id="userCreatePct">0%</span>
            </div>
            <div class="progress-wrap">
                <div class="progress-bar success" id="userCreateBar" style="width:0%"></div>
            </div>
        </div>
        <form id="drawerCreateUserForm" method="POST" action="/admin/users/create">
            <div class="form-group">
                <label class="form-label">Username *</label>
                <input type="text" name="username" class="form-control" placeholder="e.g. john_doe" required minlength="3" maxlength="32" pattern="[a-zA-Z0-9_-]+" autocomplete="off">
                <div class="form-hint">3-32 chars, letters/numbers/underscores/hyphens only</div>
            </div>
            <div class="form-group">
                <label class="form-label">Email Address *</label>
                <input type="email" name="email" class="form-control" placeholder="user@example.com" required autocomplete="off">
            </div>
            <div class="grid-2">
                <div class="form-group">
                    <label class="form-label">Password *</label>
                    <input type="password" name="password" id="drawerPassword" class="form-control" placeholder="Min 6 chars" required minlength="6">
                </div>
                <div class="form-group">
                    <label class="form-label">Confirm Password *</label>
                    <input type="password" name="confirmPassword" id="drawerConfirmPw" class="form-control" placeholder="Repeat password" required minlength="6">
                    <div id="drawerPwMatch" class="form-hint"></div>
                </div>
            </div>
            <div class="grid-2">
                <div class="form-group">
                    <label class="form-label">Role *</label>
                    <select name="role" class="form-control" required>
                        <option value="user">User</option>
                        <option value="admin">Admin</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-control">
                        <option value="active">Active</option>
                        <option value="suspended">Suspended</option>
                    </select>
                </div>
            </div>
        </form>
    </div>
    <div class="drawer-footer">
        <button class="btn btn-ghost" onclick="closeAllDrawers()"><i class="fas fa-times"></i> Cancel</button>
        <button class="btn btn-primary" id="drawerCreateUserBtn" onclick="submitCreateUser()">
            <i class="fas fa-user-plus"></i> Create User
        </button>
    </div>
</div>

<style>
tr:hover { background: var(--bg-hover) !important; }
</style>

<script>
function openCreateUser(e){
    if(e) e.preventDefault();
    document.getElementById('drawerBackdrop').classList.add('open');
    document.getElementById('createUserDrawer').classList.add('open');
    document.body.style.overflow='hidden';
    setTimeout(function(){var el=document.querySelector('#createUserDrawer input[name=username]');if(el)el.focus();},400);
}
function closeAllDrawers(){
    document.querySelectorAll('.drawer').forEach(function(d){d.classList.remove('open');});
    var bd=document.getElementById('drawerBackdrop');if(bd)bd.classList.remove('open');
    document.body.style.overflow='';
}
function submitCreateUser(){
    var form=document.getElementById('drawerCreateUserForm');
    var pw=document.getElementById('drawerPassword').value;
    var conf=document.getElementById('drawerConfirmPw').value;
    if(!form.checkValidity()){form.reportValidity();return;}
    if(pw!==conf){var m=document.getElementById('drawerPwMatch');m.className='form-hint';m.innerHTML='<i class="fas fa-times-circle"></i> Passwords do not match';document.getElementById('drawerConfirmPw').focus();return;}
    var btn=document.getElementById('drawerCreateUserBtn');
    btn.disabled=true;btn.innerHTML='<i class="fas fa-spinner fa-spin"></i> Creating...';
    showLoading('Creating user account...', true);
    var fd=new FormData(form);
    var data={};fd.forEach(function(v,k){data[k]=v;});
    fetch('/admin/users/create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)})
    .then(function(r){if(r.redirected||r.status===200) return null;return r.json();})
    .then(function(d){
        if(d===null){showLoading('User created! Redirecting...');setTimeout(function(){location.reload();},600);return;}
        hideLoading();showToast(d.error||'Failed to create user','error');
        btn.disabled=false;btn.innerHTML='<i class="fas fa-user-plus"></i> Create User';
    })
    .catch(function(){hideLoading();showToast('Request failed','error');btn.disabled=false;btn.innerHTML='<i class="fas fa-user-plus"></i> Create User';});
}
function deleteUser(userId,username){
    if(!confirm('Delete user "'+username+'"?\n\nThis will permanently remove the account and all their servers. Cannot be undone.'))return;
    showLoading('Deleting "'+username+'"...', true);
    fetch('/admin/users/'+userId+'/delete',{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'}})
    .then(function(r){
        if(r.ok||r.redirected||r.status===200){
            showLoading('Deleted! Redirecting...');
            setTimeout(function(){location.reload();},600);
        }else{
            r.text().then(function(t){
                hideLoading();var e='Failed (HTTP '+r.status+')';try{var j=JSON.parse(t);e=j.error||e;}catch(x){}
                showToast(e,'error');
            });
        }
    })
    .catch(function(err){hideLoading();showToast('Network error: '+err.message,'error');});
}
document.addEventListener('DOMContentLoaded',function(){
    if(window.location.hash==='#create'){openCreateUser(null);history.replaceState(null,'',window.location.pathname);}
    var pw=document.getElementById('drawerPassword');
    var conf=document.getElementById('drawerConfirmPw');var match=document.getElementById('drawerPwMatch');
    if(conf)conf.addEventListener('input',function(){if(!conf.value){match.textContent='';return;}if(conf.value===pw.value){match.className='form-hint';match.innerHTML='<i class="fas fa-check-circle" style="color:var(--success)"></i> Passwords match';}else{match.className='form-hint';match.innerHTML='<i class="fas fa-times-circle" style="color:var(--danger)"></i> Passwords do not match';}});
    document.addEventListener('keydown',function(e){if(e.key==='Escape')closeAllDrawers();});
});
</script>

<%- include('../partials/footer') %>

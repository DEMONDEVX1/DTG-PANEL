<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#07080f">
    <title>Login - <%= typeof settings !== 'undefined' && settings.panelName ? settings.panelName : 'DTG PANEL' %></title>
    <link rel="icon" href="<%= typeof settings !== 'undefined' && settings.siteIcon ? settings.siteIcon : '/favicon.ico' %>">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/theme.js" defer></script>
    <script>
    (function(){
        var stored = null;
        try { stored = localStorage.getItem('amc_theme'); } catch(e) {}
        var m = stored || 'dark';
        document.documentElement.setAttribute('data-theme', m === 'light' ? 'light' : 'dark');
    })();
    </script>
</head>
<body class="auth-body" data-page="login">
<%
    var loginBg = typeof settings !== 'undefined' && settings.loginBackground ? settings.loginBackground : '';
%>
<% if (loginBg) { %>
    <% if (/\.(mp4|webm|ogg)$/i.test(loginBg)) { %>
    <video id="bgLayer" style="position:fixed;inset:0;z-index:0;width:100%;height:100%;object-fit:cover;" autoplay muted loop playsinline src="<%= loginBg %>"></video>
    <% } else { %>
    <div id="bgLayer" style="position:fixed;inset:0;z-index:0;background:url('<%= loginBg %>') center/cover no-repeat fixed;"></div>
    <% } %>
    <div id="bgOverlay" style="position:fixed;inset:0;z-index:1;background:rgba(7,8,15,0.6);pointer-events:none"></div>
<% } %>

<div class="auth-toolbar">
    <button class="auth-tool-btn auth-theme-toggle" id="authThemeToggle" title="Toggle theme" aria-label="Toggle theme">
        <i class="fas fa-moon icon-moon"></i>
        <i class="fas fa-sun icon-sun"></i>
    </button>
    <button class="auth-tool-btn" id="authBgTrigger" title="Change background" aria-label="Change background">
        <i class="fas fa-palette"></i>
    </button>
</div>
<div class="auth-picker" id="authBgPicker">
    <div id="authBgSwatches"></div>
</div>

<div class="auth-scene">
    <div class="auth-card">
        <div class="auth-logo"><i class="fas fa-shield-halved"></i></div>
        <h1 class="auth-title"><%= typeof settings !== 'undefined' && settings.panelName ? settings.panelName : 'DTG PANEL' %></h1>
        <p class="auth-subtitle">Welcome back — sign in to your control panel to manage your Minecraft servers.</p>

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><i class="fas fa-circle-exclamation"></i><span><%= error %></span></div>
        <% } %>

        <form action="/auth/login" method="POST" id="loginForm" autocomplete="on">
            <div class="auth-field">
                <label class="form-label">Username</label>
                <div class="auth-input-wrap">
                    <i class="fas fa-user auth-input-icon"></i>
                    <input class="auth-input" type="text" name="username" placeholder="Enter your username" required autofocus>
                </div>
            </div>
            <div class="auth-field">
                <label class="form-label">Password</label>
                <div class="auth-input-wrap">
                    <i class="fas fa-lock auth-input-icon"></i>
                    <input class="auth-input" type="password" name="password" placeholder="Enter your password" required>
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg auth-btn" id="loginBtn">
                <i class="fas fa-arrow-right-to-bracket"></i> Sign In
            </button>
        </form>

        <div class="auth-footer">
            <% if (typeof settings !== 'undefined' && settings.registrationEnabled) { %>
            <p>Don't have an account? <a href="/auth/register">Create one now</a></p>
            <% } %>
            <div class="brand">&copy; 2026 DTG PANEL</div>
        </div>
    </div>

    <div class="auth-brand-panel">
        <h2 class="auth-brand-title">Manage your <span>Minecraft</span> servers in style.</h2>
        <p class="auth-brand-desc">A premium control panel built for modern server owners — powerful tools wrapped in a clean, beautiful interface.</p>
        <div class="auth-feature">
            <div class="auth-feature-icon"><i class="fas fa-rocket"></i></div>
            <div>
                <div class="auth-feature-title">One-click server deployment</div>
                <div class="auth-feature-desc">Deploy vanilla, Paper, Purpur, Forge, Fabric and more in seconds.</div>
            </div>
        </div>
        <div class="auth-feature">
            <div class="auth-feature-icon"><i class="fas fa-chart-line"></i></div>
            <div>
                <div class="auth-feature-title">Real-time resource monitoring</div>
                <div class="auth-feature-desc">Live CPU, RAM, disk and player stats streamed to your dashboard.</div>
            </div>
        </div>
        <div class="auth-feature">
            <div class="auth-feature-icon"><i class="fas fa-shield-halved"></i></div>
            <div>
                <div class="auth-feature-title">Secure by design</div>
                <div class="auth-feature-desc">SFTP access, role-based permissions and modern authentication.</div>
            </div>
        </div>
    </div>
</div>

<script>
(function(){
    var f=document.getElementById('loginForm'),b=document.getElementById('loginBtn');
    if(f)f.addEventListener('submit',function(){
        b.innerHTML='<i class="fas fa-circle-notch fa-spin"></i> Signing in...';
        b.disabled=true;
    });
})();
</script>
</body>
</html>

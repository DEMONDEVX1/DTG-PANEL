<%- include('partials/header') %>

<div id="welcomeSplash" aria-hidden="true">
    <div class="wl-grid" aria-hidden="true"></div>
    <div class="wl-sheen" aria-hidden="true"></div>
    <div class="wl-vignette" aria-hidden="true"></div>
    <span class="wl-float" style="width:190px;height:190px;left:7%;top:16%;background:radial-gradient(circle,rgba(99,102,241,.55),transparent 70%);animation-duration:9s"></span>
    <span class="wl-float" style="width:120px;height:120px;right:9%;top:58%;background:radial-gradient(circle,rgba(168,85,247,.5),transparent 70%);animation-duration:7s;animation-delay:.8s"></span>
    <span class="wl-float" style="width:210px;height:210px;left:14%;bottom:6%;background:radial-gradient(circle,rgba(56,189,248,.35),transparent 70%);animation-duration:11s;animation-delay:1.4s"></span>
    <div class="wl-inner">
        <div class="wl-emblem">
            <span class="wl-orbit o1" aria-hidden="true"></span>
            <span class="wl-orbit o2" aria-hidden="true"></span>
            <div class="wl-badge"><i class="fas fa-shield-halved"></i></div>
        </div>
        <div class="wl-overline" id="wlOverline">Welcome to <%= settings.panelName || 'DTG PANEL' %></div>
        <h1 class="wl-title"><span id="wlTitle">Welcome back</span><span class="wl-accent" id="wlName">&hellip;</span></h1>
        <p class="wl-sub">Your Minecraft servers are ready when you are.</p>
        <div class="wl-divider" aria-hidden="true"></div>
        <div class="wl-status">
            <div class="wl-status-text">Preparing your workspace<span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
            <div class="wl-progress"><div class="wl-progress-fill"></div></div>
        </div>
    </div>
</div>

<style>
/* ============ DASHBOARD PREMIUM STYLES (page-local) ============ */
.dash { animation: dashEnter var(--speed-4) var(--ease) both; }
@keyframes dashEnter { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }

/* ----- Entrance stagger helper (backwards fill so hover transforms still work) ----- */
.fade-up { animation: dashFadeUp var(--speed-4) var(--ease) backwards; }
@keyframes dashFadeUp { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }

/* ----- Page header ----- */
.dash-header { margin-bottom: 26px; }
.dash-header .page-title { display: flex; align-items: center; gap: 14px; font-size: 26px; }
.dash-avatar {
  width: 48px; height: 48px; border-radius: var(--r-lg); flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; font-size: 20px; color: #fff;
  background: var(--accent-grad);
  box-shadow: var(--shadow-accent), inset 0 0 0 1px rgba(255,255,255,0.18);
  animation: avatarFloat 5s var(--ease) infinite;
}
@keyframes avatarFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
.dash-date-chip {
  display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px;
  background: var(--bg-tertiary); border: 1px solid var(--border); border-radius: var(--r-full);
  font-size: 12px; color: var(--text-secondary); font-weight: 500;
}
.dash-header .page-actions .btn { border-radius: var(--r-md); }

/* ----- Clean greeting header ----- */
.dash-title { min-width: 0; }
.dash-greet {
  display: flex; align-items: center; gap: 7px; flex-wrap: wrap;
  font-size: 26px; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary);
  animation: greetIn var(--speed-4) var(--ease) both;
}
@keyframes greetIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
.greet-grad {
  background: linear-gradient(90deg, var(--accent), var(--accent-2), var(--accent-3, var(--accent)), var(--accent));
  background-size: 300% 100%;
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
  animation: greetShimmer 6s linear infinite;
}
@keyframes greetShimmer { 0% { background-position: 0% 50%; } 100% { background-position: 300% 50%; } }

/* ----- Stat cards ----- */
.dash-stats { margin-bottom: 30px; }
.dash-stat {
  padding: 22px 20px; border-radius: var(--r-lg);
  background: linear-gradient(180deg, var(--bg-elevated), var(--bg-secondary));
  border: 1px solid var(--border);
  position: relative; overflow: hidden;
  cursor: default;
}
.dash-stat::after {
  content: ''; position: absolute; top: -55%; right: -30%; width: 120px; height: 120px;
  background: radial-gradient(circle, var(--accent-soft), transparent 70%);
  opacity: 0; transition: opacity var(--speed-3) var(--ease); pointer-events: none;
}
.dash-stat:hover { transform: translateY(-5px); border-color: var(--border-accent); box-shadow: var(--shadow-lg); }
.dash-stat:hover::after { opacity: 1; }
.dash-stat .stat-icon {
  width: 52px; height: 52px; border-radius: 14px; font-size: 20px;
  box-shadow: var(--shadow-sm);
}
.dash-stat .stat-icon.accent { background: var(--accent-grad); color: #fff; }
.dash-stat .stat-icon.success { background: linear-gradient(135deg,#10b981,#34d399); color: #fff; }
.dash-stat .stat-icon.danger { background: linear-gradient(135deg,#f43f5e,#fb7185); color: #fff; }
.dash-stat .stat-icon.warning { background: linear-gradient(135deg,#f59e0b,#fbbf24); color: #fff; }
.dash-stat .stat-content { min-width: 0; }
.dash-stat .stat-label {
  font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em;
  color: var(--text-tertiary); margin-bottom: 3px;
}
.dash-stat .stat-value {
  font-size: 26px; font-weight: 700; letter-spacing: -0.02em; color: var(--text-primary);
  font-variant-numeric: tabular-nums; line-height: 1.1;
}

/* ----- Server cards ----- */
.dash-grid { margin-bottom: 30px; }
.dash-server {
  border-radius: var(--r-lg); padding: 20px;
  background: linear-gradient(180deg, var(--bg-elevated), var(--bg-secondary));
  border: 1px solid var(--border);
  position: relative; overflow: hidden;
  transition: transform var(--speed-3) var(--ease), box-shadow var(--speed-3) var(--ease), border-color var(--speed-3) var(--ease);
}
.dash-server::before {
  content: ''; position: absolute; inset: 0 0 auto 0; height: 3px;
  background: var(--accent-grad); opacity: 0; transition: opacity var(--speed-3) var(--ease);
}
.dash-server:hover { transform: translateY(-6px); border-color: var(--border-accent); box-shadow: var(--shadow-lg); }
.dash-server:hover::before { opacity: 1; }
.dash-server::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(130% 90% at 10% -10%, var(--accent-soft), transparent 55%);
  opacity: 0; transition: opacity var(--speed-3) var(--ease); pointer-events: none;
}
.dash-server:hover::after { opacity: 1; }

.dash-server .srv-icon {
  width: 46px; height: 46px; border-radius: 14px; font-size: 18px;
  background: var(--bg-tertiary); border: 1px solid var(--border); color: var(--text-tertiary);
  transition: all var(--speed-3) var(--ease);
}
.dash-server:hover .srv-icon { transform: scale(1.06) rotate(-3deg); }
.dash-server .srv-icon.online {
  background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; border-color: transparent;
  box-shadow: 0 6px 18px var(--accent-glow);
  animation: iconPulse 3s var(--ease) infinite;
}
@keyframes iconPulse { 0%,100% { box-shadow: 0 6px 18px var(--accent-glow); } 50% { box-shadow: 0 6px 26px var(--accent-glow), 0 0 0 8px transparent; } }
.dash-server .srv-name { font-size: 15px; }
.dash-server .srv-sub { font-size: 12px; }

/* Status pill with pulsing LED */
.dash-status {
  display: inline-flex; align-items: center; gap: 7px; padding: 5px 12px;
  border-radius: var(--r-full); font-size: 11px; font-weight: 600; letter-spacing: 0.02em;
  background: var(--bg-tertiary); color: var(--text-secondary); border: 1px solid var(--border);
}
.dash-status .led { width: 8px; height: 8px; border-radius: 50%; background: var(--text-muted); }
.dash-status.online { background: var(--success-soft); color: var(--success); border-color: rgba(16,185,129,0.3); }
.dash-status.online .led {
  background: var(--success);
  animation: ledPulse 1.8s var(--ease) infinite;
}
@keyframes ledPulse {
  0% { box-shadow: 0 0 0 0 rgba(16,185,129,0.55); }
  70% { box-shadow: 0 0 0 7px rgba(16,185,129,0); }
  100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
}
.dash-status.offline { background: var(--bg-tertiary); color: var(--text-tertiary); }
.dash-status.offline .led { background: var(--text-muted); }

/* Server tags */
.dash-tags { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 15px; position: relative; z-index: 1; }
.dash-tag {
  display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; font-size: 11px; font-weight: 600;
  border-radius: var(--r-full); background: var(--bg-tertiary); color: var(--text-secondary);
  border: 1px solid var(--border); transition: all var(--speed-2) var(--ease);
}
.dash-server:hover .dash-tag { border-color: var(--border-strong); }
.dash-tag i { font-size: 9px; opacity: 0.7; }

/* Resource bars */
.dash-bars { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; position: relative; z-index: 1; }
.dash-bar { display: flex; flex-direction: column; gap: 5px; }
.dash-bar-head { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-tertiary); font-weight: 500; }
.dash-bar-head b { color: var(--text-secondary); font-weight: 600; font-variant-numeric: tabular-nums; }
.dash-bar-track {
  height: 6px; border-radius: 999px; background: var(--bg-tertiary); overflow: hidden;
  box-shadow: inset 0 1px 2px rgba(2,4,12,0.25);
}
.dash-bar-fill {
  position: relative; height: 100%; border-radius: 999px; overflow: hidden;
  transition: width 1.2s var(--ease-out);
}
.dash-bar-fill.cpu { background: var(--accent-grad); }
.dash-bar-fill.ram { background: linear-gradient(90deg,#10b981,#34d399); }
.dash-bar-fill.disk { background: linear-gradient(90deg,#f59e0b,#fbbf24); }
.dash-bar-fill::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
  transform: translateX(-100%);
  animation: barShineDash 2.6s var(--ease) infinite;
}
@keyframes barShineDash { 60%,100% { transform: translateX(100%); } }

/* Server action buttons */
.dash-actions { display: flex; gap: 8px; padding-top: 15px; border-top: 1px solid var(--border); position: relative; z-index: 1; }
.dash-actions .btn-view {
  flex: 1; justify-content: center;
  background: var(--accent-soft); color: var(--accent); border: 1px solid rgba(99,102,241,0.25);
}
.dash-actions .btn-view:hover { background: var(--accent-grad); color: #fff; border-color: transparent; box-shadow: var(--shadow-accent); transform: translateY(-2px); }
.dash-actions .btn-icon {
  width: 38px; height: 38px; border-radius: 10px; font-size: 13px;
  background: var(--bg-tertiary); border: 1px solid var(--border); color: var(--text-secondary);
  transition: all var(--speed-2) var(--ease);
}
.dash-actions .btn-icon:hover:not(:disabled) { transform: translateY(-2px) scale(1.05); border-color: var(--border-accent); }
.dash-actions .btn-icon:disabled { opacity: 0.35; cursor: not-allowed; }

/* Bottom panels */
.dash-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
@media (max-width: 768px) { .dash-bottom { grid-template-columns: 1fr; } }
.dash-panel .card-header h3 { font-size: 14px; display: flex; align-items: center; gap: 9px; }
.dash-panel .card-header h3 i { color: var(--accent); }
.dash-panel .res-bar { margin-bottom: 14px; }
.dash-panel .res-bar:last-child { margin-bottom: 0; }
.dash-panel .res-head { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-tertiary); margin-bottom: 6px; }
.dash-panel .res-head i { margin-right: 4px; }
.dash-panel .res-track { height: 7px; background: var(--bg-tertiary); border-radius: 999px; overflow: hidden; box-shadow: inset 0 1px 2px rgba(2,4,12,0.25); }
.dash-panel .res-fill {
  position: relative; height: 100%; border-radius: 999px; background: var(--accent-grad);
  transition: width 1.2s var(--ease-out); overflow: hidden;
}
.dash-panel .res-fill.ram-bar { background: linear-gradient(90deg,#10b981,#34d399); }
.dash-panel .res-fill.disk-bar { background: linear-gradient(90deg,#f59e0b,#fbbf24); }
.dash-panel .res-fill::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.35), transparent);
  transform: translateX(-100%); animation: barShineDash 2.6s var(--ease) infinite;
}
.dash-panel .res-head { font-size: 12px; }
.dash-panel .res-head span:last-child { color: var(--text-secondary); font-weight: 600; font-variant-numeric: tabular-nums; }

/* Empty state */
.dash-empty {
  text-align: center; padding: 72px 24px; border-radius: var(--r-lg);
  border: 1px dashed var(--border-strong); background: var(--bg-secondary);
  animation: dashFadeUp var(--speed-4) var(--ease) 0.15s both;
}
.dash-empty i { font-size: 52px; margin-bottom: 18px; opacity: 0.4; display: block; color: var(--accent); animation: floatY 4s var(--ease) infinite; }
.dash-empty h3 { font-size: 17px; margin-bottom: 6px; }
.dash-empty p { font-size: 13px; color: var(--text-tertiary); margin-bottom: 22px; max-width: 380px; margin-left: auto; margin-right: auto; }

/* Responsive */
@media (max-width: 768px) {
  .dash-header .page-title { font-size: 20px; }
  .dash-avatar { width: 40px; height: 40px; font-size: 16px; }
  .dash-stat .stat-value { font-size: 22px; }
}
@media (max-width: 520px) {
  .dash-stat { padding: 18px 16px; }
  .dash-stat .stat-icon { width: 44px; height: 44px; font-size: 17px; }
}

/* ============ FULL-PAGE WELCOME SPLASH ============ */
#welcomeSplash {
  position: fixed; inset: 0; z-index: 999999;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(165deg, #06070f 0%, #0b0e22 55%, #111540 100%);
  overflow: hidden;
  animation: wlFadeIn 0.5s var(--ease) both;
}
[data-theme="light"] #welcomeSplash { background: linear-gradient(165deg, #f4f5fc 0%, #e8ebf8 55%, #dfe4ff 100%); }
#welcomeSplash.dismiss { animation: wlCurtain 0.7s cubic-bezier(.76,.05,.86,.06) forwards; }
@keyframes wlFadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes wlCurtain { to { opacity: 0; transform: translateY(-100%); } }

#welcomeSplash::before, #welcomeSplash::after {
  content: ''; position: absolute; inset: 0; pointer-events: none;
}
#welcomeSplash::before {
  background:
    radial-gradient(52% 46% at 22% 16%, rgba(99,102,241,0.55), transparent 62%),
    radial-gradient(46% 42% at 82% 24%, rgba(168,85,247,0.5), transparent 62%),
    radial-gradient(60% 50% at 62% 96%, rgba(56,189,248,0.4), transparent 66%);
  background-size: 150% 150%, 160% 160%, 140% 140%;
  animation: wlAurora 16s var(--ease) infinite alternate;
}
@keyframes wlAurora {
  0% { background-position: 0% 0%, 100% 0%, 60% 100%; }
  50% { background-position: 30% 20%, 70% 25%, 40% 90%; }
  100% { background-position: 12% 10%, 92% 8%, 68% 96%; }
}
#welcomeSplash::after {
  background:
    radial-gradient(ellipse at 50% -10%, rgba(99,102,241,0.5), transparent 45%),
    radial-gradient(ellipse at 50% 110%, rgba(56,189,248,0.35), transparent 45%);
  filter: blur(60px); opacity: 0.35; mix-blend-mode: screen;
}
.wl-grid {
  position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0.55;
  background-image: radial-gradient(rgba(148,163,255,0.18) 1px, transparent 1px);
  background-size: 30px 30px;
  -webkit-mask-image: radial-gradient(circle at 50% 45%, #000, transparent 72%);
  mask-image: radial-gradient(circle at 50% 45%, #000, transparent 72%);
}
.wl-sheen {
  position: absolute; inset: -60%; z-index: 1; pointer-events: none;
  background: conic-gradient(from 0deg,
    transparent 0deg, rgba(99,102,241,0.12) 70deg, transparent 140deg,
    transparent 180deg, rgba(56,189,248,0.1) 250deg, transparent 320deg);
  animation: wlSpin 14s linear infinite;
}
@keyframes wlSpin { to { transform: rotate(360deg); } }
.wl-vignette {
  position: absolute; inset: 0; z-index: 2; pointer-events: none;
  background: radial-gradient(circle at 50% 45%, transparent 45%, rgba(2,4,12,0.55) 100%);
}
[data-theme="light"] .wl-vignette { background: radial-gradient(circle at 50% 45%, transparent 55%, rgba(15,20,40,0.18) 100%); }
.wl-float {
  position: absolute; z-index: 1; border-radius: 50%; filter: blur(6px);
  pointer-events: none; opacity: 0.6; animation: wlFloat ease-in-out infinite;
}
@keyframes wlFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-28px); } }

.wl-inner { position: relative; z-index: 3; text-align: center; padding: 0 28px; max-width: 780px; }
.wl-emblem { width: 84px; height: 84px; margin: 0 auto 30px; position: relative; display: flex; align-items: center; justify-content: center; }
.wl-orbit { position: absolute; inset: -24px; border-radius: 50%; border: 1px solid rgba(99,102,241,0.4); border-top-color: var(--accent); animation: wlOrbit 3.2s linear infinite; }
.wl-orbit.o2 { inset: -38px; border-style: dashed; border-color: rgba(148,163,255,0.22); animation: wlOrbitRev 9s linear infinite; }
@keyframes wlOrbit { to { transform: rotate(360deg); } }
@keyframes wlOrbitRev { to { transform: rotate(-360deg); } }
.wl-badge {
  width: 84px; height: 84px; border-radius: 26px; flex-shrink: 0;
  background: var(--accent-grad); color: #fff; font-size: 34px;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 14px 40px var(--accent-glow);
  animation: wlEmblemIn 0.7s var(--ease-out) 0.1s both, wlGlow 3s var(--ease) 1s infinite alternate;
}
@keyframes wlEmblemIn { from { opacity: 0; transform: scale(0.6) rotate(-12deg); } to { opacity: 1; transform: none; } }
@keyframes wlGlow { from { box-shadow: 0 14px 40px var(--accent-glow); } to { box-shadow: 0 14px 60px var(--accent-glow), 0 0 34px var(--accent-glow); } }

.wl-overline {
  font-size: 12px; font-weight: 700; letter-spacing: 0.42em; text-transform: uppercase;
  color: var(--accent); margin-bottom: 18px;
  animation: wlOverIn 0.8s var(--ease) 0.3s both;
}
@keyframes wlOverIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
.wl-title {
  font-size: clamp(40px, 8vw, 74px); font-weight: 800; letter-spacing: -0.035em; line-height: 1.04;
  color: var(--text-primary); margin: 0;
  animation: wlTitleIn 1s var(--ease) 0.4s both;
}
@keyframes wlTitleIn { from { opacity: 0; transform: translateY(36px); filter: blur(12px); } to { opacity: 1; transform: none; filter: none; } }
.wl-title .wl-accent {
  display: block; margin-top: 6px;
  background: linear-gradient(92deg, var(--accent), var(--accent-2), var(--accent-3, var(--accent)), var(--accent));
  background-size: 300% 100%;
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent; color: transparent;
  animation: greetShimmer 6s linear infinite;
  filter: drop-shadow(0 8px 34px var(--accent-glow));
}
.wl-sub { margin-top: 18px; font-size: 14px; color: var(--text-secondary); font-weight: 500; animation: wlFade 1s var(--ease) 0.7s both; }
.wl-divider {
  width: 64px; height: 3px; border-radius: 999px; margin: 30px auto 0;
  background: var(--accent-grad); position: relative; overflow: hidden;
  animation: wlFade 1s var(--ease) 0.8s both;
}
.wl-divider::after {
  content: ''; position: absolute; inset: 0; transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.9), transparent);
  animation: wlSweep 2.2s var(--ease) 1s infinite;
}
@keyframes wlSweep { 60%, 100% { transform: translateX(100%); } }
.wl-status {
  margin-top: 28px; display: flex; flex-direction: column; align-items: center; gap: 12px;
  animation: wlFade 1s var(--ease) 0.95s both;
}
.wl-status-text { font-size: 11.5px; color: var(--text-tertiary); letter-spacing: 0.1em; text-transform: uppercase; }
.wl-status-text .dot { display: inline-block; width: 4px; height: 4px; margin-left: 3px; border-radius: 50%; background: var(--accent); vertical-align: middle; animation: wlBlink 1.1s infinite; }
.wl-status-text .dot:nth-child(2) { animation-delay: 0.2s; }
.wl-status-text .dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes wlBlink { 0%, 80%, 100% { opacity: 0.2; transform: none; } 40% { opacity: 1; transform: translateY(-2px); } }
.wl-progress { width: 200px; height: 3px; border-radius: 999px; background: var(--bg-tertiary); overflow: hidden; }
.wl-progress-fill { height: 100%; width: 0%; border-radius: 999px; background: var(--accent-grad); animation: wlFill 3s var(--ease-in-out) 0.5s forwards; }
@keyframes wlFill { 0% { width: 0%; } 65% { width: 78%; } 100% { width: 100%; } }
@keyframes wlFade { from { opacity: 0; } to { opacity: 1; } }
@media (max-width: 520px) {
  .wl-emblem { width: 64px; height: 64px; }
  .wl-badge { width: 64px; height: 64px; border-radius: 20px; font-size: 26px; }
  .wl-orbit { inset: -18px; }
  .wl-orbit.o2 { inset: -30px; }
  .wl-title { font-size: clamp(30px, 9vw, 44px); }
  .wl-overline { letter-spacing: 0.3em; }
}
</style>

<div class="dash">

<div class="page-header dash-header">
    <div>
        <div class="page-title dash-title">
            <div class="dash-avatar"><i class="fas fa-<%= user.role==='admin' ? 'crown' : 'user' %>"></i></div>
            <div>
                <div id="dbGreeting" class="dash-greet"><span class="greet-text">Welcome back</span><span class="greet-comma">,</span> <span class="greet-name greet-grad"><%= user.display_name || user.username %></span></div>
                <div class="page-subtitle" style="margin-top:6px">
                    <span class="dash-date-chip"><i class="fas fa-calendar"></i> <span id="dbDate"></span></span>
                    <span class="dash-date-chip"><i class="fas fa-user"></i> <%= user.display_name || user.username %></span>
                    <% if (user.role === 'admin') { %><span class="badge badge-info" style="margin-left:2px"><i class="fas fa-crown"></i> Admin</span><% } %>
                </div>
            </div>
        </div>
    </div>
    <div class="page-actions">
        <% if (user.role === 'admin') { %>
        <a href="/admin/servers/create" class="btn btn-primary btn-sm btn-sheen"><i class="fas fa-plus"></i> New Server</a>
        <a href="/admin/nodes" class="btn btn-sm"><i class="fas fa-server"></i> Nodes</a>
        <a href="/admin" class="btn btn-sm btn-ghost"><i class="fas fa-shield-halved"></i> Admin</a>
        <% } %>
        <button class="btn btn-sm btn-ghost" onclick="dbRefresh()" title="Refresh"><i class="fas fa-sync-alt" id="dbSync"></i></button>
    </div>
</div>

<div class="stats-grid dash-stats">
    <div class="stat-card dash-stat fade-up" style="animation-delay:0.05s">
        <div class="stat-icon accent"><i class="fas fa-server"></i></div>
        <div class="stat-content"><div class="stat-label">Total Servers</div><div class="stat-value" data-count-up="<%= servers.length %>"><%= servers.length %></div></div>
    </div>
    <div class="stat-card dash-stat fade-up" style="animation-delay:0.12s">
        <div class="stat-icon success"><i class="fas fa-circle-check"></i></div>
        <div class="stat-content"><div class="stat-label">Online</div><div class="stat-value" data-count-up="<%= servers.filter(function(s){return s.status==='running'}).length %>"><%= servers.filter(function(s){return s.status==='running'}).length %></div></div>
    </div>
    <div class="stat-card dash-stat fade-up" style="animation-delay:0.19s">
        <div class="stat-icon danger"><i class="fas fa-circle-xmark"></i></div>
        <div class="stat-content"><div class="stat-label">Offline</div><div class="stat-value" data-count-up="<%= servers.filter(function(s){return s.status==='stopped'}).length %>"><%= servers.filter(function(s){return s.status==='stopped'}).length %></div></div>
    </div>
    <div class="stat-card dash-stat fade-up" style="animation-delay:0.26s">
        <div class="stat-icon warning"><i class="fas fa-users"></i></div>
        <div class="stat-content"><div class="stat-label">Players</div><div class="stat-value" id="dbPlayersTotal" data-count-up="0">0</div></div>
    </div>
</div>

<% if (servers.length === 0) { %>
<div class="dash-empty">
    <i class="fas fa-server"></i>
    <h3>No Servers Yet</h3>
    <p>You don't have any servers assigned. Contact an administrator or create one to get started.</p>
    <% if (user.role === 'admin') { %><a href="/admin/servers/create" class="btn btn-primary btn-sheen"><i class="fas fa-plus"></i> Create Server</a><% } %>
</div>
<% } else { %>
<div class="server-grid dash-grid">
    <% servers.forEach(function(s, si) { %>
    <% var isOnline = (s.status === 'running'); %>
    <% var cpu = isOnline ? Math.min(100, Math.round(s.cpu_usage || 0)) : 0; %>
    <% var ram = isOnline ? (s.ram ? Math.min(100, Math.round(((s.ram_used || 0) / s.ram) * 100)) : 0) : 0; %>
    <% var disk = s.disk ? Math.min(100, Math.round(((s.disk_used || 0) / s.disk) * 100)) : 0; %>
    <div class="server-card dash-server fade-up" style="animation-delay:<%= (0.05 + si*0.06).toFixed(2) %>s" data-sid="<%= s.id %>">
        <div class="srv-top">
            <div class="srv-info">
                <div class="srv-icon <%= isOnline ? 'online' : '' %>"><i class="fas fa-cube"></i></div>
                <div class="srv-name-wrap">
                    <span class="srv-name"><%= s.name %></span>
                    <div class="srv-sub"><i class="fas fa-network-wired"></i> Port <%= s.port %> &bull; <i class="fas fa-memory"></i> <%= s.ram %> MB</div>
                </div>
            </div>
            <span class="dash-status <%= isOnline ? 'online' : 'offline' %>"><span class="led"></span><%= isOnline ? 'Online' : 'Offline' %></span>
        </div>
        <div class="dash-tags">
            <span class="dash-tag"><i class="fas fa-cube"></i> <%= s.server_type || 'vanilla' %></span>
            <span class="dash-tag"><i class="fas fa-tag"></i> <%= s.version || 'Latest' %></span>
            <% if (s.is_owner === 0) { %><span class="dash-tag"><i class="fas fa-user-plus"></i> Sub</span><% } %>
        </div>
        <div class="dash-bars">
            <div class="dash-bar">
                <div class="dash-bar-head"><span><i class="fas fa-microchip"></i> CPU</span><b><%= cpu %>%</b></div>
                <div class="dash-bar-track"><div class="dash-bar-fill cpu" style="width:<%= isOnline ? cpu + '%' : '0%' %>"></div></div>
            </div>
            <div class="dash-bar">
                <div class="dash-bar-head"><span><i class="fas fa-memory"></i> RAM</span><b><%= ram %>%</b></div>
                <div class="dash-bar-track"><div class="dash-bar-fill ram" style="width:<%= isOnline ? ram + '%' : '0%' %>"></div></div>
            </div>
            <div class="dash-bar">
                <div class="dash-bar-head"><span><i class="fas fa-hdd"></i> Disk</span><b><%= disk %>%</b></div>
                <div class="dash-bar-track"><div class="dash-bar-fill disk" style="width:<%= disk %>%"></div></div>
            </div>
        </div>
        <div class="dash-actions">
            <a href="/servers/<%= s.id %>/dashboard" class="btn btn-view"><i class="fas fa-sliders"></i> Manage</a>
            <button class="btn-icon ripple" onclick="dbAction('<%= s.id %>','start',this)" title="Start" <%= isOnline ? 'disabled' : '' %>><i class="fas fa-play" style="color:var(--success)"></i></button>
            <button class="btn-icon ripple" onclick="dbAction('<%= s.id %>','restart',this)" title="Restart" <%= !isOnline ? 'disabled' : '' %>><i class="fas fa-rotate" style="color:var(--warning)"></i></button>
            <button class="btn-icon ripple" onclick="dbAction('<%= s.id %>','stop',this)" title="Stop" <%= !isOnline ? 'disabled' : '' %>><i class="fas fa-stop" style="color:var(--danger)"></i></button>
        </div>
    </div>
    <% }); %>
</div>

<div class="bottom-grid dash-bottom">
    <div class="card dash-panel fade-up" style="animation-delay:0.25s">
        <div class="card-header"><h3><i class="fas fa-chart-simple"></i> Resources</h3></div>
        <div class="card-body">
            <div class="res-bar">
                <div class="res-head"><span><i class="fas fa-microchip"></i> CPU</span><span id="dbCpuAvg">--</span></div>
                <div class="res-track"><div class="res-fill cpu-bar" id="dbCpuBar" style="width:0%"></div></div>
            </div>
            <div class="res-bar">
                <div class="res-head"><span><i class="fas fa-memory"></i> RAM</span><span id="dbRamAvg">--</span></div>
                <div class="res-track"><div class="res-fill ram-bar" id="dbRamBar" style="width:0%"></div></div>
            </div>
            <div class="res-bar">
                <div class="res-head"><span><i class="fas fa-hdd"></i> Disk</span><span id="dbDiskAvg">--</span></div>
                <div class="res-track"><div class="res-fill disk-bar" id="dbDiskBar" style="width:0%"></div></div>
            </div>
        </div>
    </div>
    <div class="card dash-panel fade-up" style="animation-delay:0.33s">
        <div class="card-header"><h3><i class="fas fa-users"></i> Players</h3></div>
        <div class="card-body" id="dbPlayerList">
            <div style="text-align:center;padding:28px 0;color:var(--text-tertiary);font-size:13px"><i class="fas fa-user-slash" style="font-size:20px;display:block;margin-bottom:8px;opacity:.3"></i>No players online</div>
        </div>
    </div>
</div>
<% } %>

<% if (typeof showWelcome !== 'undefined' && showWelcome) { %>
<div class="modal-overlay active" id="welcomeModal" style="z-index:99999">
    <div class="modal-box" style="text-align:center;max-width:400px">
        <div style="width:56px;height:56px;margin:0 auto 18px;background:var(--accent-grad);border-radius:var(--r-lg);display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;box-shadow:var(--shadow-accent)"><i class="fas fa-hand-wave"></i></div>
        <h2 style="font-size:18px;font-weight:700;color:var(--text-primary);margin-bottom:8px">Welcome to <%= settings.panelName || 'DTG PANEL' %></h2>
        <p style="font-size:13px;color:var(--text-secondary);line-height:1.6;margin-bottom:24px">Your Minecraft server control center is ready. Manage servers, monitor performance, and keep your worlds running.</p>
        <button class="btn btn-primary btn-sheen" onclick="closeWelcomeModal()" style="width:auto;padding:10px 24px"><i class="fas fa-rocket"></i> Get Started</button>
    </div>
</div>
<% } %>

<% if (typeof splashType !== 'undefined' && splashType) { %>
<div class="splash-screen" id="splashScreen">
    <div class="splash-logo-wrap">
        <div class="splash-logo"><i class="fas fa-server"></i></div>
    </div>
    <div class="splash-title"><%= settings.panelName || 'DTG PANEL' %></div>
    <div class="splash-subtitle"><%= splashType === 'register' ? 'Account Created' : 'Welcome Back' %></div>
    <div class="splash-loader"><div class="splash-loader-bar"></div></div>
</div>
<% } %>

<script>
function initDbGreeting() {
    var el = document.getElementById('dbGreeting');
    if (!el) return;
    var h = new Date().getHours();
    var g = h < 5 ? 'Good night' : h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : h < 21 ? 'Good evening' : 'Good night';
    var name = '<%= (user.display_name||user.username).replace(/'/g,"\\'") %>';
    el.innerHTML = '<span class="greet-text">' + g + '</span><span class="greet-comma">,</span> <span class="greet-name greet-grad">' + name + '</span>';
}
function initDbGreetingWhenReady() {
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initDbGreeting); }
    else { initDbGreeting(); }
}
initDbGreetingWhenReady();
window.runWelcomeSplash = function () {
    var splash = document.getElementById('welcomeSplash');
    if (!splash || window.__welcomeRan) return;
    if (document.body && document.body.getAttribute('data-motion') === 'off') {
        if (splash.parentNode) splash.parentNode.removeChild(splash);
        window.__welcomeRan = true;
        return;
    }
    window.__welcomeRan = true;
    var legacy = document.getElementById('splashScreen');
    if (legacy && legacy.parentNode) legacy.parentNode.removeChild(legacy);
    var h = new Date().getHours();
    var greet = h < 5 ? 'Good night' : h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : h < 21 ? 'Good evening' : 'Good night';
    var name = '<%= (user.display_name||user.username).replace(/'/g,"\\'") %>';
    var t = splash.querySelector('#wlTitle');
    if (t) t.textContent = greet + ',';
    var n = splash.querySelector('#wlName');
    if (n) n.textContent = name;
    var over = splash.querySelector('#wlOverline');
    if (over) over.textContent = 'Welcome to ' + '<%= (settings.panelName||"DTG PANEL").replace(/'/g,"\\'") %>';
    setTimeout(function () {
        splash.classList.add('dismiss');
        setTimeout(function () { if (splash.parentNode) splash.parentNode.removeChild(splash); }, 760);
    }, 3400);
};
document.addEventListener('DOMContentLoaded',function(){
    var dt=document.getElementById('dbDate');if(dt)dt.textContent=new Date().toLocaleDateString('en-US',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
    document.querySelectorAll('.dash-bar-fill').forEach(function(b){var w=b.style.width;b.style.width='0%';setTimeout(function(){b.style.width=w},250)});
    document.querySelectorAll('.res-fill').forEach(function(b){var w=b.style.width;b.style.width='0%';setTimeout(function(){b.style.width=w},500)});

    var splash=document.getElementById('splashScreen');
    if(splash){
        setTimeout(function(){
            splash.classList.add('hide');
            setTimeout(function(){if(splash.parentElement)splash.remove()},600);
        },2800);
    }
});
function closeWelcomeModal(){var m=document.getElementById('welcomeModal');if(m){m.classList.remove('active');m.style.display='none'}}
function dbRefresh(){var ic=document.getElementById('dbSync');if(ic)ic.classList.add('fa-spin');showToast('Refreshing...','info');setTimeout(function(){location.reload()},500)}
function dbAction(id,action,btn){if(btn)btn.disabled=true;showToast(action.charAt(0).toUpperCase()+action.slice(1)+'ing server...','info');fetch('/servers/'+id+'/'+action,{method:'POST'}).then(function(r){return r.json()}).then(function(d){if(d.success){showToast('Server '+action+'ed','success');setTimeout(function(){location.reload()},1000)}else{showToast(d.error||'Failed','error');if(btn)btn.disabled=false}}).catch(function(){showToast('Request failed','error');if(btn)btn.disabled=false})}
</script>

<%- include('partials/footer') %>

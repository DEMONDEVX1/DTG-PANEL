<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-bell"></i>
            Notifications
            <% if (unreadCount > 0) { %>
                <span class="badge badge-info"><%= unreadCount %></span>
            <% } %>
        </h1>
        <p class="page-subtitle">Stay updated with your account and server activities</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-ghost" onclick="markAllAsRead()">
            <i class="fas fa-check-double"></i>
            Mark All Read
        </button>
        <button class="btn btn-ghost" onclick="clearAllNotifications()">
            <i class="fas fa-trash"></i>
            Clear All
        </button>
        <a href="/notifications/settings" class="btn btn-primary">
            <i class="fas fa-cog"></i>
            Settings
        </a>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon accent">
            <i class="fas fa-bell"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value"><%= stats.total %></div>
            <div class="stat-label">Total Notifications</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon warning">
            <i class="fas fa-bell"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value"><%= stats.unread %></div>
            <div class="stat-label">Unread</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success">
            <i class="fas fa-calendar-day"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value"><%= stats.today %></div>
            <div class="stat-label">Today</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon info">
            <i class="fas fa-calendar-week"></i>
        </div>
        <div class="stat-content">
            <div class="stat-value"><%= stats.thisWeek %></div>
            <div class="stat-label">This Week</div>
        </div>
    </div>
</div>

<div class="d-flex gap-3 align-center" style="margin-bottom:20px;flex-wrap:wrap;padding:16px;background:var(--bg-secondary);border:1px solid var(--border);border-radius:var(--r-md)">
    <div class="d-flex align-center gap-2">
        <span class="text-sm text-muted fw-600">Filter:</span>
        <select id="filterSelect" class="form-control" style="min-width:150px" onchange="applyFilters()">
            <option value="all" <%= currentFilter === 'all' ? 'selected' : '' %>>All Notifications</option>
            <option value="unread" <%= currentFilter === 'unread' ? 'selected' : '' %>>Unread Only</option>
            <option value="read" <%= currentFilter === 'read' ? 'selected' : '' %>>Read Only</option>
        </select>
    </div>

    <div class="d-flex align-center gap-2">
        <span class="text-sm text-muted fw-600">Category:</span>
        <select id="categorySelect" class="form-control" style="min-width:150px" onchange="applyFilters()">
            <option value="all" <%= currentCategory === 'all' ? 'selected' : '' %>>All Categories</option>
            <option value="system" <%= currentCategory === 'system' ? 'selected' : '' %>>System</option>
            <option value="account" <%= currentCategory === 'account' ? 'selected' : '' %>>Account</option>
            <option value="server" <%= currentCategory === 'server' ? 'selected' : '' %>>Server</option>
            <option value="security" <%= currentCategory === 'security' ? 'selected' : '' %>>Security</option>
            <option value="maintenance" <%= currentCategory === 'maintenance' ? 'selected' : '' %>>Maintenance</option>
        </select>
    </div>

    <button class="btn btn-ghost" onclick="refreshNotifications()">
        <i class="fas fa-sync-alt"></i>
        Refresh
    </button>
</div>

<div class="card">
    <div class="card-body" style="padding:0">
        <div id="notificationsList">
            <% if (notifications && notifications.length > 0) { %>
                <% notifications.forEach(notification => { %>
                    <div class="notification-item <%= notification.is_read ? '' : 'unread' %>"
                         data-id="<%= notification.id %>"
                         data-category="<%= notification.category %>"
                         data-type="<%= notification.type %>">

                        <div class="notification-icon">
                            <i class="fas fa-<%= notification.icon || getNotificationIcon(notification.type, notification.category) %>"></i>
                        </div>

                        <div class="notification-content">
                            <div class="d-flex justify-between align-center" style="margin-bottom:8px;gap:12px">
                                <div class="fw-600" style="color:var(--text-primary);font-size:15px"><%= notification.title %></div>
                                <div class="d-flex align-center gap-2 flex-shrink-0">
                                    <span class="badge badge-<%= getCategoryColor(notification.category) %>"><%= notification.category %></span>
                                    <span class="text-xs text-muted" style="white-space:nowrap" title="<%= new Date(notification.created_at).toLocaleString() %>">
                                        <%= formatTimeAgo(notification.created_at) %>
                                    </span>
                                </div>
                            </div>

                            <div class="text-sm text-muted" style="line-height:1.5;margin-bottom:12px">
                                <%= notification.message %>
                            </div>

                            <% if (notification.action_url && notification.action_text) { %>
                                <a href="<%= notification.action_url %>" class="btn btn-sm btn-primary"><%= notification.action_text %></a>
                            <% } %>
                        </div>

                        <div class="d-flex flex-column gap-2 flex-shrink-0">
                            <% if (!notification.is_read) { %>
                                <button class="btn btn-sm btn-ghost btn-icon" onclick="markAsRead('<%= notification.id %>')" title="Mark as read">
                                    <i class="fas fa-check"></i>
                                </button>
                            <% } %>
                            <button class="btn btn-sm btn-ghost btn-icon" onclick="deleteNotification('<%= notification.id %>')" title="Delete">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="text-center" style="padding:60px 20px">
                    <div style="font-size:64px;margin-bottom:20px;opacity:0.5">
                        <i class="fas fa-bell-slash"></i>
                    </div>
                    <div class="fw-600" style="color:var(--text-secondary);margin-bottom:8px">No notifications found</div>
                    <div class="text-sm text-muted">You're all caught up! New notifications will appear here.</div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<% if (pagination && pagination.pages > 1) { %>
    <div style="margin-top:24px;padding-top:20px;border-top:1px solid var(--border)">
        <nav class="pagination">
            <% if (pagination.hasPrev) { %>
                <a href="?page=<%= pagination.page - 1 %>&filter=<%= currentFilter %>&category=<%= currentCategory %>"
                   class="page-link">
                    <i class="fas fa-chevron-left"></i>
                    Previous
                </a>
            <% } else { %>
                <span></span>
            <% } %>

            <span class="text-sm text-muted">
                Page <%= pagination.page %> of <%= pagination.pages %>
                (<%= pagination.total %> total)
            </span>

            <% if (pagination.hasNext) { %>
                <a href="?page=<%= pagination.page + 1 %>&filter=<%= currentFilter %>&category=<%= currentCategory %>"
                   class="page-link">
                    Next
                    <i class="fas fa-chevron-right"></i>
                </a>
            <% } else { %>
                <span></span>
            <% } %>
        </nav>
    </div>
<% } %>

<% if (stats.categories && stats.categories.length > 0) { %>
    <div class="grid-2" style="margin-top:24px">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-chart-pie"></i> Notifications by Category</h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    <% stats.categories.forEach(category => { %>
                        <div>
                            <div class="d-flex justify-between align-center mb-1">
                                <span class="d-flex align-center gap-2 text-sm fw-500" style="text-transform:capitalize">
                                    <i class="fas fa-<%= getCategoryIcon(category.category) %>"></i>
                                    <%= category.category %>
                                </span>
                                <span class="text-sm fw-600 text-muted"><%= category.count %></span>
                            </div>
                            <div style="height:6px;background:var(--bg-tertiary);border-radius:3px;overflow:hidden">
                                <div style="height:100%;width:<%= (category.count / stats.total * 100) %>%;background:var(--<%= getCategoryColor(category.category) %>);border-radius:3px;transition:width 0.3s"></div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-chart-bar"></i> Notifications by Type</h3>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-3">
                    <% stats.types.forEach(type => { %>
                        <div>
                            <div class="d-flex justify-between align-center mb-1">
                                <span class="d-flex align-center gap-2 text-sm fw-500" style="text-transform:capitalize">
                                    <i class="fas fa-<%= getTypeIcon(type.type) %>"></i>
                                    <%= type.type %>
                                </span>
                                <span class="text-sm fw-600 text-muted"><%= type.count %></span>
                            </div>
                            <div style="height:6px;background:var(--bg-tertiary);border-radius:3px;overflow:hidden">
                                <div style="height:100%;width:<%= (type.count / stats.total * 100) %>%;background:var(--<%= getTypeColor(type.type) %>);border-radius:3px;transition:width 0.3s"></div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
<% } %>

<%
function getNotificationIcon(type, category) {
    var icons = { success: 'check-circle', error: 'exclamation-circle', warning: 'exclamation-triangle', info: 'info-circle', system: 'cog' };
    var categoryIcons = { system: 'cog', account: 'user', server: 'server', security: 'shield-alt', maintenance: 'tools' };
    return categoryIcons[category] || icons[type] || 'bell';
}

function getCategoryColor(category) {
    var colors = { system: 'info', account: 'info', server: 'success', security: 'warning', maintenance: 'warning', general: 'info' };
    return colors[category] || 'info';
}

function getCategoryIcon(category) {
    var icons = { system: 'cog', account: 'user', server: 'server', security: 'shield-alt', maintenance: 'tools', general: 'bell' };
    return icons[category] || 'bell';
}

function getTypeIcon(type) {
    var icons = { success: 'check-circle', error: 'exclamation-circle', warning: 'exclamation-triangle', info: 'info-circle', system: 'cog' };
    return icons[type] || 'bell';
}

function getTypeColor(type) {
    var colors = { success: 'success', error: 'danger', warning: 'warning', info: 'info', system: 'info' };
    return colors[type] || 'info';
}

function formatTimeAgo(dateString) {
    var date = new Date(dateString);
    var now = new Date();
    var diff = now - date;
    if (diff < 60000) return 'Just now';
    if (diff < 3600000) return Math.floor(diff / 60000) + 'm ago';
    if (diff < 86400000) return Math.floor(diff / 3600000) + 'h ago';
    if (diff < 604800000) return Math.floor(diff / 86400000) + 'd ago';
    return date.toLocaleDateString();
}
%>

<%- include('./notification-styles') %>
<%- include('./notification-scripts') %>

<%- include('../partials/footer') %>

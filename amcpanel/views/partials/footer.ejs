        </main>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>
<div id="loadingOverlay" aria-hidden="true">
    <div class="loader-scanlines" aria-hidden="true"></div>
    <div class="loader-scene">
        <div class="loader-aurora" aria-hidden="true"></div>
        <div class="loader-particles" id="loaderParticles" aria-hidden="true"></div>
        <div class="loader-core" aria-hidden="true">
            <div class="loader-ring ring-a"></div>
            <div class="loader-ring ring-b"></div>
            <div class="loader-ring ring-c"></div>
            <div class="loader-logo"><i class="fas fa-shield-halved"></i></div>
        </div>
        <div class="loader-title"><%= settings.panelName || 'DTG PANEL' %></div>
        <div class="loader-status"><span id="loadingText">Initializing...</span></div>
        <div class="loader-bar" id="loadingProgressBar"><div id="loadingBarFill"></div></div>
    </div>
</div>

<script>
var _loadingInterval = null;
var _bootInterval = null;
function buildLoaderParticles() {
    var c = document.getElementById('loaderParticles');
    if (!c || c.children.length) return;
    for (var i = 0; i < 16; i++) {
        var p = document.createElement('span');
        p.className = 'loader-particle';
        var size = (Math.random() * 4 + 3).toFixed(1);
        p.style.width = p.style.height = size + 'px';
        p.style.left = (Math.random() * 100).toFixed(1) + '%';
        p.style.bottom = '-12px';
        p.style.animationDuration = (Math.random() * 4 + 5).toFixed(2) + 's';
        p.style.animationDelay = (Math.random() * 5).toFixed(2) + 's';
        p.style.opacity = (Math.random() * 0.5 + 0.2).toFixed(2);
        c.appendChild(p);
    }
}
function showLoading(msg, useProgress) {
    var o = document.getElementById('loadingOverlay');
    var t = document.getElementById('loadingText');
    var pb = document.getElementById('loadingProgressBar');
    var bf = document.getElementById('loadingBarFill');
    clearInterval(_bootInterval);
    o.classList.remove('done');
    o.style.display = 'flex';
    t.textContent = msg || 'Processing...';
    if (useProgress) {
        pb.style.display = 'block';
        bf.style.width = '0%';
        var p = 0;
        clearInterval(_loadingInterval);
        _loadingInterval = setInterval(function() {
            p = Math.min(p + Math.random() * 12 + 2, 90);
            bf.style.width = p + '%';
        }, 300);
    } else {
        pb.style.display = 'none';
    }
}
function hideLoading() {
    var o = document.getElementById('loadingOverlay');
    var bf = document.getElementById('loadingBarFill');
    var pb = document.getElementById('loadingProgressBar');
    clearInterval(_loadingInterval);
    clearInterval(_bootInterval);
    if (bf) bf.style.width = '100%';
    setTimeout(function() {
        o.classList.add('done');
        setTimeout(function() {
            o.style.display = 'none';
            o.classList.remove('done');
            if (pb) pb.style.display = 'none';
            if (bf) bf.style.width = '0%';
        }, 550);
    }, 300);
}
function showBootSplash() {
    var o = document.getElementById('loadingOverlay');
    if (!o) return;
    buildLoaderParticles();
    var t = document.getElementById('loadingText');
    var bf = document.getElementById('loadingBarFill');
    var pb = document.getElementById('loadingProgressBar');
    var stages = ['Initializing', 'Loading modules', 'Connecting to daemon', 'Starting services', 'Almost ready'];
    o.style.display = 'flex';
    o.classList.add('boot');
    pb.style.display = 'block';
    bf.style.width = '0%';
    var p = 0, si = 0;
    _bootInterval = setInterval(function() {
        p = Math.min(p + Math.random() * 17 + 5, 100);
        bf.style.width = p + '%';
        if (p > si * 22 && si < stages.length) {
            t.textContent = stages[si];
            si++;
        }
        if (p >= 100) {
            clearInterval(_bootInterval);
            setTimeout(function() {
                o.classList.add('done');
                setTimeout(function() {
                    o.style.display = 'none';
                    o.classList.remove('boot', 'done');
                    pb.style.display = 'none';
                    bf.style.width = '0%';
                }, 550);
            }, 250);
        }
    }, 110);
}
function reanimatePage() {
    var pw = document.querySelector('.page-wrap');
    if (!pw) return;
    pw.style.animation = 'none';
    void pw.offsetWidth;
    pw.style.animation = '';
}
document.addEventListener('click',function(e){var t=document.getElementById('userMenuTrigger'),d=document.getElementById('userDropdown');if(!d)return;if(t&&t.contains(e.target)){d.classList.toggle('show')}else if(!d.contains(e.target)){d.classList.remove('show')}});
document.addEventListener('keydown',function(e){if(e.key==='Escape'){var d=document.getElementById('userDropdown');if(d)d.classList.remove('show')}});
document.querySelectorAll('.alert').forEach(function(a){setTimeout(function(){a.style.opacity='0';a.style.transform='translateY(-8px)';a.style.transition='all 0.3s';setTimeout(function(){if(a.parentElement)a.remove()},300)},5000)});
function showToast(msg,type){type=type||'info';var c=document.getElementById('toastContainer');var icons={success:'check-circle',error:'exclamation-circle',info:'info-circle',warning:'exclamation-triangle'};var el=document.createElement('div');el.className='toast '+type;var safeMsg=String(msg).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');el.innerHTML='<div class="toast-icon"><i class="fas fa-'+ (icons[type]||'info-circle') +'"></i></div><div class="toast-body">'+safeMsg+'</div><button class="toast-close" onclick="this.parentElement.remove()">&times;</button>';c.appendChild(el);setTimeout(function(){el.classList.add('removing');setTimeout(function(){if(el.parentElement)el.remove()},250)},4000)}
document.addEventListener('keydown',function(e){if((e.ctrlKey||e.metaKey)&&e.key==='k'){e.preventDefault();var s=document.getElementById('globalSearch');if(s)s.focus()}});

document.addEventListener('DOMContentLoaded',function(){
    var welcomeSplash = document.getElementById('welcomeSplash');
    var hasDedicatedSplash = document.getElementById('splashScreen');
    if (welcomeSplash && typeof window.runWelcomeSplash === 'function') {
        window.runWelcomeSplash();
    } else if (!hasDedicatedSplash) {
        showBootSplash();
    } else {
        buildLoaderParticles();
    }
});

(function(){
    var pageWrap = document.querySelector('.page-wrap');
    if (!pageWrap) return;

    function activateLink(url) {
        document.querySelectorAll('.sidebar .nav-item').forEach(function(a){
            a.classList.remove('active');
            if (a.getAttribute('href') && url.indexOf(a.getAttribute('href')) === 0 && a.getAttribute('href') !== '/dashboard' && a.getAttribute('href') !== '/') {
                a.classList.add('active');
            }
        });
    }

    function runScripts(container) {
        var scripts = container.querySelectorAll('script');
        scripts.forEach(function(old){
            var s = document.createElement('script');
            if (old.src) { s.src = old.src; }
            else { s.textContent = old.textContent; }
            old.parentNode.replaceChild(s, old);
        });
    }

    function navigateTo(url, pushState) {
        if (pushState === undefined) pushState = true;
        if (url.indexOf('/auth/') === 0 || url.indexOf('/admin/') === 0 || url.indexOf('/profile') === 0 || url.indexOf('/notifications') === 0 || url.indexOf('/dashboard') === 0) {
            window.location.href = url;
            return;
        }
        fetch(url, { headers: { 'X-Requested-With': 'spa' } })
        .then(function(r) { return r.text(); })
        .then(function(html) {
            // ── Run any registered page cleanup functions before replacing content ──
            if (window._pageCleanups && window._pageCleanups.length) {
                window._pageCleanups.forEach(function(fn) { try { fn(); } catch(e) {} });
                window._pageCleanups = [];
            }
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var newPageWrap = doc.querySelector('.page-wrap');
            var newSidebar = doc.querySelector('.sidebar');
            if (!newPageWrap) { window.location.href = url; return; }
            pageWrap.innerHTML = newPageWrap.innerHTML;
            if (newSidebar) {
                var currentSidebar = document.querySelector('.sidebar');
                if (currentSidebar) {
                    var currentNav = currentSidebar.querySelector('.sidebar-nav');
                    var newNav = newSidebar.querySelector('.sidebar-nav');
                    if (currentNav && newNav) currentNav.innerHTML = newNav.innerHTML;
                }
            }
            var newTitle = doc.querySelector('title');
            if (newTitle) document.title = newTitle.textContent;
            if (pushState) history.pushState({}, '', url);
            activateLink(url);
            runScripts(pageWrap);
            pageWrap.querySelectorAll('.alert').forEach(function(a){
                setTimeout(function(){a.style.opacity='0';a.style.transform='translateY(-8px)';a.style.transition='all 0.3s';setTimeout(function(){if(a.parentElement)a.remove()},300)},5000);
            });
            reanimatePage();
            window.scrollTo(0, 0);
        })
        .catch(function(){ window.location.href = url; });
    }

    document.addEventListener('click', function(e) {
        var link = e.target.closest('.sidebar .nav-item[href]');
        if (!link) return;
        var href = link.getAttribute('href');
        if (!href || href.indexOf('/auth/') === 0) return;
        if (e.ctrlKey || e.metaKey || e.shiftKey) return;
        e.preventDefault();
        navigateTo(href);
    });

    window.addEventListener('popstate', function() {
        navigateTo(location.pathname, false);
    });
})();

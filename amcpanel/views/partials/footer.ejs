</script>

<!-- ═══════════════════════════════════════════════════════════
     GLOBAL CONFIRM MODAL — replaces browser confirm() on every page
     ═══════════════════════════════════════════════════════════ -->
<style>
#amcConfirmOverlay {
    position: fixed; inset: 0; z-index: 99998;
    background: rgba(0,0,0,0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity .22s cubic-bezier(.4,0,.2,1);
}
#amcConfirmOverlay.open { opacity: 1; pointer-events: all; }
#amcConfirmBox {
    background: var(--bg-secondary, #1a1a2e);
    border: 1px solid var(--border, rgba(255,255,255,.1));
    border-radius: 18px;
    padding: 0;
    width: 100%; max-width: 440px;
    box-shadow: 0 32px 80px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.04);
    transform: scale(.92) translateY(18px);
    transition: transform .25s cubic-bezier(.34,1.56,.64,1), opacity .22s;
    opacity: 0;
    overflow: hidden;
}
#amcConfirmOverlay.open #amcConfirmBox { transform: scale(1) translateY(0); opacity: 1; }
#amcConfirmIconWrap {
    display: flex; align-items: center; justify-content: center;
    padding: 28px 28px 0;
}
#amcConfirmIconCircle {
    width: 56px; height: 56px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
    background: rgba(239,68,68,.15);
    border: 2px solid rgba(239,68,68,.35);
    color: #ef4444;
    animation: amcPulse 2s infinite;
}
@keyframes amcPulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,.3); }
    50%      { box-shadow: 0 0 0 10px rgba(239,68,68,0); }
}
#amcConfirmIconCircle.warn { background:rgba(245,158,11,.15); border-color:rgba(245,158,11,.35); color:#f59e0b; animation: amcPulseWarn 2s infinite; }
@keyframes amcPulseWarn {
    0%,100% { box-shadow: 0 0 0 0 rgba(245,158,11,.3); }
    50%      { box-shadow: 0 0 0 10px rgba(245,158,11,0); }
}
#amcConfirmBody { padding: 20px 28px 8px; text-align: center; }
#amcConfirmTitle { font-size: 18px; font-weight: 700; color: var(--text-primary,#fff); margin-bottom: 10px; line-height: 1.3; }
#amcConfirmMsg { font-size: 14px; color: var(--text-secondary,#aaa); line-height: 1.6; }
#amcConfirmDivider { height: 1px; background: var(--border,rgba(255,255,255,.08)); margin: 20px 0 0; }
#amcConfirmFooter {
    display: flex; gap: 0; padding: 0;
}
#amcConfirmFooter button {
    flex: 1; padding: 15px 18px; font-size: 14px; font-weight: 600;
    border: none; cursor: pointer; transition: background .15s, color .15s;
    font-family: inherit; letter-spacing: .01em;
}
#amcConfirmCancel {
    background: transparent; color: var(--text-secondary,#aaa);
    border-right: 1px solid var(--border,rgba(255,255,255,.08)) !important;
    border-radius: 0 0 0 18px;
}
#amcConfirmCancel:hover { background: rgba(255,255,255,.05); color: var(--text-primary,#fff); }
#amcConfirmOk {
    background: linear-gradient(135deg,#ef4444,#dc2626);
    color: #fff; border-radius: 0 0 18px 0;
}
#amcConfirmOk:hover { background: linear-gradient(135deg,#f87171,#ef4444); }
#amcConfirmOk.warn-btn { background: linear-gradient(135deg,#f59e0b,#d97706); }
#amcConfirmOk.warn-btn:hover { background: linear-gradient(135deg,#fbbf24,#f59e0b); }
</style>

<div id="amcConfirmOverlay">
    <div id="amcConfirmBox" role="dialog" aria-modal="true" aria-labelledby="amcConfirmTitle">
        <div id="amcConfirmIconWrap">
            <div id="amcConfirmIconCircle"><i id="amcConfirmIcon" class="fas fa-trash-alt"></i></div>
        </div>
        <div id="amcConfirmBody">
            <div id="amcConfirmTitle">Are you sure?</div>
            <div id="amcConfirmMsg">This action cannot be undone.</div>
        </div>
        <div id="amcConfirmDivider"></div>
        <div id="amcConfirmFooter">
            <button id="amcConfirmCancel"><i class="fas fa-times"></i> Cancel</button>
            <button id="amcConfirmOk"><i class="fas fa-check"></i> Confirm</button>
        </div>
    </div>
</div>

<script>
(function() {
    // ── Determine icon + style from message keywords ────────────────────────
    function getConfirmStyle(msg) {
        var m = (msg || '').toLowerCase();
        if (m.includes('delete') || m.includes('remove') || m.includes('irreversible') || m.includes('permanently'))
            return { icon: 'fa-trash-alt', circle: '', btn: '', title: 'Delete Confirmation' };
        if (m.includes('reinstall') || m.includes('reset') || m.includes('cannot be undone') || m.includes('uninstall'))
            return { icon: 'fa-exclamation-triangle', circle: 'warn', btn: 'warn-btn', title: 'Warning' };
        if (m.includes('restore') || m.includes('replace'))
            return { icon: 'fa-history', circle: 'warn', btn: 'warn-btn', title: 'Restore Confirmation' };
        if (m.includes('disable') || m.includes('ban'))
            return { icon: 'fa-ban', circle: '', btn: '', title: 'Confirm Action' };
        return { icon: 'fa-question-circle', circle: 'warn', btn: 'warn-btn', title: 'Confirm' };
    }

    // ── Core modal renderer ─────────────────────────────────────────────────
    var _resolve = null;
    var overlay  = document.getElementById('amcConfirmOverlay');
    var box      = document.getElementById('amcConfirmBox');

    function showConfirm(msg, okLabel, cancelLabel) {
        return new Promise(function(resolve) {
            _resolve = resolve;
            var style = getConfirmStyle(msg);

            document.getElementById('amcConfirmIcon').className    = 'fas ' + style.icon;
            document.getElementById('amcConfirmIconCircle').className = style.circle ? 'warn' : '';
            document.getElementById('amcConfirmTitle').textContent  = style.title;
            document.getElementById('amcConfirmMsg').innerHTML      = msg;
            document.getElementById('amcConfirmOk').className       = style.btn ? 'warn-btn' : '';
            document.getElementById('amcConfirmOk').innerHTML       = '<i class="fas fa-check"></i> ' + (okLabel || 'Confirm');
            document.getElementById('amcConfirmCancel').innerHTML   = '<i class="fas fa-times"></i> ' + (cancelLabel || 'Cancel');

            overlay.classList.add('open');
            document.body.style.overflow = 'hidden';
            setTimeout(function(){ document.getElementById('amcConfirmOk').focus(); }, 50);
        });
    }

    function closeConfirm(result) {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
        if (_resolve) { _resolve(result); _resolve = null; }
    }

    document.getElementById('amcConfirmOk').addEventListener('click', function() { closeConfirm(true); });
    document.getElementById('amcConfirmCancel').addEventListener('click', function() { closeConfirm(false); });
    overlay.addEventListener('click', function(e) { if (e.target === overlay) closeConfirm(false); });
    document.addEventListener('keydown', function(e) {
        if (!overlay.classList.contains('open')) return;
        if (e.key === 'Escape') closeConfirm(false);
        if (e.key === 'Enter') closeConfirm(true);
    });

    // ── Override window.confirm globally ────────────────────────────────────
    // Sync confirm() is replaced with async version. All callers that do:
    //   if (!confirm('...')) return;
    // are auto-patched by wrapping each call site to use the async modal.
    // We DO NOT literally override window.confirm (it's synchronous by spec),
    // instead we expose window.amc_confirm() and patch callers via a MutationObserver
    // trick — but the cleanest approach: override window.confirm to return true
    // instantly for backward-compat, and expose window.amc_confirm for new code.
    //
    // For the existing pages that use the sync pattern we use a smarter approach:
    // override window.confirm to SCHEDULE a modal and throw to stop execution,
    // then re-run the queued action after OK. But this is complex and fragile.
    //
    // BEST approach for a panel: replace window.confirm with async shim that
    // uses a callback queue. All existing "if (!confirm(...)) return" patterns
    // become "confirmModal(...).then(ok => { if (!ok) return; ... })"
    // We do this transparently below by making confirm() return a thenable:

    window._amcConfirmQueue = [];
    window.amc_confirm = showConfirm;
    window.showConfirm = showConfirm;
    window.confirmModal = showConfirm;

    // Polyfill: replace window.confirm with our modal
    // Since confirm() is sync, we can't make it truly async.
    // Instead: store the pending action and show modal; block via exception trick.
    // The cleanest real-world solution: replace existing onclick handlers.
    // We patch ALL onclick handlers on DOMContentLoaded:

    function patchConfirmCalls() {
        // Find all elements with onclick attributes containing confirm(
        // Skip elements already patched (marked with data-amc-patched)
        var allEls = document.querySelectorAll('[onclick]:not([data-amc-patched])');
        allEls.forEach(function(el) {
            var orig = el.getAttribute('onclick');
            if (!orig || orig.indexOf('confirm(') === -1) return;
            // Mark as patched so we don't re-process on next mutation
            el.setAttribute('data-amc-patched', '1');
            // Replace inline onclick with async version
            el.removeAttribute('onclick');
            el.__amcOrigOnclick = orig;
            el.addEventListener('click', function(e) {
                e.preventDefault(); e.stopImmediatePropagation();
                // Extract confirm message
                var msgMatch = orig.match(/confirm\(['"`]([\s\S]*?)['"`]\)/);
                var msg = msgMatch ? msgMatch[1] : 'Are you sure?';
                showConfirm(msg).then(function(ok) {
                    if (!ok) return;
                    // Run original code with confirm() always returning true
                    var patchedCode = orig.replace(/confirm\(['"`][\s\S]*?['"`]\)\s*(?:===?\s*(?:true|false)\s*)?/g, 'true');
                    patchedCode = patchedCode.replace(/!\s*true/g, 'false');
                    try { (new Function('event', patchedCode))(e); } catch(err) { console.warn('[AMC Confirm]', err); }
                });
            });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', patchConfirmCalls);
    } else {
        patchConfirmCalls();
    }
    // Patch after dynamic content — but only watch for added NODES, not text changes
    // This avoids re-triggering on every stats textContent update
    var _patchTimer;
    var _obs = new MutationObserver(function(mutations) {
        // Only act if actual element nodes were added (not just text changes)
        var hasNewNodes = mutations.some(function(m) {
            return Array.from(m.addedNodes).some(function(n) { return n.nodeType === 1; }); // ELEMENT_NODE
        });
        if (!hasNewNodes) return;
        clearTimeout(_patchTimer);
        _patchTimer = setTimeout(patchConfirmCalls, 300);
    });
    _obs.observe(document.body, { childList: true, subtree: true });
})();
</script>
</body>

<%- include('partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">
            <i class="fas fa-user-cog"></i>
            Profile Settings
        </h1>
        <p class="page-subtitle">Manage your account settings and preferences</p>
    </div>
</div>

<div class="d-flex gap-4" style="align-items: flex-start;">
    <div style="flex:1;min-width:0">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-user"></i> Profile Information</h3>
            </div>
            <div class="card-body">
                <form id="profileForm">
                    <div class="form-group">
                        <label class="form-label" for="username">Username</label>
                        <input type="text" id="username" class="form-control" value="<%= user.username %>" disabled>
                        <div class="form-hint">Username cannot be changed</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="display_name">Display Name</label>
                        <input type="text" id="display_name" name="display_name" class="form-control"
                               value="<%= user.display_name || user.username %>"
                               placeholder="Enter your display name">
                        <div class="form-hint">This name will be shown in the interface</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="email">Email Address</label>
                        <input type="email" id="email" name="email" class="form-control"
                               value="<%= user.email %>" required>
                        <div class="form-hint">Used for notifications and account recovery</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="role">Role</label>
                        <input type="text" id="role" class="form-control" value="<%= user.role %>" disabled>
                        <div class="form-hint">Your account role and permissions</div>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-lock"></i> Change Password</h3>
            </div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label" for="current_password">Current Password</label>
                    <input type="password" id="current_password" name="current_password" class="form-control">
                    <div class="form-hint">Required to change password</div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="new_password">New Password</label>
                    <input type="password" id="new_password" name="new_password" class="form-control">
                    <div class="form-hint">Leave blank to keep current password</div>
                </div>

                <div class="form-group">
                    <label class="form-label" for="confirm_password">Confirm New Password</label>
                    <input type="password" id="confirm_password" class="form-control">
                    <div class="form-hint">Must match new password</div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i>
                        Save Changes
                    </button>
                    <button type="button" class="btn btn-ghost" onclick="resetForm()">
                        <i class="fas fa-undo"></i>
                        Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="flex-shrink-0" style="width:360px">
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-palette"></i> Theme & Appearance</h3>
            </div>
            <div class="card-body">
                <form id="themeForm">
                    <div class="form-group">
                        <label class="form-label" for="theme_preference">Theme Mode</label>
                        <select id="theme_preference" name="theme_preference" class="form-control">
                            <option value="dark" <%= user.theme_preference === 'dark' ? 'selected' : '' %>>Dark Mode</option>
                            <option value="light" <%= user.theme_preference === 'light' ? 'selected' : '' %>>Light Mode</option>
                            <option value="auto" <%= user.theme_preference === 'auto' ? 'selected' : '' %>>Auto (System)</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="theme_primary_color">Primary Color</label>
                        <div class="d-flex align-center gap-2">
                            <input type="color" id="theme_primary_color" name="theme_primary_color"
                                   class="form-control" style="width:60px;height:40px;padding:2px"
                                   value="<%= user.theme_primary_color || '#6366f1' %>">
                            <div class="rounded border" style="width:40px;height:40px;background:<%= user.theme_primary_color || '#6366f1' %>" id="primaryColorPreview"></div>
                        </div>
                        <div class="form-hint">Main accent color for buttons and highlights</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="theme_accent_color">Accent Color</label>
                        <div class="d-flex align-center gap-2">
                            <input type="color" id="theme_accent_color" name="theme_accent_color"
                                   class="form-control" style="width:60px;height:40px;padding:2px"
                                   value="<%= user.theme_accent_color || '#818cf8' %>">
                            <div class="rounded border" style="width:40px;height:40px;background:<%= user.theme_accent_color || '#818cf8' %>" id="accentColorPreview"></div>
                        </div>
                        <div class="form-hint">Secondary color for hover effects</div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Quick Presets</label>
                        <div class="grid-3" style="gap:8px;margin-top:8px">
                            <div class="preset-item d-flex rounded border" style="cursor:pointer;height:36px;overflow:hidden" data-primary="#6366f1" data-accent="#818cf8" title="Indigo">
                                <div style="flex:1;background:#6366f1"></div>
                                <div style="flex:1;background:#818cf8"></div>
                            </div>
                            <div class="preset-item d-flex rounded border" style="cursor:pointer;height:36px;overflow:hidden" data-primary="#22c55e" data-accent="#4ade80" title="Emerald">
                                <div style="flex:1;background:#22c55e"></div>
                                <div style="flex:1;background:#4ade80"></div>
                            </div>
                            <div class="preset-item d-flex rounded border" style="cursor:pointer;height:36px;overflow:hidden" data-primary="#3b82f6" data-accent="#60a5fa" title="Blue">
                                <div style="flex:1;background:#3b82f6"></div>
                                <div style="flex:1;background:#60a5fa"></div>
                            </div>
                            <div class="preset-item d-flex rounded border" style="cursor:pointer;height:36px;overflow:hidden" data-primary="#f59e0b" data-accent="#fbbf24" title="Amber">
                                <div style="flex:1;background:#f59e0b"></div>
                                <div style="flex:1;background:#fbbf24"></div>
                            </div>
                            <div class="preset-item d-flex rounded border" style="cursor:pointer;height:36px;overflow:hidden" data-primary="#ef4444" data-accent="#f87171" title="Red">
                                <div style="flex:1;background:#ef4444"></div>
                                <div style="flex:1;background:#f87171"></div>
                            </div>
                            <div class="preset-item d-flex rounded border" style="cursor:pointer;height:36px;overflow:hidden" data-primary="#8b5cf6" data-accent="#a78bfa" title="Violet">
                                <div style="flex:1;background:#8b5cf6"></div>
                                <div style="flex:1;background:#a78bfa"></div>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <button type="button" class="btn btn-primary btn-sm" onclick="applyTheme()">
                            <i class="fas fa-eye"></i>
                            Preview
                        </button>
                        <button type="button" class="btn btn-ghost btn-sm" onclick="resetTheme()">
                            <i class="fas fa-undo"></i>
                            Reset
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-camera"></i> Profile Picture</h3>
            </div>
            <div class="card-body text-center">
                <div class="d-flex flex-column align-center gap-3">
                    <div class="rounded" style="width:120px;height:120px;border:4px solid var(--border);overflow:hidden;display:flex;align-items:center;justify-content:center">
                        <% if (user.profile_picture) { %>
                            <img src="<%= user.profile_picture %>" alt="Profile Picture" id="profilePicture" style="width:100%;height:100%;object-fit:cover">
                        <% } else { %>
                            <div id="profilePicture" style="width:100%;height:100%;background:var(--bg-tertiary);display:flex;align-items:center;justify-content:center;font-size:48px;color:var(--text-tertiary)">
                                <i class="fas fa-user"></i>
                            </div>
                        <% } %>
                    </div>
                    <button class="btn btn-primary btn-sm" onclick="uploadProfilePicture()">
                        <i class="fas fa-upload"></i>
                        Upload Picture
                    </button>
                    <div class="form-hint text-center">Recommended: 200x200px, max 2MB</div>
                </div>
                <input type="file" id="profilePictureInput" accept="image/*" style="display:none">
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-info-circle"></i> Account Information</h3>
            </div>
            <div class="card-body">
                <div class="list-group">
                    <div class="list-group-item d-flex justify-between align-center">
                        <span class="text-sm text-muted">Member Since</span>
                        <span class="text-sm fw-600"><%= new Date(user.created_at).toLocaleDateString() %></span>
                    </div>
                    <div class="list-group-item d-flex justify-between align-center">
                        <span class="text-sm text-muted">Last Updated</span>
                        <span class="text-sm fw-600"><%= user.updated_at ? new Date(user.updated_at).toLocaleDateString() : 'Never' %></span>
                    </div>
                    <div class="list-group-item d-flex justify-between align-center">
                        <span class="text-sm text-muted">Account Status</span>
                        <span class="badge badge-<%= user.status === 'active' ? 'success' : 'danger' %>"><%= user.status %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.preset-item { transition: border-color 0.2s, transform 0.2s; }
.preset-item:hover { border-color: var(--accent) !important; transform: scale(1.05); }
.list-group-item { border-bottom: 1px solid var(--border); }
.list-group-item:last-child { border-bottom: none; }
.form-actions { display: flex; gap: 12px; margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); }
input[type="color"].form-control { cursor: pointer; }
</style>

<script>
var profileForm = document.getElementById('profileForm');
if (profileForm) profileForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    var formData = new FormData(this);
    var data = Object.fromEntries(formData);
    if (data.new_password && data.new_password !== document.getElementById('confirm_password').value) {
        showToast('New passwords do not match', 'error');
        return;
    }
    try {
        var response = await fetch('/profile/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        var result = await response.json();
        if (result.success) {
            showToast('Profile updated successfully!', 'success');
            document.getElementById('current_password').value = '';
            document.getElementById('new_password').value = '';
            document.getElementById('confirm_password').value = '';
        } else {
            showToast(result.error || 'Failed to update profile', 'error');
        }
    } catch (error) {
        console.error('Profile update error:', error);
        showToast('An error occurred while updating profile', 'error');
    }
});

function updateColorPreviews() {
    document.getElementById('primaryColorPreview').style.background = document.getElementById('theme_primary_color').value;
    document.getElementById('accentColorPreview').style.background = document.getElementById('theme_accent_color').value;
}

function applyTheme() {
    var primary = document.getElementById('theme_primary_color').value;
    var accent = document.getElementById('theme_accent_color').value;
    var mode = document.getElementById('theme_preference').value;
    var html = document.documentElement;
    if (mode === 'light') html.setAttribute('data-theme', 'light');
    else if (mode === 'dark') html.setAttribute('data-theme', 'dark');
    else if (mode === 'auto') {
        html.setAttribute('data-theme', window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    }
    document.documentElement.style.setProperty('--accent', primary);
    document.documentElement.style.setProperty('--accent-hover', accent);
    showToast('Theme preview applied! Save your profile to make it permanent.', 'info');
}

function resetTheme() {
    document.getElementById('theme_primary_color').value = <%- JSON.stringify(user.theme_primary_color || "#6366f1") %>;
    document.getElementById('theme_accent_color').value = <%- JSON.stringify(user.theme_accent_color || "#818cf8") %>;
    document.getElementById('theme_preference').value = <%- JSON.stringify(user.theme_preference || "dark") %>;
    updateColorPreviews();
}

function resetForm() {
    document.getElementById('profileForm').reset();
    document.getElementById('display_name').value = '<%= user.display_name || user.username %>';
    document.getElementById('email').value = '<%= user.email %>';
}

document.querySelectorAll('.preset-item').forEach(function(item) {
    item.addEventListener('click', function() {
        document.getElementById('theme_primary_color').value = this.dataset.primary;
        document.getElementById('theme_accent_color').value = this.dataset.accent;
        updateColorPreviews();
    });
});

document.getElementById('theme_primary_color').addEventListener('change', updateColorPreviews);
document.getElementById('theme_accent_color').addEventListener('change', updateColorPreviews);
document.getElementById('theme_preference').addEventListener('change', applyTheme);

function uploadProfilePicture() {
    document.getElementById('profilePictureInput').click();
}

document.getElementById('profilePictureInput').addEventListener('change', async function(e) {
    var file = e.target.files[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) { showToast('Please select an image file', 'error'); return; }
    if (file.size > 2 * 1024 * 1024) { showToast('Image must be smaller than 2MB', 'error'); return; }
    var formData = new FormData();
    formData.append('profile_picture', file);
    try {
        showLoading('Uploading profile picture...');
        var response = await fetch('/profile/upload-picture', { method: 'POST', body: formData });
        var result = await response.json();
        if (result.success) {
            showToast('Profile picture updated!', 'success');
            var pp = document.getElementById('profilePicture');
            pp.outerHTML = '<img src="' + result.profile_picture + '" alt="Profile Picture" id="profilePicture" style="width:100%;height:100%;object-fit:cover">';
        } else {
            showToast(result.error || 'Failed to upload', 'error');
        }
    } catch (error) {
        console.error(error);
        showToast('An error occurred', 'error');
    } finally { hideLoading(); }
});

updateColorPreviews();
</script>

<%- include('partials/footer') %>

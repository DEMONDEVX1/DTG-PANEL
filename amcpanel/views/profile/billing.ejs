<%- include('../partials/header') %>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h1 class="mb-0">
                <i class="fas fa-credit-card"></i> Billing & Credits Panel
            </h1>
        </div>
    </div>

    <!-- Credit Balance Card -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="fas fa-wallet" style="font-size: 2em; color: #28a745;"></i>
                    <h3 class="mt-3 mb-1">Your Credits</h3>
                    <h2 class="text-success">💰 <%= credits.balance %> <%= credits.currency %></h2>
                    <p class="text-muted">Available balance</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="fas fa-history" style="font-size: 2em; color: #17a2b8;"></i>
                    <h3 class="mt-3 mb-1">Total Spent</h3>
                    <h2 id="totalSpent" class="text-info">💰 0 <%= credits.currency %></h2>
                    <p class="text-muted">Lifetime</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <i class="fas fa-server" style="font-size: 2em; color: #007bff;"></i>
                    <h3 class="mt-3 mb-1">Active Servers</h3>
                    <h2 id="activeServers" class="text-primary">0</h2>
                    <p class="text-muted">Servers running</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="row">
        <div class="col-md-12">
            <ul class="nav nav-tabs mb-4" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="packages-tab" data-bs-toggle="tab" data-bs-target="#packages" type="button">
                        <i class="fas fa-box"></i> Server Packages
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="transactions-tab" data-bs-toggle="tab" data-bs-target="#transactions" type="button">
                        <i class="fas fa-receipt"></i> Transaction History
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Server Packages Tab -->
                <div class="tab-pane fade show active" id="packages" role="tabpanel">
                    <% if (packages.length > 0) { %>
                        <div class="row">
                            <% packages.forEach(pkg => { %>
                                <div class="col-md-6 col-lg-4 mb-4">
                                    <div class="flip-card-container h-100">
                                        <div class="flip-card">
                                            <!-- Front of card -->
                                            <div class="flip-card-front">
                                                <div class="card h-100">
                                                    <div class="card-header bg-light">
                                                        <h5 class="mb-0"><%= pkg.name %></h5>
                                                    </div>
                                                    <div class="card-body d-flex flex-column">
                                                        <p class="text-muted flex-grow-1"><%= pkg.description || 'No description' %></p>
                                                        
                                                        <div class="mb-3">
                                                            <small class="badge bg-info"><%= pkg.software %> <%= pkg.version %></small>
                                                        </div>

                                                        <div class="specifications mb-3">
                                                            <div class="row">
                                                                <div class="col-6">
                                                                    <div class="spec-item">
                                                                        <i class="fas fa-memory"></i> <%= pkg.ram %>MB
                                                                    </div>
                                                                    <div class="spec-item">
                                                                        <i class="fas fa-microchip"></i> <%= pkg.cpu %> CPU
                                                                    </div>
                                                                </div>
                                                                <div class="col-6">
                                                                    <div class="spec-item">
                                                                        <i class="fas fa-hdd"></i> <%= pkg.disk %>MB
                                                                    </div>
                                                                    <div class="spec-item">
                                                                        <i class="fas fa-users"></i> <%= pkg.max_players %>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="mb-3">
                                                            <p class="text-muted mb-1">Duration: <%= pkg.expiry_days %> days</p>
                                                            <% if (pkg.auto_renewal) { %>
                                                                <small class="badge bg-warning">Auto-renewal</small>
                                                            <% } %>
                                                        </div>

                                                        <hr>

                                                        <div class="d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <% if (pkg.is_free) { %>
                                                                    <h4 class="mb-0"><span class="badge bg-success">FREE</span></h4>
                                                                <% } else { %>
                                                                    <h4 class="mb-0 text-warning">💰 <%= pkg.credits_cost %></h4>
                                                                <% } %>
                                                            </div>
                                                            <small class="text-info"><i class="fas fa-hand-pointer"></i> Click to manage</small>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Back of card -->
                                            <div class="flip-card-back">
                                                <div class="card h-100 bg-primary text-white">
                                                    <div class="card-header bg-primary border-0">
                                                        <h5 class="mb-0 text-white"><%= pkg.name %> - Options</h5>
                                                    </div>
                                                    <div class="card-body d-flex flex-column justify-content-center text-center">
                                                        <h6 class="mb-4">Select Action</h6>
                                                        
                                                        <button class="btn btn-light btn-lg mb-3 w-100" onclick="purchaseServer(<%= pkg.id %>, '<%= pkg.name %>', <%= pkg.credits_cost %>, <%= credits.balance %>)">
                                                            <i class="fas fa-shopping-cart"></i> Purchase
                                                        </button>
                                                        
                                                        <button class="btn btn-outline-light btn-lg mb-3 w-100" onclick="viewDetails(<%= JSON.stringify(pkg).replace(/'/g, '&#39;') %>)">
                                                            <i class="fas fa-info-circle"></i> Details
                                                        </button>
                                                        
                                                        <button class="btn btn-outline-light btn-lg w-100" onclick="flipCardBack(event)">
                                                            <i class="fas fa-arrow-left"></i> Back
                                                        </button>
                                                        
                                                        <small class="text-light mt-4">
                                                            <% if (pkg.is_free) { %>
                                                                ✓ Free Server
                                                            <% } else { %>
                                                                Cost: <%= pkg.credits_cost %> credits
                                                            <% } %>
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle"></i> No server packages available at the moment.
                        </div>
                    <% } %>
                </div>

                <!-- Transactions Tab -->
                <div class="tab-pane fade" id="transactions" role="tabpanel">
                    <% if (transactions.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Type</th>
                                        <th>Description</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% transactions.forEach(tx => { %>
                                        <tr>
                                            <td><%= new Date(tx.created_at).toLocaleDateString() %></td>
                                            <td>
                                                <% const types = {
                                                    'referral_claim': 'Referral Claim',
                                                    'server_purchase': 'Server Purchase',
                                                    'credit_purchase': 'Credit Purchase'
                                                };
                                                const type = types[tx.transaction_type] || tx.transaction_type;
                                                %>
                                                <span class="badge bg-info"><%= type %></span>
                                            </td>
                                            <td><%= tx.description %></td>
                                            <td>
                                                <span class="<%= tx.transaction_type === 'referral_claim' ? 'text-success' : 'text-danger' %>">
                                                    <%= tx.transaction_type === 'referral_claim' ? '+' : '-' %><%= tx.amount %>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-<%= tx.status === 'completed' ? 'success' : 'warning' %>">
                                                    <%= tx.status %>
                                                </span>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle"></i> No transactions yet.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* Flip Card Styles */
.flip-card-container {
    perspective: 1000px;
    cursor: pointer;
}

.flip-card {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s;
    transform-style: preserve-3d;
}

.flip-card-container:hover .flip-card,
.flip-card.flipped {
    transform: rotateY(180deg);
}

.flip-card-front, 
.flip-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    display: flex;
    align-items: stretch;
}

.flip-card-front {
    transform: rotateY(0deg);
}

.flip-card-back {
    transform: rotateY(180deg);
}

.flip-card-front .card,
.flip-card-back .card {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
}

.spec-item {
    padding: 5px 0;
    font-size: 0.9em;
}

.spec-item i {
    color: #666;
    margin-right: 5px;
}

@media (max-width: 768px) {
    .flip-card-container:hover .flip-card {
        transform: none;
    }
    
    .flip-card-container.mobile-flipped .flip-card {
        transform: rotateY(180deg);
    }
}
</style>

<script>
function flipCardBack(event) {
    event.preventDefault();
    const card = event.target.closest('.flip-card');
    if (card) {
        card.classList.remove('flipped');
    }
}

function purchaseServer(packageId, packageName, cost, balance) {
    if (cost > 0 && balance < cost) {
        alert(`Insufficient credits! You have ${balance} but need ${cost} credits.`);
        return;
    }

    if (!confirm(`Purchase "${packageName}" server?\nCost: 💰 ${cost} credits`)) return;

    fetch('/api/billing/purchase-server', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ package_id: packageId })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert(`Success! ${data.message}\nRemaining credits: 💰 ${data.remaining_credits}`);
            location.reload();
        } else {
            alert('Error: ' + data.message);
        }
    })
    .catch(err => alert('Error: ' + err.message));
}

function viewDetails(pkg) {
    let details = `
Package: ${pkg.name}
Software: ${pkg.software} ${pkg.version}
RAM: ${pkg.ram}MB
CPU: ${pkg.cpu} Core(s)
Disk: ${pkg.disk}MB
Max Players: ${pkg.max_players}
Duration: ${pkg.expiry_days} days
${pkg.is_free ? 'Cost: FREE' : 'Cost: ' + pkg.credits_cost + ' credits'}
${pkg.auto_renewal ? 'Auto-renewal: Available' : 'Auto-renewal: Not available'}
    `;
    alert(details);
}

// Add flip on click for mobile devices
document.addEventListener('DOMContentLoaded', function() {
    const flipCards = document.querySelectorAll('.flip-card-container');
    flipCards.forEach(card => {
        card.addEventListener('click', function(e) {
            if (window.innerWidth <= 768) {
                e.preventDefault();
                const flipCard = this.querySelector('.flip-card');
                flipCard.classList.toggle('flipped');
            }
        });
    });
});

// Calculate total spent from transactions
function calculateStats() {
    const txElements = document.querySelectorAll('tbody tr');
    let totalSpent = 0;
    let activeServers = 0;

    txElements.forEach(row => {
        const typeEl = row.querySelector('td:nth-child(2)');
        const amountEl = row.querySelector('td:nth-child(4)');
        
        if (typeEl && amountEl) {
            const type = typeEl.textContent;
            const amount = parseInt(amountEl.textContent);
            
            if (type.includes('Purchase') || type.includes('Credit')) {
                totalSpent += amount;
            }
        }
    });

    document.getElementById('totalSpent').textContent = '💰 ' + totalSpent + ' USD';
}

calculateStats();
</script>

<%- include('../partials/footer') %>

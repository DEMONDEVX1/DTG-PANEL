<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-database"></i> Backups</h1>
        <p class="page-subtitle"><%= server.name %></p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" onclick="showBackupModal()"><i class="fas fa-plus"></i> Create Backup</button>
    </div>
</div>

<div id="backupProgress" style="display:none;">
    <div class="card">
        <div class="card-body">
            <div class="d-flex gap-3 align-center">
                <i class="fas fa-spinner fa-spin" style="font-size:24px;color:var(--accent);"></i>
                <div class="flex-1">
                    <div class="fw-600 mb-1">Creating Backup...</div>
                    <div class="progress-wrap"><div class="progress-bar accent" id="progressFill" style="width:0%"></div></div>
                    <div class="text-xs text-muted mt-1" id="progressText">Preparing...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3>Available Backups (<%= backups ? backups.length : 0 %>)</h3></div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Backup Name</th><th>Size</th><th>Created</th><th>Actions</th></tr></thead>
            <tbody>
                <% if (backups && backups.length > 0) { %>
                    <% backups.forEach(backup => { %>
                        <tr>
                            <td>
                                <div class="fw-600"><%= backup.name || backup.file %></div>
                                <% if (backup.description) { %><div class="text-xs text-muted mt-1"><%= backup.description %></div><% } %>
                            </td>
                            <td><%= backup.size || 'N/A' %></td>
                            <td><%= new Date(backup.created_at).toLocaleString() %></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-ghost" onclick="validateBackup(<%= backup.id %>, '<%= (backup.name || backup.file).replace(/'/g, "\\'") %>')" title="Validate"><i class="fas fa-check-circle"></i></button>
                                    <button class="btn btn-sm btn-ghost" onclick="restoreBackup(<%= backup.id %>, '<%= (backup.name || backup.file).replace(/'/g, "\\'") %>')" title="Restore"><i class="fas fa-undo"></i></button>
                                    <button class="btn btn-sm btn-ghost" onclick="downloadBackup('<%= backup.file %>')" title="Download"><i class="fas fa-download"></i></button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteBackup(<%= backup.id %>, '<%= (backup.name || backup.file).replace(/'/g, "\\'") %>')" title="Delete"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="4" class="text-center text-muted" style="padding:40px;">
                        <i class="fas fa-database" style="font-size:48px;display:block;margin-bottom:16px;"></i>
                        No backups available
                        <div class="mt-2"><button class="btn btn-primary" onclick="showBackupModal()"><i class="fas fa-plus"></i> Create First Backup</button></div>
                    </td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3>Backup Information</h3></div>
    <div class="card-body">
        <div class="alert alert-info mb-3"><i class="fas fa-info-circle"></i> <span>Backups include all server files, worlds, plugins, and configurations. Server will be automatically stopped during backup.</span></div>
        <ul class="text-sm text-muted" style="line-height:1.8;">
            <li>Create regular backups to prevent data loss</li>
            <li>Server will automatically restart after backup completes</li>
            <li>Backups are stored in the server's backup directory</li>
            <li>Download backups to keep them safe offline</li>
        </ul>
    </div>
</div>

<div id="backupModal" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-header"><h3>Create Backup</h3><button class="modal-close" onclick="closeBackupModal()"><i class="fas fa-times"></i></button></div>
        <div class="modal-body">
            <form id="backupForm" onsubmit="createBackup(event)">
                <div class="form-group">
                    <label class="form-label">Backup Name</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g., Before Update" required>
                    <span class="form-hint">Give your backup a descriptive name</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Description (Optional)</label>
                    <textarea name="description" class="form-control" rows="3" placeholder="e.g., Backup before installing new plugins"></textarea>
                </div>
                <div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> <span>Server will be stopped during backup and automatically restarted after completion.</span></div>
                <div class="form-actions">
                    <button type="button" class="btn btn-ghost" onclick="closeBackupModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-database"></i> Create Backup</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const serverId = <%- JSON.stringify(server.id) %>;

function showBackupModal() { document.getElementById('backupModal').style.display = 'flex'; }
function closeBackupModal() { document.getElementById('backupModal').style.display = 'none'; document.getElementById('backupForm').reset(); }

function createBackup(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const name = formData.get('name');
    const description = formData.get('description');
    closeBackupModal();
    const progressDiv = document.getElementById('backupProgress');
    const progressFill = document.getElementById('progressFill');
    const progressText = document.getElementById('progressText');
    progressDiv.style.display = 'block';
    let progress = 0;
    const progressInterval = setInterval(() => {
        if (progress < 90) { progress += Math.random() * 10; if (progress > 90) progress = 90; progressFill.style.width = progress + '%'; if (progress < 30) progressText.textContent = 'Stopping server...'; else if (progress < 60) progressText.textContent = 'Compressing files...'; else progressText.textContent = 'Finalizing backup...'; }
    }, 500);
    fetch('/servers/<%= server.id %>/backups/create', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, description }) })
    .then(res => res.json())
    .then(data => { clearInterval(progressInterval); progressFill.style.width = '100%'; progressText.textContent = 'Complete!'; setTimeout(() => { if (data.success) location.reload(); else { progressDiv.style.display = 'none'; showToast('Error: ' + (data.error || 'Failed'), 'error'); } }, 1000); })
    .catch(err => { clearInterval(progressInterval); progressDiv.style.display = 'none'; console.error(err); showToast('An error occurred', 'error'); });
}

function restoreBackup(backupId, backupName) {
    showConfirm('Restore backup "' + backupName + '"? This will replace all current server files!').then(function(ok) {
        if (!ok) return;
        showToast('Restoring backup...', 'info');
        fetch('/servers/<%= server.id %>/backups/restore', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ backupId }) })
        .then(res => res.json())
        .then(data => { if (data.success) { showToast('Backup restored successfully!', 'success'); setTimeout(() => location.reload(), 1500); } else showToast('Error: ' + (data.error || 'Failed'), 'error'); })
        .catch(err => { console.error(err); showToast('An error occurred', 'error'); });
    });
}

function validateBackup(backupId, backupName) {
    showToast('Validating backup...', 'info');
    fetch('/servers/<%= server.id %>/backups/validate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ backupId }) })
    .then(res => res.json())
    .then(data => { if (data.valid) showToast(data.message || 'Backup is valid!', 'success'); else showToast('Backup validation failed: ' + (data.error || 'Invalid'), 'error'); })
    .catch(err => { console.error(err); showToast('An error occurred', 'error'); });
}

function downloadBackup(filename) { window.location.href = '/servers/<%= server.id %>/backups/download/' + filename; }

function deleteBackup(backupId, backupName) {
    showConfirm('Delete backup "' + backupName + '"? This cannot be undone!').then(function(ok) {
        if (!ok) return;
        fetch('/servers/<%= server.id %>/backups/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ backupId }) })
        .then(res => res.json())
        .then(data => { if (data.success) { showToast('Backup deleted!', 'success'); setTimeout(() => location.reload(), 1000); } else showToast('Error: ' + (data.error || 'Failed'), 'error'); })
        .catch(err => { console.error(err); showToast('An error occurred', 'error'); });
    });
}

document.getElementById('backupModal').addEventListener('click', function(e) { if (e.target === this) closeBackupModal(); });
</script>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<% var isRunning = server.status === 'running'; %>

<div class="srv-hero" style="padding:16px 22px;margin-bottom:18px">
    <div class="srv-hero-left">
        <div class="srv-hero-icon <%= isRunning ? '' : 'stopped' %>" style="width:46px;height:46px;font-size:18px;border-radius:13px"><i class="fas fa-terminal"></i></div>
        <div>
            <div class="srv-hero-title" style="font-size:18px"><%= server.name %> <span class="srv-chip"><i class="fas fa-terminal"></i> Console</span></div>
            <div class="srv-hero-sub">
                <span class="srv-hero-status <%= isRunning ? 'online' : 'offline' %>" style="padding:4px 12px;font-size:12px">
                    <span class="status-dot <%= isRunning ? 'online' : 'offline' %>"></span> <%= isRunning ? 'Online' : 'Offline' %>
                </span>
            </div>
        </div>
    </div>
    <div class="srv-hero-actions">
        <button class="btn btn-sm btn-ghost" onclick="clearConsole()"><i class="fas fa-eraser"></i> Clear</button>
        <button class="btn btn-sm btn-ghost" onclick="toggleAutoScroll()"><i class="fas fa-arrows-alt-v"></i> <span id="autoScrollText">Auto-scroll: ON</span></button>
    </div>
</div>

<div class="console-shell">
    <div class="console-wrap">
        <div class="console-header">
            <div class="console-title">
                <span class="console-live"><span class="live-dot"></span></span> Live Console
                <span class="console-cache-hint" id="cacheHint"></span>
            </div>
            <div class="console-actions">
                <span class="console-stat"><i class="fas fa-server"></i> Port <%= server.port %></span>
                <span class="console-stat"><i class="fas fa-cube"></i> <%= server.server_type || 'vanilla' %></span>
            </div>
        </div>
        <div class="console-output" id="console"></div>
        <% if (isRunning) { %>
        <% var canSend = (typeof canSendCommands !== 'undefined' && canSendCommands) ? true : false; %>
        <form class="console-input-wrap" onsubmit="sendCommand(event)" autocomplete="off">
            <span class="console-prompt">&gt;</span>
            <input type="text" id="commandInput" class="console-input" placeholder="<%= canSend ? 'Type a server command...' : 'Restart server to enable commands' %>" <%= !canSend ? 'disabled' : '' %>>
            <button type="submit" class="btn btn-primary btn-sm" <%= !canSend ? 'disabled' : '' %>><i class="fas fa-paper-plane"></i> Send</button>
        </form>
        <% } %>
    </div>
    <% if (isRunning) { %>
    <div class="console-quick">
        <span class="console-quick-lbl"><i class="fas fa-bolt"></i> Quick:</span>
        <button class="btn btn-sm btn-ghost" onclick="quickCommand('list')" <%= !canSend ? 'disabled' : '' %>>list</button>
        <button class="btn btn-sm btn-ghost" onclick="quickCommand('help')" <%= !canSend ? 'disabled' : '' %>>help</button>
        <button class="btn btn-sm btn-ghost" onclick="quickCommand('save-all')" <%= !canSend ? 'disabled' : '' %>>save-all</button>
        <button class="btn btn-sm btn-ghost" onclick="quickCommand('whitelist list')" <%= !canSend ? 'disabled' : '' %>>whitelist</button>
        <button class="btn btn-sm btn-ghost" onclick="quickCommand('tps')" <%= !canSend ? 'disabled' : '' %>>tps</button>
        <button class="btn btn-sm btn-ghost" onclick="quickCommand('seed')" <%= !canSend ? 'disabled' : '' %>>seed</button>
    </div>
    <% if (!canSend) { %>
    <div class="alert alert-warning" style="margin-top:14px"><i class="fas fa-exclamation-triangle"></i> <span>Console commands are disabled. This server was started before the panel was restarted. Please restart the server from the dashboard to enable console commands.</span></div>
    <% } %>
    <% } else { %>
    <div class="alert alert-warning" style="margin-top:14px"><i class="fas fa-exclamation-triangle"></i> <span>Server must be running to send commands</span></div>
    <% } %>
</div>

<style>
.console-shell { max-width: 1100px; margin: 0 auto; }
.console-title { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; color: var(--text-primary); font-family: var(--font-sans); }
.console-live { display: inline-flex; }
.console-live .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--success); display: inline-block; }
.console-cache-hint { font-size: 10.5px; font-weight: 500; color: var(--text-tertiary); font-family: var(--font-sans); }
.console-stat { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: var(--text-tertiary); font-family: var(--font-sans); }
.console-quick { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
.console-quick-lbl { font-size: 12px; font-weight: 600; color: var(--text-tertiary); display: inline-flex; align-items: center; gap: 6px; }
.console-quick .btn { padding: 6px 12px; font-size: 12px; font-family: var(--font-mono); }
</style>

<script>
var serverId = <%- JSON.stringify(server.id) %>;
var consoleDiv = document.getElementById('console');
var LOG_CACHE_KEY = 'console_cache_' + serverId;
var MAX_CACHE_LINES = 2000;
var autoScroll = true;
var consoleLines = [];
var socket = (window._consoleSocket && window._consoleSocket.connected) ? window._consoleSocket : null;
const commandHistory = [];
let historyIndex = -1;

function saveConsoleCache() {
    try { var toSave = consoleLines.slice(-MAX_CACHE_LINES); localStorage.setItem(LOG_CACHE_KEY, JSON.stringify(toSave)); } catch(e) {}
}
function loadConsoleCache() {
    try { var raw = localStorage.getItem(LOG_CACHE_KEY); if (raw) return JSON.parse(raw); } catch(e) {}
    return null;
}
function clearConsoleCache() { try { localStorage.removeItem(LOG_CACHE_KEY); } catch(e) {} }

function renderLine(output, skipCache) {
    var pre = document.createElement('pre');
    pre.className = 'console-line';
    if (output.includes('[ERROR]') || output.includes('ERROR')) pre.className = 'console-line error';
    else if (output.includes('[WARN]') || output.includes('WARN')) pre.className = 'console-line warn';
    else if (output.includes('[INFO]') || output.includes('INFO')) pre.className = 'console-line info';
    else if (output.includes('[PANEL')) { pre.className = 'console-line cmd'; }
    pre.textContent = output;
    consoleDiv.appendChild(pre);
    if (!skipCache) { consoleLines.push(output); if (consoleLines.length > MAX_CACHE_LINES) consoleLines = consoleLines.slice(-MAX_CACHE_LINES); saveConsoleCache(); }
    scrollToBottom();
}

var serverSnapshot = <%- JSON.stringify(logContent || '') %>;

function initConsole() {
    var cached = loadConsoleCache();
    if (cached && cached.length > 0) {
        consoleLines = cached;
        cached.forEach(function(line) { renderLine(line, true); });
        renderLine('[PANEL] Console restored from cache', true);
        var h = document.getElementById('cacheHint');
        if (h) h.textContent = '(' + cached.length + ' cached lines)';
    } else if (serverSnapshot) {
        var lines = serverSnapshot.split('\n');
        lines.forEach(function(line) { if (line.length > 0) renderLine(line, true); });
    } else {
        consoleDiv.innerHTML = '<p style="color:#888;padding:16px;">No console output available. Start the server to see logs.</p>';
    }
}
initConsole();

function scrollToBottom() { if (autoScroll) consoleDiv.scrollTop = consoleDiv.scrollHeight; }
function toggleAutoScroll() { autoScroll = !autoScroll; document.getElementById('autoScrollText').textContent = 'Auto-scroll: ' + (autoScroll ? 'ON' : 'OFF'); }
function clearConsole() {
    showConfirm('Clear all console output? This cannot be undone.').then(function(ok) {
        if (!ok) return;
        consoleDiv.innerHTML = '<p style="color:#888;padding:16px;">Console cleared</p>';
        consoleLines = [];
        clearConsoleCache();
    });
}

function sendCommand(e) {
    e.preventDefault();
    var input = document.getElementById('commandInput');
    var command = input.value.trim();
    if (!command) return;
    if (command && commandHistory.indexOf(command) === -1) { commandHistory.push(command); if (commandHistory.length > 50) commandHistory.shift(); }
    historyIndex = -1;
    fetch('/servers/' + serverId + '/command', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ command: command }) })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) { input.value = ''; renderLine('> ' + command); }
        else if (data.autoFixed && data.action === 'restart') {
            var d = document.createElement('div'); d.className = 'alert alert-success'; d.style.margin = '10px 0';
            d.innerHTML = '<i class="fas fa-check-circle"></i><span><strong>RCON Enabled!</strong><br>' + (data.error || '') + '</span>';
            var btn = document.createElement('button'); btn.textContent = 'Restart Server'; btn.className = 'btn btn-success'; btn.style.marginTop = '8px'; btn.onclick = function(){ location.reload(); };
            d.querySelector('span').appendChild(document.createElement('br')); d.querySelector('span').appendChild(btn);
            consoleDiv.appendChild(d); scrollToBottom();
        } else {
            var errDiv = document.createElement('div'); errDiv.className = 'alert alert-error'; errDiv.style.margin = '10px 0';
            errDiv.innerHTML = '<i class="fas fa-exclamation-circle"></i><span><strong>Error: </strong>' + (data.error || 'Failed') + '</span>';
            consoleDiv.appendChild(errDiv); scrollToBottom();
        }
    })
    .catch(function() { renderLine('[PANEL] Network error sending command', true); });
}

function quickCommand(cmd) { var input = document.getElementById('commandInput'); if (input) { input.value = cmd; input.focus(); } }

function initializeSocket() {
    if (socket && socket.connected) return;
    if (socket) socket.disconnect();
    socket = io();
    window._consoleSocket = socket;
    socket.emit('join-server', serverId);
    socket.on('console', function(data) {
        var output = '';
        if (typeof data === 'string') output = data;
        else if (data && data.line) output = data.line;
        else if (data && data.serverId == serverId) output = data.output || data.message || '';
        if (output) renderLine(output);
    });
    socket.on('connect', function() { renderLine('[PANEL] Connected to live console', true); });
    socket.on('disconnect', function() { renderLine('[PANEL] Disconnected — reconnecting...', true); });
    socket.on('error', function(error) { console.error('Socket error:', error); });
}
initializeSocket();

window.addEventListener('beforeunload', function() { if (socket) { socket.emit('leave-server', serverId); socket.disconnect(); } });

var commandInput = document.getElementById('commandInput');
if (commandInput) {
    commandInput.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowUp') { e.preventDefault(); if (historyIndex < commandHistory.length - 1) { historyIndex++; e.target.value = commandHistory[commandHistory.length - 1 - historyIndex]; } }
        else if (e.key === 'ArrowDown') { e.preventDefault(); if (historyIndex > 0) { historyIndex--; e.target.value = commandHistory[commandHistory.length - 1 - historyIndex]; } else { historyIndex = -1; e.target.value = ''; } }
    });
}

var _socketReconnectInterval = setInterval(function() { if (socket && !socket.connected) initializeSocket(); }, 5000);

// Register cleanup for SPA navigation
if (!window._pageCleanups) window._pageCleanups = [];
window._pageCleanups.push(function() {
    clearInterval(_socketReconnectInterval);
    if (socket) { try { socket.emit('leave-server', serverId); socket.disconnect(); } catch(e) {} }
    window._consoleSocket = null;
});
</script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-file-code" style="color:var(--accent);"></i> File Editor</h1>
        <p class="page-subtitle">
            <% if (typeof filePath !== 'undefined') { %><i class="fas fa-folder-open"></i> <%= filePath %><% } else { %><i class="fas fa-exclamation-triangle"></i> No file path<% } %>
            <span id="modifiedBadge" class="btn btn-sm btn-warning" style="display:none;margin-left:8px;padding:2px 8px;font-size:11px;"><i class="fas fa-circle"></i> Modified</span>
        </p>
    </div>
    <div class="page-actions">
        <% if (typeof server !== 'undefined' && typeof path !== 'undefined' && typeof filePath !== 'undefined' && path.basename(filePath) === 'server.properties') { %>
            <a href="/servers/<%= server.id %>/properties" class="btn btn-info"><i class="fas fa-sliders-h"></i> Visual Editor</a>
        <% } %>
        <% if (typeof server !== 'undefined') { %>
            <a href="/servers/<%= server.id %>/files" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Back</a>
        <% } %>
        <button class="btn btn-primary" onclick="saveFile()" id="saveBtn"><i class="fas fa-save"></i> Save</button>
    </div>
</div>

<% if (typeof server !== 'undefined' && typeof path !== 'undefined' && typeof filePath !== 'undefined' && path.basename(filePath) === 'server.properties') { %>
<div class="alert alert-info mb-3"><i class="fas fa-info-circle"></i> <span>You're editing the raw server.properties file. For easier configuration, use the <a href="/servers/<%= server.id %>/properties" class="text-accent fw-600">Visual Properties Editor</a>.</span></div>
<% } %>

<div class="card">
    <div class="card-header d-flex align-center justify-between flex-wrap gap-2">
        <div class="d-flex align-center gap-2">
            <span class="fw-600">Code Editor</span>
            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-ghost" onclick="showFindModal()" title="Find & Replace (Ctrl+F)"><i class="fas fa-search"></i> Find</button>
                <button class="btn btn-sm btn-ghost" onclick="toggleWrap()" title="Toggle Word Wrap (Alt+Z)"><i class="fas fa-align-left"></i> Wrap</button>
                <button class="btn btn-sm btn-ghost" onclick="formatDoc()" title="Format Document"><i class="fas fa-indent"></i> Format</button>
            </div>
        </div>
        <div class="d-flex gap-3 text-sm">
            <span class="badge badge-info"><i class="fas fa-hashtag"></i> <span id="lineCount"><% if (typeof content !== 'undefined') { %><%= content.split('\n').length %><% } else { %>0<% } %></span> lines</span>
            <span class="text-muted"><i class="fas fa-location-dot"></i> <span id="cursorPos">Ln 1, Col 1</span></span>
            <span class="text-muted"><i class="fas fa-file-lines"></i> <span id="fileStats"><% if (typeof content !== 'undefined') { %><%= content.length %> chars<% } else { %>0 chars<% } %></span></span>
        </div>
    </div>
    <div class="card-body p-0" style="background:var(--bg-primary);">
        <textarea id="editor" class="w-100" style="min-height:600px;background:var(--bg-primary);color:var(--text-primary);border:none;outline:none;resize:none;padding:20px 24px;font-family:'Consolas','Courier New',monospace;font-size:14px;line-height:22px;tab-size:4;white-space:pre-wrap;word-wrap:break-word;" spellcheck="false" autocomplete="off" autocorrect="off" autocapitalize="off"><% if (typeof content !== 'undefined') { %><%= content %><% } %></textarea>
    </div>
</div>

<div class="modal-overlay" id="findModal" style="display:none;">
    <div class="modal-box" style="max-width:550px;">
        <div class="modal-header">
            <h3><i class="fas fa-search"></i> Find & Replace</h3>
            <button class="modal-close" onclick="hideFindModal()"><i class="fas fa-times"></i></button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Find</label>
                <input type="text" id="findInput" class="form-control" placeholder="Search in file..." autocomplete="off">
                <div class="d-flex gap-2 mt-1 align-center">
                    <button class="btn btn-sm btn-ghost" onclick="findPrev()"><i class="fas fa-chevron-up"></i> Previous</button>
                    <button class="btn btn-sm btn-ghost" onclick="findNext()"><i class="fas fa-chevron-down"></i> Next</button>
                    <span class="text-muted text-sm" id="findCount">0 found</span>
                </div>
            </div>
            <div class="form-group mb-0">
                <label class="form-label">Replace</label>
                <input type="text" id="replaceInput" class="form-control" placeholder="Replace with..." autocomplete="off">
                <div class="d-flex gap-2 mt-1">
                    <button class="btn btn-sm btn-primary" onclick="replaceOne()"><i class="fas fa-exchange-alt"></i> Replace</button>
                    <button class="btn btn-sm btn-success" onclick="replaceAll()"><i class="fas fa-check-double"></i> Replace All</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="editorLoadingOverlay" style="display:none;">
    <div class="modal-box" style="width:auto;background:transparent;box-shadow:none;border:none;">
        <div class="spinner"></div>
    </div>
</div>

<script>
const serverId = <%- JSON.stringify(typeof server !== "undefined" ? server.id : '') %>;
const filePathRaw = <%- JSON.stringify(typeof filePath !== "undefined" ? filePath : '') %>;
const filePath = filePathRaw.replace(/\\/g, '\\\\');
let editor, originalContent = '', isModified = false;
let currentSearchIndex = -1, searchMatches = [];

document.addEventListener('DOMContentLoaded', function() {
    editor = document.getElementById('editor');
    if (!editor) { console.error('Editor element not found!'); return; }
    originalContent = editor.value;

    var binaryExts = /\.(jpg|jpeg|png|gif|webp|bmp|ico|svg|mp3|mp4|webm|ogg|wav|flac|zip|rar|7z|tar|gz|bz2|xz|jar|exe|dll|so|dylib|bin|dat|db|sqlite|pdf|doc|docx|xls|xlsx|ppt|pptx|ttf|otf|woff|woff2|eot)$/i;
    var curPath = window.location.pathname + window.location.search;
    var pathMatch = curPath.match(/path=([^&]+)/);
    if (pathMatch) {
        var fileName = decodeURIComponent(pathMatch[1]).split('/').pop();
        if (binaryExts.test(fileName)) {
            var card = document.querySelector('.card');
            if (card) { var warn = document.createElement('div'); warn.className = 'alert alert-warning'; warn.innerHTML = '<i class="fas fa-exclamation-triangle"></i><span><strong>Binary file detected</strong> — This file type cannot be edited as text. <a href="/servers/' + serverId + '/files/download?path=' + encodeURIComponent(pathMatch[1]) + '" class="text-accent">Download it instead</a></span>'; card.prepend(warn); }
        }
    }
    updateCursor(); updateStats();
    editor.addEventListener('input', onChange);
    editor.addEventListener('keydown', onKeyDown);
    editor.addEventListener('click', updateCursor);
    editor.addEventListener('keyup', updateCursor);
    editor.addEventListener('keydown', function(e) {
        if (e.key === 'Tab') {
            e.preventDefault();
            const start = this.selectionStart, end = this.selectionEnd;
            if (e.shiftKey) {
                const lineStart = this.value.lastIndexOf('\n', start - 1) + 1;
                const lineText = this.value.substring(lineStart, end);
                if (lineText.startsWith('    ')) { this.value = this.value.substring(0, lineStart) + lineText.substring(4) + this.value.substring(end); this.selectionStart = Math.max(lineStart, start - 4); this.selectionEnd = Math.max(lineStart, end - 4); }
                else if (lineText.startsWith('\t')) { this.value = this.value.substring(0, lineStart) + lineText.substring(1) + this.value.substring(end); this.selectionStart = Math.max(lineStart, start - 1); this.selectionEnd = Math.max(lineStart, end - 1); }
            } else { this.value = this.value.substring(0, start) + '    ' + this.value.substring(end); this.selectionStart = this.selectionEnd = start + 4; }
            onChange();
        }
    });
    const findModal = document.getElementById('findModal');
    if (findModal) findModal.addEventListener('click', function(e) { if (e.target === this) hideFindModal(); });
    const findInput = document.getElementById('findInput');
    if (findInput) {
        findInput.addEventListener('input', function() { const term = this.value; if (term) updateFindCount(term); else document.getElementById('findCount').textContent = '0 found'; });
        findInput.addEventListener('keydown', function(e) { if (e.key === 'Enter') { e.preventDefault(); if (e.shiftKey) findPrev(); else findNext(); } if (e.key === 'Escape') hideFindModal(); });
    }
});

function onChange() { updateStats(); updateCursor(); checkModified(); }
function updateStats() { if (!editor) return; const lines = editor.value.split('\n').length; const chars = editor.value.length; const lineCountEl = document.getElementById('lineCount'); if (lineCountEl) lineCountEl.textContent = lines; const statsEl = document.getElementById('fileStats'); if (statsEl) statsEl.textContent = chars + ' chars'; }
function updateCursor() { if (!editor) return; const pos = editor.selectionStart; const text = editor.value.substring(0, pos); const lines = text.split('\n'); const line = lines.length; const col = lines[lines.length - 1].length + 1; const cursorEl = document.getElementById('cursorPos'); if (cursorEl) cursorEl.textContent = 'Ln ' + line + ', Col ' + col; }
function checkModified() { if (!editor) return; isModified = editor.value !== originalContent; const badge = document.getElementById('modifiedBadge'); if (badge) badge.style.display = isModified ? 'inline-flex' : 'none'; }
function onKeyDown(e) { if ((e.ctrlKey || e.metaKey) && e.key === 's') { e.preventDefault(); saveFile(); } if ((e.ctrlKey || e.metaKey) && e.key === 'f') { e.preventDefault(); showFindModal(); } if (e.altKey && e.key === 'z') { e.preventDefault(); toggleWrap(); } if (e.key === 'Escape') hideFindModal(); }

async function saveFile() {
    if (!serverId || !filePath) { showToast('Error: Missing server ID or file path', 'error'); return; }
    const btn = document.getElementById('saveBtn');
    if (!btn) return;
    const originalHtml = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...'; btn.disabled = true;
    try {
        const res = await fetch('/servers/' + serverId + '/files/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ path: filePathRaw, content: editor.value }) });
        const data = await res.json();
        if (data.success) { originalContent = editor.value; isModified = false; const badge = document.getElementById('modifiedBadge'); if (badge) badge.style.display = 'none'; btn.innerHTML = '<i class="fas fa-check"></i> Saved!'; showToast('File saved successfully!', 'success'); setTimeout(() => { btn.innerHTML = originalHtml; }, 2000); }
        else throw new Error(data.error || 'Failed to save file');
    } catch (err) { console.error('Save error:', err); showToast('Error: ' + err.message, 'error'); btn.innerHTML = '<i class="fas fa-times"></i> Error'; setTimeout(() => { btn.innerHTML = originalHtml; }, 2000); }
    finally { btn.disabled = false; }
}

function formatDoc() { if (!editor) return; editor.value = editor.value.split('\n').map(line => line.trimEnd()).join('\n'); onChange(); showToast('Document formatted successfully', 'success'); }
function toggleWrap() { if (!editor) return; if (editor.style.whiteSpace === 'pre-wrap') { editor.style.whiteSpace = 'pre'; showToast('Word wrap disabled', 'success'); } else { editor.style.whiteSpace = 'pre-wrap'; showToast('Word wrap enabled', 'success'); } }
function showFindModal() { const modal = document.getElementById('findModal'); const input = document.getElementById('findInput'); if (modal) { modal.style.display = 'flex'; if (input) { input.focus(); input.select(); } } }
function hideFindModal() { const modal = document.getElementById('findModal'); if (modal) modal.style.display = 'none'; }

function findNext() {
    if (!editor) return; const term = document.getElementById('findInput').value;
    if (!term) { showToast('Please enter a search term', 'warning'); return; }
    const pos = editor.selectionEnd; let next = editor.value.indexOf(term, pos);
    if (next === -1) next = editor.value.indexOf(term);
    if (next !== -1) { editor.focus(); editor.setSelectionRange(next, next + term.length); const lineHeight = 22; const linesBeforeSelection = editor.value.substring(0, next).split('\n').length; const scrollTarget = Math.max(0, (linesBeforeSelection - 10) * lineHeight); editor.parentElement.scrollTop = scrollTarget; updateFindCount(term); }
    else showToast('No matches found', 'warning');
}

function findPrev() {
    if (!editor) return; const term = document.getElementById('findInput').value;
    if (!term) { showToast('Please enter a search term', 'warning'); return; }
    const pos = editor.selectionStart; let prev = editor.value.lastIndexOf(term, pos - 1);
    if (prev === -1) prev = editor.value.lastIndexOf(term);
    if (prev !== -1) { editor.focus(); editor.setSelectionRange(prev, prev + term.length); const lineHeight = 22; const linesBeforeSelection = editor.value.substring(0, prev).split('\n').length; const scrollTarget = Math.max(0, (linesBeforeSelection - 10) * lineHeight); editor.parentElement.scrollTop = scrollTarget; updateFindCount(term); }
    else showToast('No matches found', 'warning');
}

function updateFindCount(term) { if (!editor) return; const matches = editor.value.split(term).length - 1; const countEl = document.getElementById('findCount'); if (countEl) countEl.textContent = matches + ' found'; }

function replaceOne() {
    if (!editor) return; const find = document.getElementById('findInput').value; const replace = document.getElementById('replaceInput').value;
    if (!find) { showToast('Please enter a search term', 'warning'); return; }
    const selected = editor.value.substring(editor.selectionStart, editor.selectionEnd);
    if (selected === find) { const start = editor.selectionStart; editor.value = editor.value.substring(0, start) + replace + editor.value.substring(editor.selectionEnd); editor.setSelectionRange(start, start + replace.length); onChange(); showToast('Replaced 1 occurrence', 'success'); findNext(); }
    else findNext();
}

function replaceAll() {
    if (!editor) return; const find = document.getElementById('findInput').value; const replace = document.getElementById('replaceInput').value;
    if (!find) { showToast('Please enter a search term', 'warning'); return; }
    const count = editor.value.split(find).length - 1;
    if (count > 0) { editor.value = editor.value.split(find).join(replace); onChange(); showToast('Replaced ' + count + ' occurrence' + (count !== 1 ? 's' : ''), 'success'); }
    else showToast('No occurrences found', 'warning');
}

window.addEventListener('beforeunload', function(e) { if (isModified) { e.preventDefault(); e.returnValue = 'You have unsaved changes. Are you sure you want to leave?'; return e.returnValue; } });
window.addEventListener('pagehide', function() { if (isModified) localStorage.setItem('unsaved_' + serverId + '_' + filePath, editor.value); });
window.addEventListener('load', function() { const unsaved = localStorage.getItem('unsaved_' + serverId + '_' + filePath); if (unsaved && unsaved !== originalContent) { if (confirm('Found unsaved changes from a previous session. Would you like to restore them?')) { editor.value = unsaved; onChange(); } localStorage.removeItem('unsaved_' + serverId + '_' + filePath); } });
</script>

<%- include('../partials/footer') %>

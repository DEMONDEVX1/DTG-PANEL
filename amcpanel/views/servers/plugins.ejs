<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-plug"></i> Plugins</h1>
        <p class="page-subtitle"><%= server.name %></p>
    </div>
    <div class="page-actions">
        <a href="/servers/<%= server.id %>/plugins/marketplace" class="btn btn-primary"><i class="fas fa-store"></i> Browse Marketplace</a>
        <button class="btn btn-ghost" onclick="showUploadModal()"><i class="fas fa-upload"></i> Upload Plugin</button>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3>Installed Plugins (<%= plugins ? plugins.length : 0 %>)</h3></div>
    <% if (plugins && plugins.length > 0) { %>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>Plugin</th><th>Version</th><th>Size</th><th>Status</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
                <% plugins.forEach(plugin => { %>
                <tr>
                    <td>
                        <div class="d-flex gap-2 align-center">
                            <div style="width:40px;height:40px;border-radius:var(--r-md);background:var(--bg-tertiary);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-puzzle-piece" style="color:var(--accent);font-size:18px;"></i></div>
                            <div>
                                <div class="fw-600"><%= plugin.name %></div>
                                <% if (plugin.description) { %><div class="text-xs text-muted"><%= plugin.description %></div><% } %>
                                <% if (plugin.author) { %><div class="text-xs text-muted">by <%= plugin.author %></div><% } %>
                            </div>
                        </div>
                    </td>
                    <td><span class="badge <%= plugin.version === 'Unknown' ? 'badge-warning' : 'badge-accent' %>"><%= plugin.version %></span></td>
                    <td><span class="text-sm"><%= plugin.formattedSize %></span></td>
                    <td>
                        <% if (plugin.enabled) { %><span class="badge badge-success"><i class="fas fa-check-circle"></i> Enabled</span>
                        <% } else { %><span class="badge badge-danger"><i class="fas fa-times-circle"></i> Disabled</span><% } %>
                    </td>
                    <td class="text-center">
                        <div class="d-flex gap-1 justify-center">
                            <% if (plugin.website) { %><a href="<%= plugin.website %>" target="_blank" class="btn btn-sm btn-ghost" title="Website"><i class="fas fa-external-link-alt"></i></a><% } %>
                            <button class="btn btn-sm btn-danger" onclick="deletePlugin('<%= plugin.filename %>', '<%= plugin.name.replace(/'/g, "\\'") %>')" title="Delete"><i class="fas fa-trash"></i></button>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } else { %>
    <div class="card-body">
        <div class="text-center text-muted" style="padding:40px;">
            <i class="fas fa-plug" style="font-size:64px;display:block;margin-bottom:16px;opacity:0.3;"></i>
            <h3>No Plugins Installed</h3>
            <p class="text-muted">Get started by browsing the marketplace or uploading a plugin</p>
            <div class="d-flex gap-2 justify-center mt-2">
                <a href="/servers/<%= server.id %>/plugins/marketplace" class="btn btn-primary"><i class="fas fa-store"></i> Browse Marketplace</a>
                <button class="btn btn-ghost" onclick="showUploadModal()"><i class="fas fa-upload"></i> Upload Plugin</button>
            </div>
        </div>
    </div>
    <% } %>
</div>

<div class="card">
    <div class="card-header"><h3>Plugin Information</h3></div>
    <div class="card-body">
        <div class="alert alert-info mb-3"><i class="fas fa-info-circle"></i> <span>Plugins require a Paper, Spigot, or Bukkit server. Vanilla servers do not support plugins.</span></div>
        <div class="grid-3">
            <div>
                <h4 class="fw-600 text-sm mb-1" style="color:var(--accent);"><i class="fas fa-download"></i> Installing Plugins</h4>
                <ul class="text-xs text-muted" style="line-height:1.8;margin:0;padding-left:16px;">
                    <li>Browse marketplace for popular plugins</li><li>Upload .jar files directly</li><li>Restart server after installation</li>
                </ul>
            </div>
            <div>
                <h4 class="fw-600 text-sm mb-1" style="color:var(--success);"><i class="fas fa-check-circle"></i> Best Practices</h4>
                <ul class="text-xs text-muted" style="line-height:1.8;margin:0;padding-left:16px;">
                    <li>Check plugin compatibility</li><li>Read plugin documentation</li><li>Keep plugins updated</li>
                </ul>
            </div>
            <div>
                <h4 class="fw-600 text-sm mb-1" style="color:var(--warning);"><i class="fas fa-exclamation-triangle"></i> Important Notes</h4>
                <ul class="text-xs text-muted" style="line-height:1.8;margin:0;padding-left:16px;">
                    <li>Only use trusted sources</li><li>Backup before major changes</li><li>Monitor server performance</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div id="uploadModal" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-header"><h3>Upload Plugin</h3><button class="modal-close" onclick="closeUploadModal()"><i class="fas fa-times"></i></button></div>
        <div class="modal-body">
            <form id="uploadForm" onsubmit="uploadPlugin(event)" enctype="multipart/form-data">
                <div class="form-group">
                    <label class="form-label">Select Plugin (.jar file)</label>
                    <input type="file" name="plugin" class="form-control" accept=".jar" required>
                </div>
                <div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> <span>Only upload plugins from trusted sources</span></div>
                <div class="form-actions">
                    <button type="button" class="btn btn-ghost" onclick="closeUploadModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="uploadBtn"><i class="fas fa-upload"></i> Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function showUploadModal() { document.getElementById('uploadModal').style.display = 'flex'; }
function closeUploadModal() { document.getElementById('uploadModal').style.display = 'none'; document.getElementById('uploadForm').reset(); }

function uploadPlugin(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const uploadBtn = document.getElementById('uploadBtn');
    uploadBtn.disabled = true; uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Uploading...';
    fetch('/servers/<%= server.id %>/plugins/upload', { method: 'POST', body: formData })
    .then(res => res.json())
    .then(data => { if (data.success) { showToast('Plugin uploaded! Restart to load.', 'success'); setTimeout(() => location.reload(), 1500); } else { showToast('Error: ' + (data.error || 'Failed'), 'error'); uploadBtn.disabled = false; uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload'; } })
    .catch(err => { console.error(err); showToast('Upload failed', 'error'); uploadBtn.disabled = false; uploadBtn.innerHTML = '<i class="fas fa-upload"></i> Upload'; });
}

function deletePlugin(filename, pluginName) {
    if (!confirm('Delete plugin "' + pluginName + '"? Restart server for changes to take effect.')) return;
    fetch('/servers/<%= server.id %>/plugins/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ filename }) })
    .then(res => res.json())
    .then(data => { if (data.success) { showToast('Plugin deleted!', 'success'); setTimeout(() => location.reload(), 1000); } else showToast('Error: ' + (data.error || 'Failed'), 'error'); })
    .catch(err => { console.error(err); showToast('An error occurred', 'error'); });
}

document.getElementById('uploadModal').addEventListener('click', function(e) { if (e.target === this) closeUploadModal(); });
</script>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-cogs"></i> Server Properties</h1>
        <p class="page-subtitle"><%= server.name %> - Interactive Configuration</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-ghost" onclick="resetToDefaults()"><i class="fas fa-undo"></i> Reset to Defaults</button>
        <button class="btn btn-ghost" onclick="openTextEditor()"><i class="fas fa-code"></i> Text Editor</button>
        <a href="/servers/<%= server.id %>/files" class="btn btn-ghost"><i class="fas fa-folder"></i> File Manager</a>
        <button class="btn btn-primary" onclick="saveProperties()"><i class="fas fa-save"></i> Save Properties</button>
    </div>
</div>

<div class="card" style="border-left:3px solid var(--accent);background:var(--accent-dim);">
    <div class="card-body">
        <div class="d-flex gap-3 align-center">
            <i class="fas fa-shield-alt" style="font-size:24px;color:var(--accent);"></i>
            <div class="flex-1">
                <div class="fw-600 mb-1"><i class="fas fa-lock"></i> Smart Port Protection Active</div>
                <div class="text-sm text-secondary">Server port is automatically managed (currently: <strong><%= server.port %></strong>) and cannot be changed. All other settings are fully customizable.</div>
            </div>
            <span class="badge badge-danger">PROTECTED</span>
        </div>
    </div>
</div>

<form id="propertiesForm">
    <div class="grid-2 gap-3 mb-3">

        <div class="card">
            <div class="card-header"><h3><i class="fas fa-server"></i> Basic Server Settings</h3></div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Server Port <span class="badge badge-danger" style="font-size:10px;">Protected</span></label>
                    <input type="number" name="server-port" class="form-control" value="<%= server.port %>" disabled>
                    <span class="form-hint">Network port for server connections</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Server IP</label>
                    <input type="text" name="server-ip" class="form-control" placeholder="Leave empty for all IPs">
                    <span class="form-hint">IP address to bind to</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Message of the Day (MOTD)</label>
                    <input type="text" name="motd" class="form-control" placeholder="A Minecraft Server">
                    <span class="form-hint">Server description shown in server list</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Max Players</label>
                    <input type="number" name="max-players" class="form-control" min="1" max="1000" value="20">
                    <span class="form-hint">Maximum number of players allowed</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3><i class="fas fa-gamepad"></i> Gameplay Settings</h3></div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Default Game Mode</label>
                    <select name="gamemode" class="form-control">
                        <option value="survival">Survival</option>
                        <option value="creative">Creative</option>
                        <option value="adventure">Adventure</option>
                        <option value="spectator">Spectator</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Difficulty</label>
                    <select name="difficulty" class="form-control">
                        <option value="peaceful">Peaceful</option>
                        <option value="easy">Easy</option>
                        <option value="normal">Normal</option>
                        <option value="hard">Hard</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Hardcore Mode</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="hardcore" style="accent-color:var(--accent);"> Enable hardcore mode</label>
                </div>
                <div class="form-group">
                    <label class="form-label">PvP</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="pvp" checked style="accent-color:var(--accent);"> Allow PvP combat</label>
                </div>
                <div class="form-group">
                    <label class="form-label">Allow Flight</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="allow-flight" style="accent-color:var(--accent);"> Allow flying in survival</label>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3><i class="fas fa-globe"></i> World Settings</h3></div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">World Name</label>
                    <input type="text" name="level-name" class="form-control" value="world">
                </div>
                <div class="form-group">
                    <label class="form-label">World Seed</label>
                    <input type="text" name="level-seed" class="form-control" placeholder="Leave empty for random seed">
                </div>
                <div class="form-group">
                    <label class="form-label">World Type</label>
                    <select name="level-type" class="form-control">
                        <option value="minecraft:normal">Normal</option>
                        <option value="minecraft:flat">Flat/Superflat</option>
                        <option value="minecraft:large_biomes">Large Biomes</option>
                        <option value="minecraft:amplified">Amplified</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Generate Structures</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="generate-structures" checked style="accent-color:var(--accent);"> Generate villages, dungeons, etc.</label>
                </div>
                <div class="form-group">
                    <label class="form-label">Spawn Animals</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="spawn-animals" checked style="accent-color:var(--accent);"> Allow animal spawning</label>
                </div>
                <div class="form-group">
                    <label class="form-label">Spawn Monsters</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="spawn-monsters" checked style="accent-color:var(--accent);"> Allow monster spawning</label>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3><i class="fas fa-tachometer-alt"></i> Performance Settings</h3></div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">View Distance</label>
                    <input type="number" name="view-distance" class="form-control" min="3" max="32" value="10">
                    <span class="form-hint">How far players can see (3-32 chunks)</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Simulation Distance</label>
                    <input type="number" name="simulation-distance" class="form-control" min="3" max="32" value="10">
                    <span class="form-hint">Distance for mob spawning and block updates</span>
                </div>
                <div class="form-group">
                    <label class="form-label">Max Tick Time</label>
                    <input type="number" name="max-tick-time" class="form-control" value="60000" min="1000">
                    <span class="form-hint">Maximum time per tick in milliseconds</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3><i class="fas fa-shield-alt"></i> Security Settings</h3></div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Online Mode</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="online-mode" checked style="accent-color:var(--accent);"> Verify with Mojang servers</label>
                </div>
                <div class="form-group">
                    <label class="form-label">Whitelist</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="white-list" style="accent-color:var(--accent);"> Only allow whitelisted players</label>
                </div>
                <div class="form-group">
                    <label class="form-label">Enforce Whitelist</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="enforce-whitelist" style="accent-color:var(--accent);"> Kick non-whitelisted players</label>
                </div>
                <div class="form-group">
                    <label class="form-label">Spawn Protection Radius</label>
                    <input type="number" name="spawn-protection" class="form-control" value="16" min="0">
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header"><h3><i class="fas fa-cog"></i> Advanced Settings</h3></div>
            <div class="card-body">
                <div class="form-group">
                    <label class="form-label">Enable Command Blocks</label>
                    <label class="d-flex gap-1 align-center" style="cursor:pointer;"><input type="checkbox" name="enable-command-block" style="accent-color:var(--accent);"> Allow command blocks to function</label>
                </div>
                <div class="form-group">
                    <label class="form-label">Function Permission Level</label>
                    <select name="function-permission-level" class="form-control">
                        <option value="1">1 - Moderator</option>
                        <option value="2">2 - Gamemaster</option>
                        <option value="3">3 - Admin</option>
                        <option value="4">4 - Owner</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Op Permission Level</label>
                    <select name="op-permission-level" class="form-control">
                        <option value="1">1 - Moderator</option>
                        <option value="2">2 - Gamemaster</option>
                        <option value="3">3 - Admin</option>
                        <option value="4">4 - Owner</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Resource Pack URL</label>
                    <input type="url" name="resource-pack" class="form-control" placeholder="https://example.com/resourcepack.zip">
                </div>
                <div class="form-group">
                    <label class="form-label">Resource Pack SHA1</label>
                    <input type="text" name="resource-pack-sha1" class="form-control" placeholder="Optional SHA1 hash">
                </div>
            </div>
        </div>

    </div>
</form>

<script>
let currentProperties = {};
const serverId = '<%= server.id %>';

function openTextEditor() { window.location.href = '/servers/<%= server.id %>/files/view?path=server.properties'; }

document.addEventListener('DOMContentLoaded', function() { loadProperties(); });

async function loadProperties() {
    try {
        const response = await fetch('/servers/<%= server.id %>/properties/get');
        const data = await response.json();
        if (data.success) { currentProperties = data.properties; populateForm(data.properties); }
        else showToast('Failed to load properties: ' + (data.error || 'Unknown'), 'error');
    } catch (err) { console.error(err); showToast('Failed to load properties', 'error'); }
}

function populateForm(properties) {
    const form = document.getElementById('propertiesForm');
    Object.entries(properties).forEach(([key, value]) => {
        const input = form.querySelector('[name="' + key + '"]');
        if (input) {
            if (input.type === 'checkbox') input.checked = value === 'true' || value === true;
            else input.value = value;
        }
    });
}

async function saveProperties() {
    const form = document.getElementById('propertiesForm');
    const formData = new FormData(form);
    const properties = {};
    for (let [key, value] of formData.entries()) properties[key] = value;
    form.querySelectorAll('input[type="checkbox"]').forEach(cb => { properties[cb.name] = cb.checked ? 'true' : 'false'; });
    const saveBtn = document.querySelector('.btn-primary');
    const originalText = saveBtn.innerHTML;
    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...'; saveBtn.disabled = true;
    try {
        const response = await fetch('/servers/<%= server.id %>/properties/save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ properties }) });
        const data = await response.json();
        if (data.success) { showToast('Properties saved! Restart to apply.', 'success'); if (data.warning) setTimeout(function(){ showToast(data.warning, 'warning'); }, 1000); }
        else showToast('Failed: ' + (data.error || 'Unknown'), 'error');
    } catch (err) { console.error(err); showToast('Network error', 'error'); }
    finally { saveBtn.innerHTML = originalText; saveBtn.disabled = false; }
}

async function resetToDefaults() {
    if (!confirm('Reset all properties to defaults? Cannot be undone.')) return;
    try {
        const response = await fetch('/servers/<%= server.id %>/properties/reset', { method: 'POST' });
        const data = await response.json();
        if (data.success) { showToast('Properties reset!', 'success'); loadProperties(); }
        else showToast('Failed: ' + (data.error || 'Unknown'), 'error');
    } catch (err) { console.error(err); showToast('Failed to reset', 'error'); }
}
</script>

<%- include('../partials/footer') %>
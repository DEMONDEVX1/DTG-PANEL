<%- include('../partials/header') %>

<div class="container py-4">
    <div class="srv-hero mb-4">
        <div class="srv-hero-left">
            <div class="srv-hero-title"><%= server.name %> <span class="srv-chip"><i class="fas fa-cloud-arrow-up"></i> Remote Backup</span></div>
            <div class="srv-hero-sub">Upload, import, and restore backups via direct links, MediaFire, Google Drive, or fast drag-and-drop</div>
        </div>
        <div class="srv-hero-right">
            <a href="/servers/<%= server.id %>/files" class="btn btn-ghost"><i class="fas fa-folder-open"></i> File Manager</a>
            <a href="/servers/<%= server.id %>/backups" class="btn btn-ghost"><i class="fas fa-database"></i> Panel Backups</a>
        </div>
    </div>

    <div class="grid gap-4" style="grid-template-columns: 1fr 1fr;">
        <!-- Card 1: Remote Link Downloader -->
        <div class="p-card">
            <div class="p-card-header">
                <h3><i class="fas fa-link text-accent"></i> Import Remote Link / MediaFire</h3>
            </div>
            <div class="p-card-body">
                <p class="text-xs text-muted mb-3">Paste any Direct HTTP/HTTPS URL, MediaFire link, Google Drive, Dropbox, or backup archive URL to download directly onto this VPS.</p>
                
                <div class="mb-3">
                    <label class="form-label text-xs fw-600">Remote Backup URL</label>
                    <input type="url" id="remoteUrlInput" class="form-control" placeholder="https://mediafire.com/file/... or https://domain.com/backup.zip" style="font-family:monospace;font-size:12px;">
                </div>

                <div class="grid gap-2 mb-3" style="grid-template-columns: 1fr 1fr;">
                    <div>
                        <label class="form-label text-xs fw-600">Destination Folder</label>
                        <select id="destinationSelect" class="form-control form-control-sm">
                            <option value="/">Server Root (/)</option>
                            <option value="/backups/">Backups Folder (/backups/)</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label text-xs fw-600">Custom Filename (Optional)</label>
                        <input type="text" id="customFilenameInput" class="form-control form-control-sm" placeholder="e.g. my-world-backup.zip" style="font-family:monospace;">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="d-flex align-center gap-2 text-xs" style="cursor:pointer;user-select:none;">
                        <input type="checkbox" id="autoExtractCheck" checked>
                        <span><i class="fas fa-file-archive text-warning"></i> Automatically extract archive (.zip) after download</span>
                    </label>
                </div>

                <button class="btn btn-primary w-100" id="btnStartRemoteDownload" onclick="startRemoteDownload()">
                    <i class="fas fa-cloud-arrow-down"></i> Download Remote Backup
                </button>

                <!-- Download Progress Box -->
                <div id="remoteDownloadProgressBox" class="mt-3 p-3 rounded" style="display:none;background:var(--bg-tertiary);border:1px solid var(--border);">
                    <div class="d-flex justify-between align-center mb-1">
                        <span class="fw-600 text-xs" id="dlStatusTitle"><i class="fas fa-spinner fa-spin text-warning"></i> Downloading...</span>
                        <span class="badge badge-accent text-xs" id="dlSpeedBadge">0 MB/s</span>
                    </div>
                    <div class="progress-wrap mb-2">
                        <div class="progress-bar accent" id="dlProgressBar" style="width:0%;"></div>
                    </div>
                    <div class="d-flex justify-between text-xs text-muted">
                        <span id="dlFilenameText" class="mono">file.zip</span>
                        <span id="dlBytesText">0 MB / 0 MB (0%)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Drag & Drop Backup Uploader (Fast Large File) -->
        <div class="p-card">
            <div class="p-card-header">
                <h3><i class="fas fa-upload text-success"></i> Drag &amp; Drop Backup Upload</h3>
            </div>
            <div class="p-card-body">
                <p class="text-xs text-muted mb-3">Upload large backup files directly from your computer with high-speed multi-part chunking.</p>

                <div id="backupDropZone" class="upload-drop-zone p-4 text-center rounded" style="border:2px dashed var(--border);background:var(--bg-tertiary);cursor:pointer;transition:all 0.2s;" onclick="document.getElementById('backupFileInput').click()">
                    <i class="fas fa-box-archive" style="font-size:36px;color:var(--accent);margin-bottom:10px;display:block;"></i>
                    <div class="fw-600 text-sm mb-1">Drag &amp; Drop Backup Archives Here</div>
                    <div class="text-xs text-muted">or click to browse (.zip, .tar.gz, .7z, .bak, .rar)</div>
                    <input type="file" id="backupFileInput" multiple accept=".zip,.gz,.tar,.7z,.bak,.rar" style="display:none;" onchange="handleBackupUploadFiles(this.files)">
                </div>

                <div class="mt-2 mb-3">
                    <label class="d-flex align-center gap-2 text-xs" style="cursor:pointer;user-select:none;">
                        <input type="checkbox" id="backupAutoExtractUpload" checked>
                        <span><i class="fas fa-file-archive text-warning"></i> Automatically extract after upload completes</span>
                    </label>
                </div>

                <div id="backupUploadQueue" style="max-height:220px;overflow-y:auto;"></div>
            </div>
        </div>
    </div>

    <!-- Card 3: Server Backup Files List -->
    <div class="p-card mt-4">
        <div class="p-card-header d-flex justify-between align-center">
            <h3><i class="fas fa-file-contract"></i> Server Backup Archives</h3>
            <button class="btn btn-xs btn-ghost" onclick="loadServerBackupsList()"><i class="fas fa-sync"></i> Refresh List</button>
        </div>
        <div class="p-card-body">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Archive Name</th>
                            <th>Location</th>
                            <th>Size</th>
                            <th>Date Modified</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="backupsTbody">
                        <tr>
                            <td colspan="5" class="text-center text-muted p-4"><i class="fas fa-spinner fa-spin"></i> Loading backups...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
const serverId = <%= server.id %>;
let currentDownloadJobId = null;
let downloadPollInterval = null;

// Start Remote URL Download
async function startRemoteDownload() {
    const urlInput = document.getElementById('remoteUrlInput');
    const destSelect = document.getElementById('destinationSelect');
    const customFilenameInput = document.getElementById('customFilenameInput');
    const autoExtractCheck = document.getElementById('autoExtractCheck');
    const btn = document.getElementById('btnStartRemoteDownload');

    const url = urlInput.value.trim();
    if (!url) {
        showToast('Please enter a valid remote backup URL', 'warning');
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Initiating Download...';

    try {
        const res = await fetch(`/api/servers/${serverId}/remote-backup/download-url`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                url: url,
                destination: destSelect.value,
                filename: customFilenameInput.value.trim(),
                autoExtract: autoExtractCheck.checked
            })
        });

        const data = await res.json();
        if (data.success && data.job) {
            showToast('Remote download started successfully!', 'info');
            currentDownloadJobId = data.job.id;
            showDownloadProgress(data.job);
            startPollingJobStatus(currentDownloadJobId);
            urlInput.value = '';
            customFilenameInput.value = '';
        } else {
            showToast('Error: ' + (data.error || 'Failed to start download'), 'danger');
        }
    } catch (e) {
        showToast('Network error while starting download', 'danger');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-cloud-arrow-down"></i> Download Remote Backup';
    }
}

function showDownloadProgress(job) {
    const box = document.getElementById('remoteDownloadProgressBox');
    const titleEl = document.getElementById('dlStatusTitle');
    const speedBadge = document.getElementById('dlSpeedBadge');
    const barEl = document.getElementById('dlProgressBar');
    const filenameText = document.getElementById('dlFilenameText');
    const bytesText = document.getElementById('dlBytesText');

    box.style.display = 'block';
    filenameText.textContent = job.filename;

    if (job.status === 'downloading') {
        titleEl.innerHTML = '<i class="fas fa-spinner fa-spin text-warning"></i> Downloading...';
        speedBadge.textContent = job.speed || '0 MB/s';
        barEl.style.width = (job.progress || 0) + '%';
        const dlMb = (job.downloadedBytes / (1024 * 1024)).toFixed(1);
        const totalMb = job.totalBytes > 0 ? (job.totalBytes / (1024 * 1024)).toFixed(1) : '?';
        bytesText.textContent = `${dlMb} MB / ${totalMb} MB (${job.progress}%)`;
    } else if (job.status === 'extracting') {
        titleEl.innerHTML = '<i class="fas fa-file-archive fa-bounce text-accent"></i> Extracting Backup...';
        barEl.style.width = '99%';
        speedBadge.textContent = 'Extracting';
        bytesText.textContent = 'Unpacking files into server directory...';
    } else if (job.status === 'completed') {
        titleEl.innerHTML = '<i class="fas fa-check-circle text-success"></i> Download Completed!';
        barEl.style.width = '100%';
        speedBadge.textContent = 'Done';
        bytesText.textContent = 'Backup downloaded successfully';
        loadServerBackupsList();
    } else if (job.status === 'error') {
        titleEl.innerHTML = '<i class="fas fa-circle-xmark text-danger"></i> Download Failed';
        barEl.style.width = '100%';
        barEl.className = 'progress-bar warning';
        speedBadge.textContent = 'Error';
        bytesText.textContent = job.error || 'Download failed';
    }
}

function startPollingJobStatus(jobId) {
    if (downloadPollInterval) clearInterval(downloadPollInterval);

    downloadPollInterval = setInterval(async () => {
        try {
            const res = await fetch(`/api/servers/${serverId}/remote-backup/job-status/${jobId}`);
            const data = await res.json();
            if (data.success && data.job) {
                showDownloadProgress(data.job);
                if (data.job.status === 'completed' || data.job.status === 'error') {
                    clearInterval(downloadPollInterval);
                }
            }
        } catch (e) {}
    }, 1000);
}

// -------------------------------------------------------------
// Drag & Drop Backup Fast Multi-Chunk Uploader
// -------------------------------------------------------------
const BACKUP_CHUNK_SIZE = 15 * 1024 * 1024; // 15MB chunks for ultra-fast throughput

function formatSize(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    var k = 1024, sizes = ['B', 'KB', 'MB', 'GB'];
    var i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

function handleBackupUploadFiles(files) {
    if (!files || files.length === 0) return;
    var autoExtract = document.getElementById('backupAutoExtractUpload').checked;
    
    for (var i = 0; i < files.length; i++) {
        uploadBackupFileFast(files[i], autoExtract);
    }
}

function uploadBackupFileFast(file, autoExtract) {
    var queue = document.getElementById('backupUploadQueue');
    var uploadId = 'bkp-' + Date.now() + '-' + Math.random().toString(36).substr(2, 8);
    var totalChunks = Math.ceil(file.size / BACKUP_CHUNK_SIZE);
    
    var item = document.createElement('div');
    item.className = 'p-2 mb-2 rounded';
    item.style.background = 'var(--bg-secondary)';
    item.style.border = '1px solid var(--border)';

    item.innerHTML = `
        <div class="d-flex justify-between align-center text-xs mb-1">
            <span class="fw-600 mono"><i class="fas fa-file-archive text-accent"></i> ${file.name}</span>
            <span class="text-muted">${formatSize(file.size)}</span>
        </div>
        <div class="progress-wrap mb-1">
            <div class="progress-bar accent" id="bar_${uploadId}" style="width:0%;"></div>
        </div>
        <div class="d-flex justify-between text-xs text-muted">
            <span id="st_${uploadId}">Starting upload...</span>
            <span id="pct_${uploadId}">0%</span>
        </div>
    `;
    queue.prepend(item);

    var barEl = document.getElementById(`bar_${uploadId}`);
    var stEl = document.getElementById(`st_${uploadId}`);
    var pctEl = document.getElementById(`pct_${uploadId}`);

    var uploadedCount = 0;
    var activeWorkers = 0;
    var nextChunkIndex = 0;
    var concurrency = 3; // Upload 3 chunks in parallel!

    function processQueue() {
        if (nextChunkIndex >= totalChunks && activeWorkers === 0) {
            // All chunks uploaded — merge
            stEl.textContent = 'Merging backup file...';
            pctEl.textContent = '99%';
            mergeBackupChunks(file, uploadId, totalChunks, autoExtract, item, stEl, barEl, pctEl);
            return;
        }

        while (activeWorkers < concurrency && nextChunkIndex < totalChunks) {
            var chunkIdx = nextChunkIndex++;
            activeWorkers++;
            uploadSingleBackupChunk(file, uploadId, chunkIdx, totalChunks, function(err) {
                activeWorkers--;
                if (err) {
                    stEl.textContent = 'Error uploading chunk ' + chunkIdx;
                    stEl.className = 'text-danger';
                } else {
                    uploadedCount++;
                    var pct = Math.round((uploadedCount / totalChunks) * 100);
                    barEl.style.width = pct + '%';
                    pctEl.textContent = pct + '%';
                    stEl.textContent = `Uploaded ${uploadedCount}/${totalChunks} chunks`;
                    processQueue();
                }
            });
        }
    }

    processQueue();
}

function uploadSingleBackupChunk(file, uploadId, chunkIndex, totalChunks, callback) {
    var start = chunkIndex * BACKUP_CHUNK_SIZE;
    var end = Math.min(file.size, start + BACKUP_CHUNK_SIZE);
    var chunk = file.slice(start, end);

    var formData = new FormData();
    formData.append('chunk', chunk, file.name);
    formData.append('uploadId', uploadId);
    formData.append('chunkIndex', chunkIndex);
    formData.append('totalChunks', totalChunks);
    formData.append('filename', file.name);
    formData.append('filePath', '/backups/');

    var xhr = new XMLHttpRequest();
    xhr.open('POST', `/servers/${serverId}/files/upload-chunk`);

    xhr.onload = function() {
        if (xhr.status >= 200 && xhr.status < 300) {
            callback(null);
        } else {
            callback(new Error('Chunk HTTP error ' + xhr.status));
        }
    };
    xhr.onerror = function() { callback(new Error('Network error')); };
    xhr.send(formData);
}

function mergeBackupChunks(file, uploadId, totalChunks, autoExtract, item, stEl, barEl, pctEl) {
    fetch(`/servers/${serverId}/files/merge-chunks`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            uploadId: uploadId,
            filename: file.name,
            filePath: '/backups/',
            totalChunks: totalChunks,
            totalSize: file.size
        })
    }).then(r => r.json()).then(data => {
        if (data.success) {
            barEl.style.width = '100%';
            pctEl.textContent = '100%';
            stEl.textContent = '✓ Upload complete!';

            if (autoExtract && file.name.endsWith('.zip')) {
                stEl.textContent = 'Extracting backup...';
                fetch(`/servers/${serverId}/files/unzip`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ filePath: '/backups/' + file.name })
                }).then(r => r.json()).then(extData => {
                    stEl.textContent = '✓ Uploaded & Extracted!';
                    loadServerBackupsList();
                }).catch(() => {
                    stEl.textContent = '✓ Uploaded (extraction error)';
                    loadServerBackupsList();
                });
            } else {
                loadServerBackupsList();
            }
        } else {
            stEl.textContent = 'Merge error: ' + (data.error || 'Failed');
            stEl.className = 'text-danger';
        }
    }).catch(e => {
        stEl.textContent = 'Network error while merging';
        stEl.className = 'text-danger';
    });
}

// -------------------------------------------------------------
// Load Server Backups List
// -------------------------------------------------------------
async function loadServerBackupsList() {
    const tbody = document.getElementById('backupsTbody');
    try {
        const res = await fetch(`/api/servers/${serverId}/remote-backup/list`);
        const data = await res.json();

        if (data.success && data.backups) {
            if (data.backups.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center text-muted p-4">No backup archives found in server directory. Use link import or drag & drop above to upload backups.</td></tr>';
                return;
            }

            let html = '';
            data.backups.forEach(b => {
                html += `
                    <tr>
                        <td class="fw-600 mono"><i class="fas fa-file-archive text-accent"></i> ${b.name}</td>
                        <td class="mono text-xs text-muted">${b.path}</td>
                        <td class="mono text-xs">${b.sizeFormatted}</td>
                        <td class="text-xs text-muted">${b.mtimeFormatted}</td>
                        <td class="text-right">
                            <button class="btn btn-xs btn-ghost text-accent" onclick="extractBackupArchive('${b.path}')"><i class="fas fa-box-open"></i> Extract</button>
                            <a href="/servers/${serverId}/files/download?path=${encodeURIComponent(b.path)}" class="btn btn-xs btn-ghost"><i class="fas fa-download"></i> Download</a>
                            <button class="btn btn-xs btn-ghost text-danger" onclick="deleteBackupArchive('${b.path}')"><i class="fas fa-trash"></i> Delete</button>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }
    } catch (e) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger p-4">Failed to load server backups</td></tr>';
    }
}

async function extractBackupArchive(path) {
    if (!confirm(`Extract backup "${path}" into server root directory?`)) return;
    showToast('Extracting backup archive...', 'info');

    try {
        const res = await fetch(`/servers/${serverId}/files/unzip`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ filePath: path })
        });
        const data = await res.json();
        if (data.success) {
            showToast('Backup archive extracted successfully!', 'success');
        } else {
            showToast('Error: ' + (data.error || 'Failed to extract archive'), 'danger');
        }
    } catch (e) {
        showToast('Network error while extracting archive', 'danger');
    }
}

async function deleteBackupArchive(path) {
    if (!confirm(`Delete backup file "${path}"?`)) return;

    try {
        const res = await fetch(`/servers/${serverId}/files/delete`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: path })
        });
        const data = await res.json();
        if (data.success) {
            showToast('Backup file deleted', 'info');
            loadServerBackupsList();
        } else {
            showToast('Error: ' + (data.error || 'Failed to delete file'), 'danger');
        }
    } catch (e) {
        showToast('Network error', 'danger');
    }
}

// Drag & drop setup for Backup DropZone
const backupDropZone = document.getElementById('backupDropZone');
if (backupDropZone) {
    backupDropZone.addEventListener('dragover', function(e) { e.preventDefault(); e.stopPropagation(); this.style.borderColor = 'var(--accent)'; this.style.background = 'var(--accent-dim)'; });
    backupDropZone.addEventListener('dragleave', function(e) { e.preventDefault(); this.style.borderColor = 'var(--border)'; this.style.background = 'var(--bg-tertiary)'; });
    backupDropZone.addEventListener('drop', function(e) { e.preventDefault(); e.stopPropagation(); this.style.borderColor = 'var(--border)'; this.style.background = 'var(--bg-tertiary)'; if (e.dataTransfer.files.length > 0) handleBackupUploadFiles(e.dataTransfer.files); });
}

loadServerBackupsList();
</script>

<%- include('../partials/footer') %>

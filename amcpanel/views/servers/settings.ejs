<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">Server Settings</h1>
        <p class="page-subtitle"><%= server.name %></p>
    </div>
    <a href="/servers/<%= server.id %>/dashboard" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Back to Server</a>
</div>

<div class="card">
    <div class="card-header"><h3>General Settings</h3></div>
    <div class="card-body">
        <div class="alert alert-info mb-3"><i class="fas fa-info-circle"></i> <strong>Smart Management:</strong> RAM allocation and server port are automatically managed by the system for optimal performance and security. You can configure these settings through the Properties editor.</div>
        <form onsubmit="saveSettings(event)">
            <div class="form-group">
                <label class="form-label">Server Name</label>
                <input type="text" name="name" class="form-control" value="<%= server.name %>" required>
            </div>
            <div class="form-group">
                <label class="form-label">Description</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Optional server description"><%= server.description || '' %></textarea>
            </div>
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Settings</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3>Server Information</h3></div>
    <div class="card-body">
        <div class="list-group">
            <div class="list-group-item d-flex justify-between"><span class="text-muted">Server ID</span><span class="fw-600">#<%= server.id %></span></div>
            <div class="list-group-item d-flex justify-between"><span class="text-muted">Server Type</span><span class="fw-600"><%= server.server_type || 'vanilla' %></span></div>
            <div class="list-group-item d-flex justify-between"><span class="text-muted">Version</span><span class="fw-600"><%= server.version || 'Latest' %></span></div>
            <div class="list-group-item d-flex justify-between"><span class="text-muted">RAM Allocation</span><span class="fw-600"><%= server.ram %> MB <span class="badge badge-info" style="font-size:10px;margin-left:8px;">AUTO-MANAGED</span></span></div>
            <div class="list-group-item d-flex justify-between"><span class="text-muted">Server Port</span><span class="fw-600"><%= server.port %> <span class="badge badge-info" style="font-size:10px;margin-left:8px;">PROTECTED</span></span></div>
            <div class="list-group-item d-flex justify-between"><span class="text-muted">Status</span><span class="badge <%= server.status === 'running' ? 'badge-success' : 'badge-danger' %>"><%= server.status %></span></div>
            <div class="list-group-item d-flex justify-between"><span class="text-muted">Created</span><span class="fw-600"><%= new Date(server.created_at).toLocaleDateString() %></span></div>
            <div class="list-group-item d-flex justify-between"><span class="text-muted">Disk Usage</span><span class="fw-600"><%= typeof diskUsage !== 'undefined' ? diskUsage : 'Calculating...' %></span></div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3><i class="fas fa-download"></i> Server Software & Version Management</h3></div>
    <div class="card-body">
        <form id="softwareChangeForm" onsubmit="changeSoftware(event)">
            <div class="grid-2">
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-server"></i> Server Software</label>
                    <select name="serverType" id="serverTypeSelect" class="form-control" onchange="loadVersions()" required>
                        <% Object.entries(serverSoftware).forEach(([category, softwares]) => { %>
                            <optgroup label="<%= category %>">
                                <% softwares.forEach(software => { %>
                                    <option value="<%= software.key %>" <%= server.server_type === software.key ? 'selected' : '' %> data-color="<%= software.color %>" data-icon="<%= software.icon %>"><%= software.name %> - <%= software.description %></option>
                                <% }) %>
                            </optgroup>
                        <% }) %>
                    </select>
                    <span class="form-hint">Current: <strong><%= server.server_type || 'vanilla' %></strong></span>
                </div>
                <div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-tag"></i> Minecraft Version</label>
                        <div class="d-flex gap-1 mb-1" style="padding:4px;background:var(--bg-tertiary);border-radius:var(--r-md);border:1px solid var(--border);">
                            <button type="button" class="btn btn-sm btn-primary active flex-1" onclick="toggleVersionMode('preset')" id="presetModeBtn"><i class="fas fa-list"></i> Preset Versions</button>
                            <button type="button" class="btn btn-sm btn-ghost flex-1" onclick="toggleVersionMode('custom')" id="customModeBtn"><i class="fas fa-edit"></i> Custom Version</button>
                        </div>
                        <div id="presetVersionContainer">
                            <select name="version" id="versionSelect" class="form-control" required>
                                <option value="<%= server.version %>"><%= server.version %> (Current)</option>
                                <% if (typeof versions !== 'undefined' && versions && versions.length > 0) { %>
                                    <% versions.forEach(v => { %>
                                        <% if (v !== server.version) { %><option value="<%= v %>"><%= v %></option><% } %>
                                    <% }) %>
                                <% } %>
                            </select>
                            <span class="form-hint"><i class="fas fa-info-circle"></i> Showing <span id="versionCount"><%= versions ? versions.length : 0 %></span> available versions</span>
                        </div>
                        <div id="customVersionContainer" style="display:none;">
                            <div class="input-group">
                                <input type="text" id="customVersionInput" class="form-control" placeholder="Enter version (e.g., 1.20.1, 20w14a, latest)" pattern="^(\d+\.\d+(\.\d+)?(-\w+)?|\d+w\d+[a-z]|latest|snapshot)$">
                                <button type="button" class="btn btn-ghost" onclick="validateCustomVersion()"><i class="fas fa-check"></i> Validate</button>
                            </div>
                            <div id="customVersionFeedback" class="mt-1"></div>
                            <span class="form-hint"><i class="fas fa-lightbulb"></i> <strong>Supported formats:</strong> 1.20.1, 1.19.4-pre1, 20w14a, latest, snapshot</span>
                        </div>
                        <span class="form-hint">Current: <strong><%= server.version %></strong></span>
                    </div>
                </div>
            </div>

            <div class="card" style="background:var(--bg-tertiary);border-color:var(--border);">
                <div class="card-body d-flex gap-3 align-center">
                    <div style="width:48px;height:48px;border-radius:var(--r-md);background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                        <i id="softwareIcon" class="fas fa-cube" style="color:var(--accent);font-size:20px;"></i>
                    </div>
                    <div class="flex-1">
                        <h4 id="softwareName" class="fw-600 mb-1">Vanilla</h4>
                        <p id="softwareDescription" class="text-muted text-sm">Official Minecraft server software from Mojang</p>
                        <div id="softwareFeatures" class="d-flex gap-1 flex-wrap mt-1">
                            <span class="badge badge-info">plugins: false</span>
                            <span class="badge badge-info">mods: false</span>
                            <span class="badge badge-info">datapacks: true</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-warning mb-3"><i class="fas fa-exclamation-triangle"></i> <span><strong>Important:</strong> Changing server software or version will require a server restart and may need additional setup. Always backup your server before making changes!</span></div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="fas fa-sync-alt"></i> Update Server Software</button>
                <button type="button" class="btn btn-ghost" onclick="showSoftwareGuide()"><i class="fas fa-question-circle"></i> Software Guide</button>
            </div>
        </form>
    </div>
</div>

<div class="card" style="border-color:var(--danger);">
    <div class="card-header" style="background:var(--danger-dim);border-color:var(--danger);"><h3 style="color:var(--danger);"><i class="fas fa-exclamation-triangle"></i> Danger Zone</h3></div>
    <div class="card-body">
        <div class="mb-3">
            <h4 class="fw-600 mb-1">Reinstall Server</h4>
            <p class="text-muted text-sm mb-2">Reinstall the server software. This will delete all server files except worlds and configs.</p>
            <button class="btn btn-warning" onclick="reinstallServer()"><i class="fas fa-redo"></i> Reinstall Server</button>
        </div>
        <div>
            <h4 class="fw-600 mb-1" style="color:var(--danger);">Delete Server</h4>
            <p class="text-muted text-sm mb-2">Permanently delete this server and all its files. This action cannot be undone!</p>
            <button class="btn btn-danger" onclick="deleteServer()"><i class="fas fa-trash"></i> Delete Server</button>
        </div>
    </div>
</div>

<script>
function saveSettings(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = Object.fromEntries(formData.entries());
    const btn = e.target.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...'; btn.disabled = true;
    fetch('/servers/<%= server.id %>/settings/update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
    .then(res => { if (res.ok) return res.json().catch(() => ({ success: true })); else return res.json().catch(() => ({ error: 'Server error' })); })
    .then(data => { if (data.success !== false) { showToast('Settings saved successfully!', 'success'); setTimeout(() => location.reload(), 1000); } else { showToast('Error: ' + (data.error || 'Failed to save settings'), 'error'); } })
    .catch(err => { console.error('Error:', err); showToast('An error occurred while saving settings', 'error'); })
    .finally(() => { btn.innerHTML = originalText; btn.disabled = false; });
}

function changeSoftware(e) {
    e.preventDefault();
    const serverType = e.target.serverType.value;
    let version;
    if (currentVersionMode === 'custom') { version = document.getElementById('customVersionInput').value.trim(); if (!customVersionValid) { showToast('Please validate your custom version first', 'error'); return; } }
    else version = e.target.version.value;
    if (!version) { showToast('Please select or enter a version', 'error'); return; }
    if (!confirm(`Change server software to ${serverType} ${version}? This will update the server configuration and may require additional setup. Make sure you have a backup!`)) return;
    const btn = e.target.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Updating Software...';
    fetch('/servers/<%= server.id %>/settings/update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: <%- JSON.stringify(server.name) %>, description: <%- JSON.stringify(server.description || "") %>, version: version, serverType: serverType }) })
    .then(res => { if (res.ok) return res.json().catch(() => ({ success: true })); else return res.json().catch(() => ({ error: 'Server error' })); })
    .then(data => { if (data.success !== false) { showToast('Server software updated successfully! Restart the server to apply changes.', 'success'); setTimeout(() => location.reload(), 1500); } else showToast('Error: ' + (data.error || 'Failed to update server software'), 'error'); })
    .catch(err => { console.error('Error:', err); showToast('An error occurred while updating server software', 'error'); })
    .finally(() => { btn.disabled = false; btn.innerHTML = originalText; });
}

async function loadVersions() {
    const serverType = document.getElementById('serverTypeSelect').value;
    const versionSelect = document.getElementById('versionSelect');
    versionSelect.innerHTML = '<option>Loading versions...</option>'; versionSelect.disabled = true;
    try {
        const response = await fetch(`/servers/<%= server.id %>/settings/versions/${serverType}`);
        const data = await response.json();
        if (data.success && data.versions) {
            versionSelect.innerHTML = '';
            data.versions.forEach(v => { const o = document.createElement('option'); o.value = v; o.textContent = v; versionSelect.appendChild(o); });
            if (data.versions.length > 0) versionSelect.value = data.versions[0];
        } else versionSelect.innerHTML = '<option>Error loading versions</option>';
    } catch (err) { console.error('Error loading versions:', err); versionSelect.innerHTML = '<option>Error loading versions</option>'; }
    finally { versionSelect.disabled = false; }
    updateSoftwareInfo(serverType);
}

function updateSoftwareInfo(serverType) {
    const softwareData = {
        vanilla: { name: 'Vanilla', description: 'Official Minecraft server software from Mojang', icon: 'fas fa-cube', color: '#8B4513', features: ['plugins: false', 'mods: false', 'datapacks: true'] },
        paper: { name: 'Paper', description: 'High-performance Spigot fork with optimizations', icon: 'fas fa-scroll', color: '#2196F3', features: ['plugins: true', 'mods: false', 'datapacks: true'] },
        purpur: { name: 'Purpur', description: 'Paper fork with additional configuration options', icon: 'fas fa-gem', color: '#9C27B0', features: ['plugins: true', 'mods: false', 'datapacks: true'] },
        spigot: { name: 'Spigot', description: 'Popular plugin platform with performance improvements', icon: 'fas fa-fire', color: '#FF9800', features: ['plugins: true', 'mods: false', 'datapacks: true'] },
        bukkit: { name: 'CraftBukkit', description: 'Original modded server with plugin API', icon: 'fas fa-hammer', color: '#795548', features: ['plugins: true', 'mods: false', 'datapacks: true'] },
        fabric: { name: 'Fabric', description: 'Lightweight modding platform', icon: 'fas fa-thread', color: '#4CAF50', features: ['plugins: false', 'mods: true', 'datapacks: true'] },
        forge: { name: 'Forge', description: 'Popular modding platform with extensive mod ecosystem', icon: 'fas fa-anvil', color: '#FF5722', features: ['plugins: false', 'mods: true', 'datapacks: true'] },
        quilt: { name: 'Quilt', description: 'Modern modding platform forked from Fabric', icon: 'fas fa-puzzle-piece', color: '#673AB7', features: ['plugins: false', 'mods: true', 'datapacks: true'] },
        velocity: { name: 'Velocity', description: 'Modern, high-performance Minecraft proxy', icon: 'fas fa-rocket', color: 'var(--accent)', features: ['plugins: true', 'networks: true', 'modern: true'] },
        bungeecord: { name: 'BungeeCord', description: 'Popular proxy for connecting multiple servers', icon: 'fas fa-network-wired', color: '#FF6B35', features: ['plugins: true', 'networks: true', 'legacy: true'] },
        waterfall: { name: 'Waterfall', description: 'Paper fork of BungeeCord with performance improvements', icon: 'fas fa-water', color: '#2196F3', features: ['plugins: true', 'networks: true', 'optimized: true'] },
        bedrock: { name: 'Bedrock Dedicated Server', description: 'Official Minecraft Bedrock Edition server', icon: 'fas fa-mobile-alt', color: '#4CAF50', features: ['crossplay: true', 'mobile: true', 'console: true'] },
        nukkit: { name: 'Nukkit', description: 'Third-party Bedrock server with plugin support', icon: 'fas fa-atom', color: '#9C27B0', features: ['plugins: true', 'crossplay: true', 'mobile: true'] },
        mohist: { name: 'Mohist', description: 'Forge + Bukkit hybrid', icon: 'fas fa-layer-group', color: '#607D8B', features: ['plugins: true', 'mods: true', 'hybrid: true'] },
        catserver: { name: 'CatServer', description: 'High-performance Forge + Bukkit', icon: 'fas fa-cat', color: '#FF9800', features: ['plugins: true', 'mods: true', 'performance: true'] }
    };
    const s = softwareData[serverType] || softwareData.vanilla;
    document.getElementById('softwareName').textContent = s.name;
    document.getElementById('softwareDescription').textContent = s.description;
    document.getElementById('softwareIcon').className = s.icon;
    document.getElementById('softwareIcon').style.color = s.color;
    const fc = document.getElementById('softwareFeatures'); fc.innerHTML = '';
    s.features.forEach(f => { const b = document.createElement('span'); b.className = 'badge badge-info'; b.textContent = f; fc.appendChild(b); });
}

function showSoftwareGuide() {
    const guide = `<div class="software-guide">
        <h3 class="fw-700 mb-3">Minecraft Server Software Guide</h3>
        <div class="mb-3"><h4 class="text-accent fw-600 mb-1">Java Edition Servers</h4>
            <ul class="text-muted text-sm" style="line-height:2;">
                <li><strong class="text-primary">Vanilla:</strong> Official Mojang server - stable, no plugins/mods</li>
                <li><strong class="text-primary">Paper:</strong> High-performance with plugins - recommended</li>
                <li><strong class="text-primary">Purpur:</strong> Paper + extra features</li>
                <li><strong class="text-primary">Spigot:</strong> Popular plugin platform</li>
                <li><strong class="text-primary">Fabric:</strong> Lightweight modding</li>
                <li><strong class="text-primary">Forge:</strong> Extensive mod ecosystem</li>
            </ul>
        </div>
        <div class="mb-3"><h4 class="text-accent fw-600 mb-1">Proxy Servers</h4>
            <ul class="text-muted text-sm" style="line-height:2;">
                <li><strong class="text-primary">Velocity:</strong> Modern proxy - best performance</li>
                <li><strong class="text-primary">BungeeCord:</strong> Classic proxy</li>
                <li><strong class="text-primary">Waterfall:</strong> BungeeCord + optimizations</li>
            </ul>
        </div>
        <div class="mb-3"><h4 class="text-accent fw-600 mb-1">Bedrock Edition</h4>
            <ul class="text-muted text-sm" style="line-height:2;">
                <li><strong class="text-primary">Bedrock Server:</strong> Official cross-platform server</li>
                <li><strong class="text-primary">Nukkit:</strong> Third-party with plugin support</li>
            </ul>
        </div>
        <div><h4 class="text-accent fw-600 mb-1">Hybrid Servers</h4>
            <ul class="text-muted text-sm" style="line-height:2;">
                <li><strong class="text-primary">Mohist:</strong> Forge + Bukkit</li>
                <li><strong class="text-primary">CatServer:</strong> High-performance hybrid</li>
            </ul>
        </div>
    </div>`;
    showModal('Server Software Guide', guide);
}

function showModal(title, content) {
    const modal = document.createElement('div'); modal.className = 'modal-overlay'; modal.style.display = 'flex';
    modal.innerHTML = '<div class="modal-box" style="max-width:600px;"><div class="modal-header"><h3>' + title + '</h3><button class="modal-close" onclick="this.closest(\'.modal-overlay\').remove()"><i class="fas fa-times"></i></button></div><div class="modal-body">' + content + '</div></div>';
    document.body.appendChild(modal);
    modal.addEventListener('click', function(e) { if (e.target === this) this.remove(); });
}

document.addEventListener('DOMContentLoaded', function() { updateSoftwareInfo('<%= server.server_type || "vanilla" %>'); });

let currentVersionMode = 'preset';
let customVersionValid = false;

function toggleVersionMode(mode) {
    currentVersionMode = mode;
    document.getElementById('presetVersionContainer').style.display = mode === 'preset' ? 'block' : 'none';
    document.getElementById('customVersionContainer').style.display = mode === 'custom' ? 'block' : 'none';
    document.getElementById('presetModeBtn').className = 'btn btn-sm ' + (mode === 'preset' ? 'btn-primary' : 'btn-ghost') + ' flex-1';
    document.getElementById('customModeBtn').className = 'btn btn-sm ' + (mode === 'custom' ? 'btn-primary' : 'btn-ghost') + ' flex-1';
    document.getElementById('versionSelect').required = mode === 'preset';
    document.getElementById('customVersionInput').required = mode === 'custom';
}

async function validateCustomVersion() {
    const input = document.getElementById('customVersionInput');
    const feedback = document.getElementById('customVersionFeedback');
    const serverType = document.getElementById('serverTypeSelect').value;
    const version = input.value.trim();
    if (!version) { showVersionFeedback('error', 'Please enter a version'); return; }
    showVersionFeedback('info', '<i class="fas fa-spinner fa-spin"></i> Validating version...');
    try {
        const response = await fetch('/servers/<%= server.id %>/settings/validate-version', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ version, serverType }) });
        const data = await response.json();
        if (data.success) {
            if (data.valid) { customVersionValid = true; showVersionFeedback('success', data.message); input.style.borderColor = 'var(--success)'; }
            else { customVersionValid = false; showVersionFeedback('error', data.message); input.style.borderColor = 'var(--danger)'; }
        } else { customVersionValid = false; showVersionFeedback('error', 'Validation failed'); input.style.borderColor = 'var(--danger)'; }
    } catch (err) { console.error('Validation error:', err); customVersionValid = false; showVersionFeedback('error', 'Network error during validation'); input.style.borderColor = 'var(--danger)'; }
}

function showVersionFeedback(type, message) {
    const feedback = document.getElementById('customVersionFeedback');
    const cls = type === 'success' ? 'alert-success' : type === 'error' ? 'alert-error' : 'alert-info';
    feedback.innerHTML = '<div class="alert ' + cls + '" style="padding:8px 12px;margin:0;font-size:13px;">' + message + '</div>';
}

document.addEventListener('DOMContentLoaded', function() {
    const customInput = document.getElementById('customVersionInput');
    if (customInput) {
        customInput.addEventListener('input', function() { const feedback = document.getElementById('customVersionFeedback'); this.style.borderColor = ''; if (feedback) feedback.innerHTML = ''; customVersionValid = false; });
        customInput.addEventListener('keypress', function(e) { if (e.key === 'Enter') { e.preventDefault(); validateCustomVersion(); } });
    }
});

function reinstallServer() {
    showConfirm('Reinstall server? This will delete all server files except worlds and configs!').then(function(ok) {
        if (!ok) return;
        showToast('Starting server reinstallation...', 'info');
        fetch('/servers/<%= server.id %>/settings/reinstall', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(res => { if (res.ok) return res.json().catch(() => ({ success: true })); else return res.json().catch(() => ({ error: 'Server error' })); })
        .then(data => { if (data.success !== false) { showToast('Server reinstalled successfully!', 'success'); setTimeout(() => location.reload(), 1500); } else showToast('Error: ' + (data.error || 'Failed to reinstall server'), 'error'); })
        .catch(err => { console.error('Error:', err); showToast('An error occurred during reinstallation', 'error'); });
    });
}

function deleteServer() {
    showConfirm('DELETE THIS SERVER? All files will be permanently deleted!').then(function(ok) {
        if (!ok) return;
        const confirmText = prompt('Type "<%= server.name %>" to confirm deletion:');
        if (confirmText !== '<%= server.name %>') { showToast('Server name does not match. Deletion cancelled.', 'warning'); return; }
        showToast('Deleting server...', 'info');
        fetch('/servers/<%= server.id %>/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(res => res.json())
        .then(data => { if (data.success) { showToast('Server deleted successfully!', 'success'); setTimeout(() => window.location.href = '/dashboard', 1500); } else showToast('Error: ' + (data.error || 'Failed to delete server'), 'error'); })
        .catch(err => { console.error('Error:', err); showToast('An error occurred during deletion', 'error'); });
    });
}
</script>

<%- include('../partials/footer') %>

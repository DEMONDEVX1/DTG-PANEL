<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title">Startup Configuration</h1>
        <p class="page-subtitle"><%= server.name %></p>
    </div>
    <a href="/servers/<%= server.id %>/dashboard" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Back to Server</a>
</div>

<div class="card" style="background:var(--accent-dim);border-color:var(--accent);">
    <div class="card-header" style="border-color:var(--accent);"><h3><i class="fas fa-terminal"></i> Startup Command Preview</h3></div>
    <div class="card-body">
        <div class="card" style="background:var(--bg-primary);padding:12px;">
            <code style="color:var(--accent);font-size:14px;word-break:break-all;line-height:1.6;">java <%= startup && startup.javaArgs ? startup.javaArgs : '-Xmx' + server.ram + 'M -Xms' + server.ram + 'M' %> -jar <%= startup && startup.jarFile ? startup.jarFile : 'server.jar' %> <%= startup && startup.additionalArgs ? startup.additionalArgs : 'nogui' %></code>
        </div>
        <span class="form-hint"><i class="fas fa-info-circle"></i> This is the command that will be executed when starting your server</span>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3><i class="fas fa-cog"></i> Startup Parameters</h3><span class="badge badge-info">Auto-Managed</span></div>
    <div class="card-body">
        <div class="alert alert-info mb-3"><i class="fas fa-lock"></i> <span><strong>Protected Configuration:</strong> Startup parameters are managed automatically based on your server type and allocated resources. Contact an administrator if changes are needed.</span></div>
        <div class="grid-3">
            <div class="card" style="background:var(--bg-tertiary);">
                <div class="card-body d-flex gap-3">
                    <div style="width:44px;height:44px;border-radius:var(--r-md);background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-memory" style="color:var(--accent);"></i></div>
                    <div class="flex-1">
                        <div class="text-xs fw-600 text-muted uppercase mb-1">Java Arguments</div>
                        <div class="fw-600 text-sm"><%= startup && startup.javaArgs ? startup.javaArgs : '-Xmx' + server.ram + 'M -Xms' + server.ram + 'M' %></div>
                        <div class="text-xs text-muted mt-1">JVM memory allocation and performance flags</div>
                    </div>
                </div>
            </div>
            <div class="card" style="background:var(--bg-tertiary);">
                <div class="card-body d-flex gap-3">
                    <div style="width:44px;height:44px;border-radius:var(--r-md);background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-file-archive" style="color:var(--accent);"></i></div>
                    <div class="flex-1">
                        <div class="text-xs fw-600 text-muted uppercase mb-1">Server JAR File</div>
                        <div class="fw-600 text-sm"><%= startup && startup.jarFile ? startup.jarFile : 'server.jar' %></div>
                        <div class="text-xs text-muted mt-1">Main server executable file</div>
                    </div>
                </div>
            </div>
            <div class="card" style="background:var(--bg-tertiary);">
                <div class="card-body d-flex gap-3">
                    <div style="width:44px;height:44px;border-radius:var(--r-md);background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-terminal" style="color:var(--accent);"></i></div>
                    <div class="flex-1">
                        <div class="text-xs fw-600 text-muted uppercase mb-1">Additional Arguments</div>
                        <div class="fw-600 text-sm"><%= startup && startup.additionalArgs ? startup.additionalArgs : 'nogui' %></div>
                        <div class="text-xs text-muted mt-1">Extra server launch arguments</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3><i class="fas fa-sliders-h"></i> Server Properties</h3><span class="badge badge-success">Editable</span></div>
    <div class="card-body">
        <form id="propertiesForm" onsubmit="saveProperties(event)">
            <div class="grid-2">
                <div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-users"></i> Max Players</label>
                        <input type="number" name="max-players" class="form-control" value="<%= properties && properties['max-players'] ? properties['max-players'] : 20 %>" min="1" max="1000">
                        <span class="form-hint">Maximum number of players allowed</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-gamepad"></i> Gamemode</label>
                        <select name="gamemode" class="form-control">
                            <option value="survival" <%= properties && properties.gamemode === 'survival' ? 'selected' : '' %>>Survival</option>
                            <option value="creative" <%= properties && properties.gamemode === 'creative' ? 'selected' : '' %>>Creative</option>
                            <option value="adventure" <%= properties && properties.gamemode === 'adventure' ? 'selected' : '' %>>Adventure</option>
                            <option value="spectator" <%= properties && properties.gamemode === 'spectator' ? 'selected' : '' %>>Spectator</option>
                        </select>
                        <span class="form-hint">Default gamemode for new players</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-skull-crossbones"></i> Difficulty</label>
                        <select name="difficulty" class="form-control">
                            <option value="peaceful" <%= properties && properties.difficulty === 'peaceful' ? 'selected' : '' %>>Peaceful</option>
                            <option value="easy" <%= properties && properties.difficulty === 'easy' ? 'selected' : '' %>>Easy</option>
                            <option value="normal" <%= properties && properties.difficulty === 'normal' ? 'selected' : '' %>>Normal</option>
                            <option value="hard" <%= properties && properties.difficulty === 'hard' ? 'selected' : '' %>>Hard</option>
                        </select>
                        <span class="form-hint">Game difficulty level</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-eye"></i> View Distance</label>
                        <input type="number" name="view-distance" class="form-control" value="<%= properties && properties['view-distance'] ? properties['view-distance'] : 10 %>" min="3" max="32">
                        <span class="form-hint">Chunks visible to players (3-32)</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-comment"></i> MOTD</label>
                        <input type="text" name="motd" class="form-control" value="<%= properties && properties.motd ? properties.motd : 'A Minecraft Server' %>" placeholder="A Minecraft Server">
                        <span class="form-hint">Server description in server list</span>
                    </div>
                </div>
                <div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-globe"></i> Level Name</label>
                        <input type="text" name="level-name" class="form-control" value="<%= properties && properties['level-name'] ? properties['level-name'] : 'world' %>" placeholder="world">
                        <span class="form-hint">World/level folder name</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-mountain"></i> Level Type</label>
                        <select name="level-type" class="form-control">
                            <option value="default" <%= properties && properties['level-type'] === 'default' ? 'selected' : '' %>>Default</option>
                            <option value="flat" <%= properties && properties['level-type'] === 'flat' ? 'selected' : '' %>>Flat</option>
                            <option value="largeBiomes" <%= properties && properties['level-type'] === 'largeBiomes' ? 'selected' : '' %>>Large Biomes</option>
                            <option value="amplified" <%= properties && properties['level-type'] === 'amplified' ? 'selected' : '' %>>Amplified</option>
                        </select>
                        <span class="form-hint">World generation type</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-seedling"></i> Level Seed</label>
                        <input type="text" name="level-seed" class="form-control" value="<%= properties && properties['level-seed'] ? properties['level-seed'] : '' %>" placeholder="Leave empty for random">
                        <span class="form-hint">World generation seed (optional)</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-tachometer-alt"></i> Simulation Distance</label>
                        <input type="number" name="simulation-distance" class="form-control" value="<%= properties && properties['simulation-distance'] ? properties['simulation-distance'] : 10 %>" min="3" max="32">
                        <span class="form-hint">Distance for mob spawning and updates (3-32)</span>
                    </div>
                    <div class="form-group">
                        <label class="form-label"><i class="fas fa-user-shield"></i> Max World Size</label>
                        <input type="number" name="max-world-size" class="form-control" value="<%= properties && properties['max-world-size'] ? properties['max-world-size'] : 29999984 %>" min="1" max="29999984">
                        <span class="form-hint">Maximum world border radius</span>
                    </div>
                </div>
            </div>

            <div class="card" style="background:var(--bg-tertiary);border-color:var(--border);">
                <div class="card-body">
                    <h4 class="fw-600 mb-3"><i class="fas fa-toggle-on" style="color:var(--accent);"></i> Server Features</h4>
                    <div class="grid-3 gap-2">
                        <% const toggles = [
                            { name: 'pvp', label: 'Enable PvP', icon: 'fa-swords', desc: 'Allow player vs player combat', checked: properties && properties.pvp !== 'false' },
                            { name: 'online-mode', label: 'Online Mode', icon: 'fa-shield-alt', desc: 'Require Mojang authentication', checked: properties && properties['online-mode'] !== 'false' },
                            { name: 'white-list', label: 'Whitelist', icon: 'fa-list', desc: 'Only allow whitelisted players', checked: properties && properties['white-list'] === 'true' },
                            { name: 'allow-flight', label: 'Allow Flight', icon: 'fa-plane', desc: 'Enable flying in survival', checked: properties && properties['allow-flight'] === 'true' },
                            { name: 'spawn-monsters', label: 'Spawn Monsters', icon: 'fa-ghost', desc: 'Enable hostile mob spawning', checked: properties && properties['spawn-monsters'] !== 'false' },
                            { name: 'spawn-animals', label: 'Spawn Animals', icon: 'fa-paw', desc: 'Enable passive mob spawning', checked: properties && properties['spawn-animals'] !== 'false' },
                            { name: 'spawn-npcs', label: 'Spawn NPCs', icon: 'fa-user-tie', desc: 'Enable villager spawning', checked: properties && properties['spawn-npcs'] !== 'false' },
                            { name: 'enable-command-block', label: 'Command Blocks', icon: 'fa-cube', desc: 'Enable command block usage', checked: properties && properties['enable-command-block'] === 'true' },
                            { name: 'generate-structures', label: 'Generate Structures', icon: 'fa-building', desc: 'Enable villages, temples, etc.', checked: properties && properties['generate-structures'] !== 'false' },
                            { name: 'hardcore', label: 'Hardcore Mode', icon: 'fa-skull', desc: 'Permanent death, locked to hard', checked: properties && properties.hardcore === 'true' },
                            { name: 'allow-nether', label: 'Allow Nether', icon: 'fa-fire', desc: 'Enable Nether dimension', checked: properties && properties['allow-nether'] !== 'false' },
                            { name: 'enable-status', label: 'Server Status', icon: 'fa-signal', desc: 'Show in server list', checked: properties && properties['enable-status'] !== 'false' }
                        ]; %>
                        <% toggles.forEach(t => { %>
                        <label class="d-flex gap-2" style="padding:12px;background:var(--bg-elevated);border:1px solid var(--border);border-radius:var(--r-md);cursor:pointer;transition:all 0.2s;">
                            <input type="checkbox" name="<%= t.name %>" <%= t.checked ? 'checked' : '' %> style="margin-top:3px;accent-color:var(--accent);">
                            <div>
                                <div class="fw-600 text-sm"><%= t.label %></div>
                                <div class="text-xs text-muted"><%= t.desc %></div>
                            </div>
                        </label>
                        <% }) %>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Server Properties</button>
                <button type="button" class="btn btn-ghost" onclick="resetForm()"><i class="fas fa-undo"></i> Reset Changes</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3><i class="fas fa-info-circle"></i> Important Information</h3></div>
    <div class="card-body">
        <div class="alert alert-warning mb-3"><i class="fas fa-exclamation-triangle"></i> <span><strong>Restart Required:</strong> Server must be restarted for property changes to take effect</span></div>
        <div class="grid-2">
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);border-left:3px solid var(--accent);">
                <i class="fas fa-rocket" style="color:var(--accent);"></i>
                <div><div class="fw-600 text-sm">Startup Parameters</div><div class="text-xs text-muted">Control how the server process is launched and memory allocation</div></div>
            </div>
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);border-left:3px solid var(--accent);">
                <i class="fas fa-sliders-h" style="color:var(--accent);"></i>
                <div><div class="fw-600 text-sm">Server Properties</div><div class="text-xs text-muted">Affect gameplay mechanics, world generation, and server behavior</div></div>
            </div>
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);border-left:3px solid var(--warning);">
                <i class="fas fa-shield-alt" style="color:var(--warning);"></i>
                <div><div class="fw-600 text-sm">Online Mode</div><div class="text-xs text-muted">Disabling requires caution - allows cracked clients but reduces security</div></div>
            </div>
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);border-left:3px solid var(--success);">
                <i class="fas fa-save" style="color:var(--success);"></i>
                <div><div class="fw-600 text-sm">Backup First</div><div class="text-xs text-muted">Always create a backup before making significant configuration changes</div></div>
            </div>
        </div>
    </div>
</div>

<script>
const serverId = '<%= server.id %>';
let originalFormData = null;
document.addEventListener('DOMContentLoaded', function() { const form = document.getElementById('propertiesForm'); if (form) originalFormData = new FormData(form); });

async function saveProperties(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const data = {};
    for (let [key, value] of formData.entries()) { const input = e.target.elements[key]; if (input && input.type === 'checkbox') data[key] = input.checked ? 'true' : 'false'; else data[key] = value; }
    const checkboxes = e.target.querySelectorAll('input[type="checkbox"]');
    checkboxes.forEach(cb => { if (!formData.has(cb.name)) data[cb.name] = 'false'; });
    const btn = e.target.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...'; btn.disabled = true;
    try {
        const response = await fetch(`/servers/${serverId}/startup/update`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        if (response.ok) {
            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('application/json')) { const result = await response.json(); if (result.success) { showToast('Server properties saved successfully! Restart the server for changes to take effect.', 'success'); originalFormData = new FormData(e.target); } else showToast('Error: ' + (result.error || 'Failed to save server properties'), 'error'); }
            else { showToast('Server properties saved successfully! Restart the server for changes to take effect.', 'success'); originalFormData = new FormData(e.target); setTimeout(() => window.location.reload(), 1500); }
        } else showToast('Failed to save server properties. Please try again.', 'error');
    } catch (err) { console.error('Save error:', err); showToast('Network error: Unable to save server properties.', 'error'); }
    finally { btn.innerHTML = originalText; btn.disabled = false; }
}

function resetForm() { if (confirm('Are you sure you want to reset all changes?')) { document.getElementById('propertiesForm').reset(); showToast('Form reset to original values', 'warning'); } }

window.addEventListener('beforeunload', function(e) {
    const form = document.getElementById('propertiesForm');
    if (!form || !originalFormData) return;
    const currentData = new FormData(form);
    let hasChanges = false;
    for (let [key, value] of currentData.entries()) { if (originalFormData.get(key) !== value) { hasChanges = true; break; } }
    if (hasChanges) { e.preventDefault(); e.returnValue = ''; }
});
</script>

<%- include('../partials/footer') %>

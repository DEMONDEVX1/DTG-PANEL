<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-user-friends"></i> Subuser Management</h1>
        <p class="page-subtitle"><%= server.name %></p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" onclick="showAddModal()"><i class="fas fa-plus"></i> Add Subuser</button>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3><i class="fas fa-users"></i> Current Subusers</h3><span class="badge badge-accent"><%= subusers ? subusers.length : 0 %> Users</span></div>
    <div class="card-body">
        <% if (subusers && subusers.length > 0) { %>
        <div class="grid-3 gap-2">
            <% subusers.forEach(subuser => { %>
            <div class="card" style="background:var(--bg-tertiary);">
                <div class="card-body d-flex gap-2 align-center">
                    <div style="width:48px;height:48px;border-radius:50%;background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-user" style="color:var(--accent);font-size:20px;"></i></div>
                    <div class="flex-1" style="min-width:0;">
                        <div class="fw-600 text-sm"><%= subuser.username %></div>
                        <div class="text-xs text-muted"><i class="fas fa-id-badge"></i> ID: <%= subuser.user_id %></div>
                    </div>
                    <button class="btn btn-sm btn-danger" onclick="removeSubuser(<%= subuser.id %>, <%- JSON.stringify(subuser.username) %>)"><i class="fas fa-trash"></i> Remove</button>
                </div>
            </div>
            <% }) %>
        </div>
        <% } else { %>
        <div class="text-center text-muted" style="padding:40px;">
            <i class="fas fa-user-friends" style="font-size:48px;display:block;margin-bottom:16px;opacity:0.3;"></i>
            <h3>No Subusers Yet</h3>
            <p>Add subusers to give other users access to manage this server</p>
            <button class="btn btn-primary mt-2" onclick="showAddModal()"><i class="fas fa-plus"></i> Add First Subuser</button>
        </div>
        <% } %>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3><i class="fas fa-info-circle"></i> About Subusers</h3></div>
    <div class="card-body">
        <div class="alert alert-info mb-3"><i class="fas fa-shield-alt"></i> <span><strong>What are subusers?</strong> Subusers can access and manage this server. They have the same permissions as the owner, except they cannot delete the server or manage other subusers.</span></div>
        <div class="grid-3 gap-2 mb-3">
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);">
                <div style="width:40px;height:40px;border-radius:var(--r-md);background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-terminal" style="color:var(--accent);"></i></div>
                <div><div class="fw-600 text-sm">Console Access</div><div class="text-xs text-muted">View console and send commands</div></div>
            </div>
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);">
                <div style="width:40px;height:40px;border-radius:var(--r-md);background:var(--success-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-folder-open" style="color:var(--success);"></i></div>
                <div><div class="fw-600 text-sm">File Management</div><div class="text-xs text-muted">Upload, edit, delete files</div></div>
            </div>
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);">
                <div style="width:40px;height:40px;border-radius:var(--r-md);background:var(--warning-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-power-off" style="color:var(--warning);"></i></div>
                <div><div class="fw-600 text-sm">Server Control</div><div class="text-xs text-muted">Start, stop, restart server</div></div>
            </div>
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);">
                <div style="width:40px;height:40px;border-radius:var(--r-md);background:var(--info-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-database" style="color:var(--info);"></i></div>
                <div><div class="fw-600 text-sm">Backup Access</div><div class="text-xs text-muted">Create and restore backups</div></div>
            </div>
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);">
                <div style="width:40px;height:40px;border-radius:var(--r-md);background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-users" style="color:var(--accent);"></i></div>
                <div><div class="fw-600 text-sm">Player Management</div><div class="text-xs text-muted">Whitelist, bans, ops</div></div>
            </div>
            <div class="d-flex gap-2" style="padding:12px;background:var(--bg-tertiary);border-radius:var(--r-md);">
                <div style="width:40px;height:40px;border-radius:var(--r-md);background:var(--danger-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0;"><i class="fas fa-cog" style="color:var(--danger);"></i></div>
                <div><div class="fw-600 text-sm">Server Settings</div><div class="text-xs text-muted">Modify configuration</div></div>
            </div>
        </div>
        <div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> <span><strong>Security Note:</strong> Only add users you trust. Subusers have significant control over your server.</span></div>
    </div>
</div>

<div id="addModal" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:500px;">
        <div class="modal-header"><h3><i class="fas fa-user-plus"></i> Add Subuser</h3><button class="modal-close" onclick="closeAddModal()"><i class="fas fa-times"></i></button></div>
        <div class="modal-body">
            <form id="addSubuserForm" onsubmit="addSubuser(event)">
                <div class="form-group">
                    <label class="form-label"><i class="fas fa-user"></i> Username</label>
                    <input type="text" name="username" id="usernameInput" class="form-control" placeholder="Enter username" required autocomplete="off">
                    <span class="form-hint">User must have an existing account on this panel</span>
                </div>
                <div class="alert alert-info"><i class="fas fa-lightbulb"></i> <span>The user will be notified and can immediately access this server from their dashboard.</span></div>
                <div class="form-actions">
                    <button type="button" class="btn btn-ghost" onclick="closeAddModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="addSubuserBtn"><i class="fas fa-plus"></i> Add Subuser</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const serverId = <%- JSON.stringify(server.id) %>;

function showAddModal() {
    const modal = document.getElementById('addModal'); 
    if (modal) { modal.style.display = 'flex'; document.body.style.overflow = 'hidden'; setTimeout(function(){ var i = document.getElementById('usernameInput'); if (i) i.focus(); }, 100); }
}
function closeAddModal() {
    const modal = document.getElementById('addModal');
    if (modal) { modal.style.display = 'none'; document.body.style.overflow = ''; var f = document.getElementById('addSubuserForm'); if (f) f.reset(); }
}

async function addSubuser(e) {
    e.preventDefault();
    const input = document.getElementById('usernameInput');
    const username = input ? input.value.trim() : '';
    if (!username) { showToast('Please enter a username', 'error'); return; }
    const btn = document.getElementById('addSubuserBtn');
    const originalText = btn.innerHTML; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Adding...'; btn.disabled = true;
    try {
        const response = await fetch('/servers/<%= server.id %>/subusers/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username }), redirect: 'manual' });
        if (response.type === 'opaqueredirect' || response.status === 0 || response.ok) { showToast('Subuser added!', 'success'); setTimeout(function(){ location.reload(); }, 1000); }
        else { const data = await response.json().catch(function(){ return {error: 'Unknown'}; }); showToast('Error: ' + (data.error || 'Failed'), 'error'); btn.innerHTML = originalText; btn.disabled = false; }
    } catch (err) { console.error(err); showToast('Network error', 'error'); btn.innerHTML = originalText; btn.disabled = false; }
}

async function removeSubuser(subuserId, username) {
    if (!confirm('Remove ' + username + ' as a subuser?')) return;
    showToast('Removing...', 'info');
    try {
        const response = await fetch('/servers/<%= server.id %>/subusers/remove', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ subuserId }), redirect: 'manual' });
        if (response.type === 'opaqueredirect' || response.status === 0 || response.ok) { showToast('Subuser removed!', 'success'); setTimeout(function(){ location.reload(); }, 1000); }
        else { const data = await response.json().catch(function(){ return {error: 'Unknown'}; }); showToast('Error: ' + (data.error || 'Failed'), 'error'); }
    } catch (err) { console.error(err); showToast('Network error', 'error'); }
}

document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeAddModal(); });
document.getElementById('addModal').addEventListener('click', function(e) { if (e.target === this) closeAddModal(); });
</script>

<%- include('../partials/footer') %>
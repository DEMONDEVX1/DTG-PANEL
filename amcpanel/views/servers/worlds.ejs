<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-globe"></i> World Management</h1>
        <p class="page-subtitle"><%= server.name %></p>
    </div>
    <div class="page-actions">
        <a href="/servers/<%= server.id %>/worlds/marketplace" class="btn btn-primary"><i class="fas fa-store"></i> World Marketplace</a>
        <button class="btn btn-ghost" onclick="showUploadModal()"><i class="fas fa-upload"></i> Upload World</button>
    </div>
</div>

<div class="card" style="background:var(--accent-dim);border-color:var(--accent);">
    <div class="card-header" style="border-color:var(--accent);"><h3><i class="fas fa-globe"></i> Current World</h3></div>
    <div class="card-body">
        <div class="d-flex align-center gap-3">
            <div style="width:48px;height:48px;border-radius:var(--r-md);background:var(--accent-dim);display:flex;align-items:center;justify-content:center;"><i class="fas fa-globe" style="color:var(--accent);font-size:20px;"></i></div>
            <div class="flex-1">
                <div class="fw-600" style="font-size:18px;"><%= currentWorld || 'world' %></div>
                <div class="text-xs text-muted">Active world directory</div>
            </div>
            <div class="d-flex gap-1">
                <button class="btn btn-sm btn-warning" onclick="backupWorld()"><i class="fas fa-save"></i> Backup</button>
                <button class="btn btn-sm btn-danger" onclick="resetWorld()"><i class="fas fa-redo"></i> Reset</button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header"><h3>Available Worlds (<%= worlds ? worlds.length : 0 %>)</h3></div>
    <div class="table-wrap">
        <table class="table">
            <thead><tr><th>World Name</th><th>Size</th><th>Type</th><th>Status</th><th>Actions</th></tr></thead>
            <tbody>
                <% if (worlds && worlds.length > 0) { %>
                    <% worlds.forEach(world => { %>
                    <tr>
                        <td>
                            <div class="d-flex gap-1 align-center">
                                <i class="fas fa-globe" style="color:var(--accent);"></i>
                                <strong><%= world.name %></strong>
                                <% if (world.name === currentWorld) { %><span class="badge badge-success">Active</span><% } %>
                            </div>
                        </td>
                        <td><%= world.size %></td>
                        <td>
                            <% if (world.name.includes('nether') || world.name.includes('DIM-1')) { %><span class="badge badge-danger">Nether</span>
                            <% } else if (world.name.includes('end') || world.name.includes('DIM1')) { %><span class="badge badge-accent">End</span>
                            <% } else { %><span class="badge badge-success">Overworld</span><% } %>
                        </td>
                        <td>
                            <% if (world.name === currentWorld) { %><span class="badge badge-success">In Use</span>
                            <% } else { %><span class="badge badge-accent">Available</span><% } %>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-ghost" onclick="downloadWorld('<%= world.name %>')" title="Download"><i class="fas fa-download"></i></button>
                                <button class="btn btn-sm btn-ghost" onclick="backupSpecificWorld('<%= world.name %>')" title="Backup"><i class="fas fa-save"></i></button>
                                <% if (world.name !== currentWorld) { %>
                                <button class="btn btn-sm btn-success" onclick="switchWorld('<%= world.name %>')" title="Switch"><i class="fas fa-exchange-alt"></i></button>
                                <button class="btn btn-sm btn-danger" onclick="deleteWorld('<%= world.name %>')" title="Delete"><i class="fas fa-trash"></i></button>
                                <% } else { %>
                                <span class="badge badge-info" style="padding:8px 12px;"><i class="fas fa-info-circle"></i> Active</span>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="5" class="text-center text-muted" style="padding:40px;">
                        <i class="fas fa-globe" style="font-size:48px;display:block;margin-bottom:16px;"></i>
                        No worlds found
                        <div class="mt-2"><button class="btn btn-primary" onclick="showUploadModal()"><i class="fas fa-upload"></i> Upload World</button></div>
                    </td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon accent"><i class="fas fa-globe"></i></div>
        <div class="stat-content"><div class="stat-label">Total Worlds</div><div class="stat-value"><%= worlds ? worlds.length : 0 %></div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon success"><i class="fas fa-check-circle"></i></div>
        <div class="stat-content"><div class="stat-label">Active World</div><div class="stat-value"><%= currentWorld || 'world' %></div></div>
    </div>
    <div class="stat-card">
        <div class="stat-icon info"><i class="fas fa-hdd"></i></div>
        <div class="stat-content">
            <div class="stat-label">Total Size</div>
            <div class="stat-value">
                <% let totalBytes = 0; if (worlds) { worlds.forEach(w => { if (w.sizeBytes) totalBytes += w.sizeBytes; }); } const totalGB = totalBytes / 1073741824; const totalMB = totalBytes / 1048576; %>
                <%= totalGB >= 1 ? totalGB.toFixed(2) + ' GB' : totalMB.toFixed(2) + ' MB' %>
            </div>
        </div>
    </div>
</div>

<div id="uploadModal" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:600px;">
        <div class="modal-header"><h3>Upload World</h3><button class="modal-close" onclick="closeUploadModal()"><i class="fas fa-times"></i></button></div>
        <div class="modal-body">
            <form id="uploadForm" onsubmit="uploadWorld(event)">
                <div class="form-group">
                    <label class="form-label">World Name</label>
                    <input type="text" name="worldName" class="form-control" placeholder="e.g., my-custom-world" required>
                    <span class="form-hint">Name for the world folder</span>
                </div>
                <div class="form-group">
                    <label class="form-label">World File (ZIP)</label>
                    <input type="file" name="worldFile" class="form-control" accept=".zip" required>
                    <span class="form-hint">Upload a ZIP file containing your world</span>
                </div>
                <div class="alert alert-info"><i class="fas fa-info-circle"></i> <span>The ZIP file should contain the world folder with level.dat and other world files.</span></div>
                <div id="uploadProgress" style="display:none;" class="mb-2">
                    <div class="progress-wrap"><div class="progress-bar accent" id="uploadProgressFill" style="width:0%"></div></div>
                    <div class="text-xs text-muted text-center mt-1" id="uploadProgressText">Uploading...</div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-ghost" onclick="closeUploadModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="uploadBtn"><i class="fas fa-upload"></i> Upload World</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const serverId = '<%= server.id %>';

function showUploadModal() { document.getElementById('uploadModal').style.display = 'flex'; }
function closeUploadModal() { document.getElementById('uploadModal').style.display = 'none'; document.getElementById('uploadForm').reset(); document.getElementById('uploadProgress').style.display = 'none'; }

function uploadWorld(e) {
    e.preventDefault();
    const formData = new FormData(e.target);
    const uploadBtn = document.getElementById('uploadBtn');
    const progressDiv = document.getElementById('uploadProgress');
    const progressFill = document.getElementById('uploadProgressFill');
    const progressText = document.getElementById('uploadProgressText');
    uploadBtn.disabled = true; progressDiv.style.display = 'block';
    const xhr = new XMLHttpRequest();
    xhr.upload.addEventListener('progress', function(e) { if (e.lengthComputable) { var p = (e.loaded / e.total) * 100; progressFill.style.width = p + '%'; progressText.textContent = 'Uploading... ' + Math.round(p) + '%'; } });
    xhr.addEventListener('load', function() { if (xhr.status === 200) { var data = JSON.parse(xhr.responseText); if (data.success) { progressText.textContent = 'Complete!'; setTimeout(function(){ closeUploadModal(); location.reload(); }, 1000); } else { showToast('Error: ' + (data.error || 'Upload failed'), 'error'); uploadBtn.disabled = false; progressDiv.style.display = 'none'; } } else { showToast('Upload failed', 'error'); uploadBtn.disabled = false; progressDiv.style.display = 'none'; } });
    xhr.addEventListener('error', function() { showToast('Upload failed', 'error'); uploadBtn.disabled = false; progressDiv.style.display = 'none'; });
    xhr.open('POST', '/servers/<%= server.id %>/worlds/upload'); xhr.send(formData);
}

function downloadWorld(worldName) { window.location.href = '/servers/<%= server.id %>/worlds/download/' + encodeURIComponent(worldName); }

function deleteWorld(worldName) {
    showConfirm('Delete world "' + worldName + '"? This cannot be undone!').then(function(ok) {
        if (!ok) return;
        var confirmText = prompt('Type "' + worldName + '" to confirm deletion:');
        if (confirmText !== worldName) { showToast('Deletion cancelled', 'warning'); return; }
        fetch('/servers/<%= server.id %>/worlds/delete', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ worldName: worldName }) })
        .then(res => res.json()).then(data => { if (data.success) { showToast('World deleted!', 'success'); setTimeout(function(){ location.reload(); }, 1000); } else showToast('Error: ' + (data.error || 'Failed'), 'error'); })
        .catch(err => { console.error(err); showToast('An error occurred', 'error'); });
    });
}

function switchWorld(worldName) {
    showConfirm('Switch to "' + worldName + '"? Server restart required.').then(function(ok) {
        if (!ok) return;
        fetch('/servers/<%= server.id %>/worlds/switch', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ worldName: worldName }) })
        .then(res => res.json()).then(data => { if (data.success) { showToast('World switched! Restart to load.', 'success'); setTimeout(function(){ location.reload(); }, 1000); } else showToast('Error: ' + (data.error || 'Failed'), 'error'); })
        .catch(err => { console.error(err); showToast('An error occurred', 'error'); });
    });
}

function resetWorld() {
    showConfirm('Reset current world? This will delete all data and create a new world!').then(function(ok) {
        if (!ok) return;
        fetch('/servers/<%= server.id %>/worlds/reset', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(res => res.json()).then(data => { if (data.success) { showToast('World reset! Restart to generate new world.', 'success'); setTimeout(function(){ location.reload(); }, 1000); } else showToast('Error: ' + (data.error || 'Failed'), 'error'); })
        .catch(err => { console.error(err); showToast('An error occurred', 'error'); });
    });
}

function backupWorld() {
    showConfirm('Backup current world?').then(function(ok) {
        if (!ok) return;
        fetch('/servers/<%= server.id %>/worlds/backup', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
        .then(res => res.json()).then(data => { if (data.success) showToast('World backup created!', 'success'); else showToast('Error: ' + (data.error || 'Failed'), 'error'); })
        .catch(err => { console.error(err); showToast('An error occurred', 'error'); });
    });
}

function backupSpecificWorld(worldName) {
    showConfirm('Backup "' + worldName + '"?').then(function(ok) {
        if (!ok) return;
        fetch('/servers/<%= server.id %>/worlds/backup', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ worldName: worldName }) })
        .then(res => res.json()).then(data => { if (data.success) showToast('Backup created!', 'success'); else showToast('Error: ' + (data.error || 'Failed'), 'error'); })
        .catch(err => { console.error(err); showToast('An error occurred', 'error'); });
    });
}

document.getElementById('uploadModal').addEventListener('click', function(e) { if (e.target === this) closeUploadModal(); });
</script>

<%- include('../partials/footer') %>
<%- include('../partials/header') %>

<div class="page-header">
    <div>
        <h1 class="page-title"><i class="fas fa-globe"></i> World Marketplace</h1>
        <p class="page-subtitle"><%= server.name %> - Powered by CurseForge</p>
    </div>
    <div class="page-actions">
        <a href="/servers/<%= server.id %>/worlds" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Back to Worlds</a>
    </div>
</div>

<div class="card" style="border-left:3px solid var(--accent);">
    <div class="card-body">
        <div class="d-flex gap-2" style="align-items:flex-start;">
            <i class="fas fa-info-circle" style="color:var(--accent);font-size:20px;margin-top:2px;"></i>
            <div>
                <div class="fw-600 mb-1">How World Downloads Work</div>
                <div class="text-sm text-secondary" style="line-height:1.6;">
                    <strong>Automatic Download:</strong> Click "Download" button. The system will attempt automatic download.<br>
                    <strong>CurseForge Policy:</strong> Most worlds require manual download due to CurseForge's policy.<br>
                    <strong>Manual Process:</strong> Click "View on CurseForge", download the .zip, then upload via <a href="/servers/<%= server.id %>/worlds" class="text-accent">World Management</a>.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form id="searchForm" class="d-flex gap-2">
            <input type="text" id="searchInput" class="form-control flex-1" placeholder="Search CurseForge worlds (e.g., Skyblock, Adventure, Parkour)...">
            <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Search</button>
        </form>
    </div>
</div>

<div id="loadingState" class="text-center" style="padding:60px;">
    <i class="fas fa-spinner fa-spin" style="font-size:48px;color:var(--accent);"></i>
    <p class="text-muted mt-2">Loading worlds from CurseForge...</p>
</div>

<div id="worldsContainer" style="display:none;">
    <div class="grid-3 gap-3 mb-3" id="worldsGrid"></div>
    <div class="d-flex justify-center gap-1" id="pagination"></div>
</div>

<div id="emptyState" class="text-center" style="padding:60px;display:none;">
    <i class="fas fa-globe" style="font-size:48px;color:var(--text-tertiary);"></i>
    <p class="text-secondary">No worlds found</p>
    <p class="text-xs text-muted">Try adjusting your search</p>
</div>

<div id="errorState" class="text-center" style="padding:60px;display:none;">
    <i class="fas fa-exclamation-triangle" style="font-size:48px;color:var(--danger);"></i>
    <p class="text-secondary" id="errorMessage"></p>
    <button class="btn btn-primary mt-2" onclick="loadWorlds()"><i class="fas fa-redo"></i> Retry</button>
</div>

<script>
const serverId = '<%= server.id %>';
let currentPage = 1, currentSearch = '', totalPages = 1;

function formatNumber(num) { if (num >= 1e6) return (num / 1e6).toFixed(1) + 'M'; if (num >= 1e3) return (num / 1e3).toFixed(1) + 'K'; return '' + num; }
function formatFileSize(bytes) { if (!bytes) return '0 B'; var k = 1024, sizes = ['B','KB','MB','GB'], i = Math.floor(Math.log(bytes) / Math.log(k)); return (bytes / Math.pow(k, i)).toFixed(2) + ' ' + sizes[i]; }

function loadWorlds(page) {
    if (page) currentPage = page;
    var grid = document.getElementById('worldsGrid'), loading = document.getElementById('loadingState'), empty = document.getElementById('emptyState'), error = document.getElementById('errorState'), container = document.getElementById('worldsContainer'), pagination = document.getElementById('pagination');
    loading.style.display = 'block'; container.style.display = 'none'; empty.style.display = 'none'; error.style.display = 'none'; pagination.style.display = 'none';
    fetch('/servers/<%= server.id %>/worlds/marketplace/api?page=' + currentPage + '&search=' + encodeURIComponent(currentSearch))
    .then(function(r) { return r.json(); })
    .then(function(data) {
        loading.style.display = 'none';
        if (!data.success) throw new Error(data.error || 'Failed to load');
        if (data.worlds.length === 0) { empty.style.display = 'block'; return; }
        container.style.display = 'block'; totalPages = Math.ceil(data.total / 20);
        grid.innerHTML = data.worlds.map(function(w) {
            var btnHtml = (w.downloadUrl || w.fileId) ? '<button class="btn btn-sm btn-primary" style="width:100%;" onclick="downloadWorld(\'' + w.id + '\',\'' + w.fileId + '\',\'' + w.name.replace(/'/g, "\\'") + '\',\'' + w.projectUrl.replace(/'/g, "\\'") + '\',this)"><i class="fas fa-download"></i> Download ' + (w.fileName || '') + '</button>' : '';
            var viewBtn = '<a href="' + w.projectUrl + '" target="_blank" class="btn btn-sm btn-ghost" style="width:100%;"><i class="fas fa-external-link-alt"></i> View on CurseForge</a>';
            return '<div class="card" style="overflow:hidden;"><div style="height:160px;background:var(--bg-tertiary);display:flex;align-items:center;justify-content:center;overflow:hidden;"><img src="' + w.image + '" alt="' + w.name + '" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display=\'none\'"></div><div class="card-body"><h4 class="fw-600 text-sm mb-1">' + w.name + '</h4><p class="text-xs text-muted mb-2" style="overflow:hidden;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;">' + w.description + '</p><div class="d-flex gap-2 flex-wrap text-xs text-muted mb-2"><span><i class="fas fa-user"></i> ' + w.author + '</span><span><i class="fas fa-download"></i> ' + formatNumber(w.downloads) + '</span>' + (w.fileSize > 0 ? '<span><i class="fas fa-hdd"></i> ' + formatFileSize(w.fileSize) + '</span>' : '') + '</div></div><div class="card-footer" style="padding:12px;">' + (btnHtml ? btnHtml : '') + viewBtn + '</div></div>';
        }).join('');
        if (totalPages > 1) { pagination.style.display = 'flex'; renderPagination(); }
    })
    .catch(function(err) { console.error(err); loading.style.display = 'none'; error.style.display = 'block'; document.getElementById('errorMessage').textContent = err.message; });
}

function renderPagination() {
    var pagination = document.getElementById('pagination'), html = '';
    if (currentPage > 1) html += '<button class="btn btn-sm btn-ghost" onclick="loadWorlds(' + (currentPage - 1) + ')"><i class="fas fa-chevron-left"></i> Previous</button>';
    var startPage = Math.max(1, currentPage - 2), endPage = Math.min(totalPages, currentPage + 2);
    for (var i = startPage; i <= endPage; i++) {
        if (i === currentPage) html += '<button class="btn btn-sm btn-primary">' + i + '</button>';
        else html += '<button class="btn btn-sm btn-ghost" onclick="loadWorlds(' + i + ')">' + i + '</button>';
    }
    if (currentPage < totalPages) html += '<button class="btn btn-sm btn-ghost" onclick="loadWorlds(' + (currentPage + 1) + ')">Next <i class="fas fa-chevron-right"></i></button>';
    pagination.innerHTML = html;
}

function downloadWorld(worldId, fileId, worldName, projectUrl, button) {
    var originalText = button.innerHTML; button.disabled = true; button.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Checking...';
    fetch('/servers/<%= server.id %>/worlds/download/' + worldId + '/' + fileId)
    .then(function(r) { return r.json().then(function(d) { if (!r.ok) { if (d.reason === 'curseforge_policy') throw new Error('CURSEFORGE_POLICY:' + (d.fileName || worldName)); throw new Error(d.error || d.message || 'HTTP ' + r.status); } return d; }); })
    .then(function(data) {
        if (data.success) {
            button.innerHTML = '<i class="fas fa-check"></i> Downloaded!'; button.className = 'btn btn-sm btn-success'; button.style.width = '100%';
            var msg = worldName + ' downloaded!\nLocation: ' + data.filePath + '\n' + (data.fileSize ? 'Size: ' + data.fileSize + '\n' : '') + '\nExtract via File Manager.';
            if (data.alreadyExists) msg = worldName + ' already exists at: ' + data.filePath;
            showToast(msg, 'success');
        } else throw new Error(data.error || 'Unknown error');
    })
    .catch(function(err) {
        console.error(err); button.innerHTML = originalText; button.disabled = false;
        var errorMsg = err.message || 'Unknown error';
        if (errorMsg.startsWith('CURSEFORGE_POLICY:')) {
            var fileName = errorMsg.split(':')[1] || worldName;
            showToast('CurseForge blocks auto-download for "' + worldName + '". Click "View on CurseForge" to download manually.', 'info');
            setTimeout(function() { if (confirm('Open "' + worldName + '" on CurseForge?')) window.open(projectUrl, '_blank'); }, 1500);
        } else {
            showToast('Download failed: ' + errorMsg + '. Try manual download via "View on CurseForge".', 'error');
        }
    });
}

document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('searchForm').addEventListener('submit', function(e) { e.preventDefault(); currentSearch = document.getElementById('searchInput').value; loadWorlds(1); });
    loadWorlds(1);
});
</script>

<%- include('../partials/footer') %>